# 第 11 章 • 第二座信标（第 11 天 / 共同线）
# 节点：1 坡上点名 · 2 铁塔下的响声 · 3 信标在等谁（menu）
#       · 3B 一份电（menu · 资源冲突容器）· 4 旧线与旧人
#       · 5 走之前留不留（menu）· 6 归整随身物（menu）
#       · 7 药纸与水壶 · 8 离开

label ch11:

    scene bg cliff with slow_fade
    $ vn2_enter_chapter("ch11")
    call vn2_title_card(11, "第二座信标", "第 11 天 • 共同线")
    $ vn2_amb("rain")

    $ vn2_show("lan", pos="left", trans=dissolve_soft)
    $ vn2_show("qing", pos="right", trans=dissolve_soft)

    # --- 节点 1/8 · 坡上点名 ---
    nar "雨幕里先看见铁塔的尖。再往上爬一段，四个人先后翻上信标所在的坡。"
    nar "你先回头点了一遍人。蓝羽在最前面，外套湿透，贴在肩上；白砚药箱扛在肩上，右手扶着箱扣；青岩抱着样本箱，箱面一点没湿。"
    think "昨晚那一下之后，你一直在数。数到第三遍，四个人都在。"
    nar "左臂还有点发僵，抬起来能握拳。你活动了两下，没让人看出来。"
    $ vn2_current_voice = "voice/lan/lan_0071.ogg"
    voice "voice/lan/lan_0071.ogg"
    lan "都上来了。"
    nar "他站在坡顶往下望，尾巴收在腿边。看见你跟上来，他往旁边让了半步，留出落脚的地方。"
    $ vn2_current_voice = "voice/bai/bai_0044.ogg"
    voice "voice/bai/bai_0044.ogg"
    bai "药箱没沾水。人也齐。"
    nar "白砚把箱子换了个肩，扫了一圈众人的鞋和腿，没谁打晃。"
    $ vn2_current_voice = "voice/qing/qing_0038.ogg"
    voice "voice/qing/qing_0038.ogg"
    qing "坡上风口大。先看信标，别久站。"
    nar "坡顶的风带着雨丝，打在脸上发疼。四个人靠到塔架背风的一面，肩挨肩站成一排。"
    nar "坡路一段比一段陡。脚下的土被雨泡松，每走十步就得扶一回岩壁。"
    nar "昨晚没睡踏实的人不止你一个。蓝羽的眼下发青，青岩拎箱的手比平时紧。"
    think "人还在，步子还能跟上，就算从那一夜熬过来了。"
    nar "白砚把药箱换到靠前的肩上，腾出右手活动了两下指节。他没说累，脚步却比平时慢半拍。"
    nar "坡脚下的林子刚从雨里退出来，树干上挂着水。风一过，叶子上的水珠成串往下掉。"
    nar "你伸手接过青岩怀里滑下来的样本箱，托了一把。箱子扣得紧，里面的样本没晃出声。"
    nar "风把坡上的雾推成一层一层，塔尖在最上面那层里时隐时现。"

    # --- 节点 2/8 · 铁塔下的响声 ---
    nar "信标还在响。滴、滴、滴，隔很久一下。"
    nar "声音从铁塔底下传上来，很闷，像隔着一层水。"
    nar "塔下一台手压发报机，摇柄上挂着水。"
    $ vn2_current_voice = "voice/qing/qing_0039.ogg"
    voice "voice/qing/qing_0039.ogg"
    qing "线路被人重新接过。接法很土，但能响。"
    think "有人比我们先到。而且想让它一直响。"
    nar "蓝羽对着方位比了比，又摸出怀里那张图。"
    if lan_map_fixed:
        $ vn2_current_voice = "voice/lan/lan_0072.ogg"
        voice "voice/lan/lan_0072.ogg"
        lan "改过的那条支线，指的就是这座塔。"
        nar "他把图角按在方位上，两笔对在一起，分毫不差。"
    else:
        $ vn2_current_voice = "voice/lan/lan_0073.ogg"
        voice "voice/lan/lan_0073.ogg"
        lan "图上少了一笔。信标的方向，原图上没有标。"
        nar "他盯着那片空白，眉头压得很低。"
    nar "塔脚堆着几根旧木杆，被雨泡得发黑。发报机外壳锈了一圈，摇柄却擦过，铜色还亮着。"
    nar "铁塔焊在一块平整的岩台上。塔身上半部让雷劈过，焦黑一道，顺着梁往下裂。"
    nar "发报机旁边搁着半截铅笔和一只空罐头，像是谁走得急，没来得及收。"
    nar "岩台上落着几片被风卷上来的枯叶，贴在石缝里，已经干透。"
    nar "发报机上没有标签，机壳的接缝里嵌着旧泥。电池仓开着，里头一节干电池，外皮已经起皱。"
    nar "塔下的积水没过石根。昨天的雨从上游下来，把岩台泡了一圈。"
    nar "发报机摇柄上的水往下滴，在石面上积出一小片深色。塔架的铁梁锈出一道道竖纹。"
    nar "岩台边上长着一丛矮灌，枝叶让雨打弯，梢头还在滴水。"
    nar "塔架脚下的泥被踩成一片硬壳，壳上裂着细缝。"

    # --- 节点 3/8 · 信标在等谁（menu） ---
    nar "谁先碰这台机器，等于先露给不知道的人看。"

    menu:
        "信标在等谁？"

        "回一个信号":
            $ vn2_aff_add("lan", 4)
            nar "你按了三下。上面静了一会儿，回了四下。"
            $ vn2_current_voice = "voice/lan/lan_0074.ogg"
            voice "voice/lan/lan_0074.ogg"
            lan "四个字。「还活着」。"
            nar "他念出声的时候，声音有点抖。"
            nar "雨点打在塔架上，一滴一滴，间隔和信标响声错开。他把手从摇柄上收回来，在裤腿上擦了擦水。"
            nar "四下回完，摇柄又自己沉下去，隔很久才响一声。他盯着塔尖看了一会儿，把图上的方位补了一笔。"

        "拆开外壳，看线路":
            $ vn2_aff_add("qing", 4)
            nar "青岩指着一段铜线，线头是新的，铜色还没发暗。"
            $ vn2_current_voice = "voice/qing/qing_0040.ogg"
            voice "voice/qing/qing_0040.ogg"
            qing "接过线的人懂一点，不多。"
            nar "他把外壳盖回去，把线头的位置记在本子上。"
            nar "接线口缠着一圈旧布，布上的纹路磨平了。他把布角掖好，没拆。"
            nar "他把铜线的走向在本子上画成小图，每一段拐角都标了记号，页码折了个角。"

        "不回信号，先把方位记下":
            $ vn2_aff_add("bai", 4)
            nar "你没碰摇柄。方位、风向、响声间隔，一项一项记下来。"
            $ vn2_current_voice = "voice/bai/bai_0045.ogg"
            voice "voice/bai/bai_0045.ogg"
            bai "别先露位置。对方是谁，还不知道。"
            nar "他站在高处望了一圈，把退路指给你看。"
            nar "退路是一道斜下去的草坡，坡底接着林子。他指完又补了一句，说真要撤，先走坡底那条线。"
            nar "你把风向标在图角，又记了响声间隔：七下一拍，中间不匀。"

    $ vn2_hide("qing", trans=dissolve_soft)

    # --- 节点 3B/9 · 一份电（menu · 资源冲突容器） ---
    $ vn2_show("bai", pos="center", trans=dissolve_soft)

    nar "信号对完，蓝羽松开摇柄。机器底下压着一节还能用的电池，外皮起皱，接点却没锈死。"
    nar "背包侧袋里那台电台，用的是同一批旧电池，口径对得上。信标要接着往上响，得靠这节电顶；电台要听见后面断续的编号，也靠这节电续。两处抢一份电。"
    nar "白砚把药箱从肩上卸下来，搁在岩台上。箱里那只旧手电也吃同一型号的电池，箱底还压着半节备用的，是留给夜里换药、看伤口照明用的。"
    nar "蓝羽蹲在发报机旁，青岩翻着接线。四个人围着这一节电，雨丝打在塔架上，谁都没先开口。"
    nar "矿灯只剩一格亮，灯罩上凝着水汽。电池皮被雨泡软，捏在手里发沉。岩台上的积水漫过石根，把两节电池的影子泡在一处。"
    nar "青岩把发报机后盖撬开一条缝，指节顺着铜线摸过去，接头松了两处，拧紧还能用。他没把后盖合上，等着电先有个去处。"
    nar "白砚翻开药箱，把瓶一只只点过去。瓶数没变，箱底那半节备用电池压在药布下面，位置没动。"
    think "一处要往外发信号，一处要往里听回话，中间就靠这一节电。给谁，另一处就得哑下去。"

    menu:
        "这节电，先顾哪一处？"

        "把电留给信标，让它接着响":
            $ vn2_aff_add("lan", 2)
            nar "你把电池装进信标机仓。滴、滴、滴，间隔稳下来，塔下的响声不再拖长。"
            nar "电台被拔了连接线，收进包侧袋，灯暗下去一格。蓝羽按了按袋面，没再提听编号的事。"
            nar "白砚的药箱没动。他把箱扣重新扣好，把那半节备用电池压回箱底，手在箱盖上停了一息。"
            nar "塔上的滴声稳住以后，蓝羽抬头看了一眼塔尖，又低头把包里电台的连接线盘好，塞进侧袋最里层。"
            nar "信标亮在坡上，对外的位置还在露；自己人往后听见什么，就由不得这台机器了。"

        "拆信标上的零件，保电台":
            nar "你拆下塔机上还能用的接线和接点，喂给背包里的电台。信标的滴声一下比一下慢，最后哑在岩台上，再没响第二回。"
            nar "拆到最后，绕不开白砚药箱里那半节备用电池：电台要撑过今晚，缺一节；箱里那节，是他夜里换药看伤口用的。"
            nar "你看向白砚。他没说给，也没说不给，手指在箱扣上按了一下，把箱盖合上半寸。"
            $ vn2_current_voice = "voice/bai/bai_0046.ogg"
            voice "voice/bai/bai_0046.ogg"
            bai "药是留给人的。电也是。"
            nar "拆下来的接点在石面上排成一小排，铜色发暗。青岩蹲下看了一眼，没把它们装回去。"
            nar "最后那节电池没动药箱的。电台只续上一口气，编号还能再听见一次，之后就只剩杂音。"
            nar "从这一拍起，白砚不再在你跟前提那串编号。蓝羽想听，也只看他的嘴，没追问。"
            nar "信标从此沉默。塔架空在坡上，岩台上多了一堆拆下来的旧接点，被雨泡着。白砚把药箱扣带重新勒紧，指节在箱扣上压了一下，没再提匀电池的事。"

        "两份都省着用，谁也不喂饱":
            $ vn2_aff_add("bai", 1)
            nar "电池掰不开，只能把电分成两份。信标留一口气，响声隔得更长；电台也留一口气，收下来的编号断断续续，接不上整句。"
            nar "白砚把药箱里那半节备用电池留在原处，没拆。他把两处接点都擦过一遍，能省的电省下来。"
            $ vn2_current_voice = "voice/bai/bai_0047.ogg"
            voice "voice/bai/bai_0047.ogg"
            bai "都留着。走到下一处，再想办法。"
            nar "青岩把两处接点都做了标记，哪一处先暗，他在本子上记了位置。"
            nar "两样都半残。信标没哑，也没真响；电台没断，也没听全。谁也没全保住。"
            nar "后半夜两处都可能先暗下去。路上得有人盯着，隔一会儿看一眼。"

    nar "电池归回原位，各人把东西收回背包。岩台上的积水、锈水、空罐头照旧，雨还在落。"
    nar "若是电留给信标：包里电台暗着，袋面不再有一点光，蓝羽把图折回去，没再摇那台机器。"
    nar "若是拆件保电台：塔下信标哑着，白砚的药箱扣得严，箱壁摸上去是凉的；他换手提箱，脚步比刚才慢半拍。"
    nar "若是两份都省：两处都剩半格，矿灯也跟着拧小了一格，光圈只照得见脚边。"
    nar "风穿过塔架，锈水顺着铁梁往下淌。这一节电怎么分的，四个人心里都记着，没人再提第二遍。"
    nar "坡下来路的雾又压上来一层。四个人把背包带重新勒了一遍，谁都没在这台机器边上多站。"

    $ vn2_hide("bai", trans=dissolve_soft)

    # --- 节点 4/8 · 旧线与旧人 ---
    nar "雨小了一层。塔架上的锈水顺着铁梁往下淌，滴在发报机外壳上。"
    nar "蓝羽没走。他靠着铁塔立柱，手按在图上，目光落在塔外那片雾里。"
    think "昨晚他说，怕一说队伍就散。今晚他还站在这儿，没一个人先走。"
    nar "你在他旁边站定，隔着一步远。风把他的尾巴吹得扫过靴边，他没挪开。"
    $ vn2_current_voice = "voice/lan/lan_0075.ogg"
    voice "voice/lan/lan_0075.ogg"
    lan "上一支队伍出来的时候，我也在。"
    nar "这句话他压到塔下才说出口。声音不高，被雨声托着，没有散。"
    nar "塔下的积水映着铁架的影子。一只空罐头漂在边上，被水流推着打转。"
    nar "塔架背风的一面积着旧草。蓝羽靠住立柱，肩线比白天松了一点。"
    nar "你想起守火那晚，他把绳头塞进你手里，话不多。今晚他肯在人前把旧事讲出来，已经是把后背挪过来了。"
    think "他还在这儿，就不是一个人记着那些没出来的人。"
    nar "远处洼地有乌鸦叫了两声，又被雨压下去。塔下静得能听见每个人的呼吸。"
    nar "他讲完一段，你等着下文。下文没来，他先偏头看了看坡下来路，确认没有人跟上来。"
    nar "雨丝斜着扫过立柱，在他肩上留了一层细水。他没拍，由着水顺着袖口往下滴。"

    # --- 节点 5/8 · 走之前留不留（menu） ---
    nar "信号对完，风又紧了一层。走还是留，各有各的去处。"

    menu:
        "走之前，留不留？"

        "留下来，陪他听最后一响":
            $ vn2_aff_add("lan", 4)
            $ vn2_flag("close_lan")
            nar "你们靠着铁塔站着。塔里剩下那点气还没散尽，管子轻轻响了一下，很轻，像叹气。"
            $ vn2_current_voice = "voice/lan/lan_0076.ogg"
            voice "voice/lan/lan_0076.ogg"
            lan "上一支队伍出来的时候，我也在。"
            nar "他把没说完的那些，一句一句讲给你听。风把声音压得很低。"
            $ vn2_current_voice = "voice/lan/lan_0077.ogg"
            voice "voice/lan/lan_0077.ogg"
            lan "这回我不一个人记了。"
            nar "他说完，头往立柱上靠了靠。图还按在两人中间，折痕对着塔的方位。"
            nar "管子又响了两响，声音一回比一回轻。他数着拍子，跟你说上一支队里谁惯走前面，谁总落在后队。"

        "跟青岩去核对信标方位":
            $ vn2_aff_add("qing", 4)
            nar "你回到坡上，跟青岩把方位对了两遍。"
            $ vn2_current_voice = "voice/qing/qing_0041.ogg"
            voice "voice/qing/qing_0041.ogg"
            qing "方向记死。以后找不找得到，全看这一笔。"
            nar "蓝羽一个人在塔下站了一会儿，才跟上来。"
            nar "青岩把两点之间的距离估了一遍，写进本子，又用指甲在纸边掐了个记号。"
            nar "坡上风大，本子页子翻起来。青岩用手肘压住，写完才松手。"

        "去喊白砚来看这台机器":
            $ vn2_aff_add("bai", 4)
            nar "白砚跟着你下来，看了一眼摇柄，又看了一眼蓝羽。"
            $ vn2_current_voice = "voice/bai/bai_0048.ogg"
            voice "voice/bai/bai_0048.ogg"
            bai "人比机器要紧。他脸色不对。"
            nar "他把水壶递过去，没多问。"
            nar "水壶在他怀里焐了一路，递出去的时候壶身是温的。蓝羽接过去，握了一会儿才喝。"
            nar "白砚在塔下站了一会儿，没看机器，只看蓝羽的脸色。看完才把水壶又递过去一次。"

    # --- 节点 6/8 · 归整随身物（menu） ---
    $ vn2_show("qing", pos="right", trans=dissolve_soft)

    nar "离开塔下之前，各人把随身的东西归一遍。"

    menu:
        "走之前，先做什么？"

        "把药纸交回白砚":
            $ vn2_aff_add("bai", 4)
            nar "你把昨晚叠成小方的药纸摸出来，递到白砚面前。纸角发软，折痕很深。"
            nar "他接过去，展开看了一眼，又折好，没丢。"
            $ vn2_current_voice = "voice/bai/bai_0049.ogg"
            voice "voice/bai/bai_0049.ogg"
            bai "胳膊还僵不僵。"
            nar "他不问药吃没吃，先伸手按了按你左臂的旧伤位置。指腹落在疤边，没用力。"
            $ vn2_current_voice = "voice/bai/bai_0050.ogg"
            voice "voice/bai/bai_0050.ogg"
            bai "阴天这处最容易紧。今晚换我守后半夜，你睡踏实。"
            nar "他把药纸压进自己药箱夹层，和瓶号写在一处。说完才活动自己那只不利索的右手，动作比你慢。"
            nar "你在他旁边蹲了一会儿。塔下的雨落着，水壶搁在两人中间，壶身还是温的。"

        "留在塔口替蓝羽望风":
            $ vn2_aff_add("lan", 3)
            nar "你站到塔口外侧，替他看坡下来路。雾里人影晃过一回，是风吹草动。"
            $ vn2_current_voice = "voice/lan/lan_0078.ogg"
            voice "voice/lan/lan_0078.ogg"
            lan "有你在这边，我不用回头。"
            nar "他在身后收图，折页的声音一下一下。尾巴尖从你臂边扫过去，停了半拍才收回去。"
            nar "坡下草坡起伏，雾在谷里打转。你把来路的弯数了一遍，哪一处有石头，哪一处有老树，都记下。"

        "帮青岩把样本袋归整":
            $ vn2_aff_add("qing", 3)
            nar "你蹲到样本箱边，把干苔和碎石分进两只袋，线头单独封进小纸包。"
            $ vn2_current_voice = "voice/qing/qing_0042.ogg"
            voice "voice/qing/qing_0042.ogg"
            qing "袋口系活扣。翻山要开箱，不能跟箱子较劲。"
            nar "他把分好的袋子塞进箱侧，伸手把箱带往你肩上挪正了半寸。"

    # --- 节点 7/8 · 药纸与水壶 ---
    nar "样本归完，青岩把本子扣上，塞进箱盖夹层。"
    nar "塔下的潮气往上返。白砚把水壶递过来，你喝了一口，水是温的，一直焐在他怀里。"
    think "半片药给出去，剩下的那半份，他还是自己扛着。"
    nar "蓝羽把图折好，塞回内侧口袋。他抬头看了一眼铁塔，塔顶那点光暗着，没人去碰摇柄。"
    nar "风穿过塔架，呜呜地响。信标的滴声夹在里面，不仔细听会漏掉。"
    nar "你把口袋里的绳头摸了摸——毛茬还在，没解下来。它现在只作念想，不再承重。"
    nar "样本袋系回箱侧，本子压在箱底。青岩扣箱扣的时候，指节在夹层位置按了一下。"
    nar "水壶回到白砚手里，他拧上塞子，挂回腰侧。"

    # --- 节点 8/8 · 离开 ---
    zhou "记完方位就走。别在塔下过夜。"

    nar "离开的时候，信标又响了一下。谁也没有回头。"
    nar "坡下的路被雨洗过，脚印留不住。四个人排成一线，顺着蓝羽指的方向往下走。"
    nar "下坡的草坡滑，四个人一前一后，间隔拉开。蓝羽在最前面认路，遇到裸岩就停下等后面的人踩稳。"
    nar "白砚走在中间，药箱贴着腰。青岩在最后，回头看了一眼铁塔，塔尖已经让雾遮住。"
    nar "风从背后推过来，塔架的响声越来越远，最后只剩林子里滴水的声音。"
    nar "走出半里，信标的响声彻底听不见了。坡下的林子密起来，树干一棵挨一棵。"
    nar "下坡的草叶擦着裤腿，湿了一片。泥地里的脚印被后面的人踩乱，分不出谁先谁后。"
    nar "走在中间的白砚偶尔停下换手提药箱，歇一口气，又跟上队伍。"

    $ vn2_hide_all(trans=dissolve_soft)
    $ vn2_leave_chapter()
