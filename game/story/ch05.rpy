# 第 5 章 • 绳结（第 5 天 / 共同线）
# 节点：1 吊臂与一段绳 · 2 死结三遍 · 3 三种打法（menu）· 4 歇脚归置
#       · 5 干处让给谁（menu）· 6 练熟与旧话（menu）· 7 干处与并肩 · 8 腰上两段绳

label ch05:

    scene bg forest with slow_fade
    $ vn2_enter_chapter("ch05")
    call vn2_title_card(5, "绳结", "第 5 天 • 共同线")
    $ vn2_amb("forest")

    if vn2_story_mode == "cut":
        jump ch05_cut

    $ vn2_show("lan", pos="left", trans=dissolve_soft)

    # --- 节点 1/8 · 吊臂与一段绳 ---
    nar "你的左臂还吊着布带。蓝羽在你对面坐下来，理出一段绳。林子歇脚在一处背风的土坡下。白天的路走得缓，坡上全是盘根，踩上去不实。绳是从背包里翻出来的旧绳，磨过不少回，股子里起了毛。他先用指尖把毛缕捋掉，才摊开。你坐在他对面，中间隔着一段摊平的防水布。布上沾着昨天的泥印，干成一圈一圈。早上拔营的时候，雾还压在谷底。四个人顺着盘根往上走，鞋底打滑，谁也没敢快。"
    nar "你的左臂从断崖那天起就没抬过肩。布带一夜没松，锁骨旁边压出一道红印，抬手就扯着疼。歇脚的地方是蓝羽先挑的：背风，头顶有枝桠遮着，脚下不是烂泥。他挑位置一向先看退路。夜里落过一阵小雨，树叶擦过就往下滴水。背包外层潮了一层，内里还干，绳和药瓶没受影响。你把袖子卷上去又放下，吊着的胳膊压在布带里，血往下走，指尖有点发麻。坡上的盘根一截露出土外，踩上去打滑。"
    nar "蓝羽走在前头，遇到根就用脚尖先探一探实不实。歇脚前那段路没人说话，只剩鞋底蹭过湿泥的声音，一步接一步。"
    think "胳膊吊着，只能用右手。绳结这种活，本来就该手熟。"

    # --- 节点 2/8 · 死结三遍 ---
    $ vn2_current_voice = "voice/lan/lan_0031.ogg"
    voice "voice/lan/lan_0031.ogg"
    lan "这种结，越拉越紧。松不了。"
    zhou "听着像骂人。"
    $ vn2_current_voice = "voice/lan/lan_0032.ogg"
    voice "voice/lan/lan_0032.ogg"
    lan "像。"
    nar "他打了三遍。第四遍，你伸手把绳要过来，你打了三次。三次都松。第一次圈绕反了，绳尾从结里穿出来；第二次结压紧了，绳股拧着，一拉就歪；第三次看着像了，拎起来一抖，自己散成两段。"
    think "他没说话。绳摊在两人中间，等你再打。"
    nar "风从坡顶压下来，绳头在布面上轻轻扫。蓝羽把自己打好的那个结搁在旁边，绳股收得整整齐齐，做给你看。他打绳结不用看手。指尖记得每一圈怎么走，绳尾从哪一股穿出来，收在哪一面。你右手把绳绕来绕去，股子在掌心里磨出一点毛。汗从手心渗出来，绳握久了发滑。林子静下来，只剩坡上的风穿过枝桠，呜呜地响。远处有鸟叫了两声，又停了。蓝羽打绳结的时候不说话。"
    nar "一圈压一圈，绳尾从股子底下穿出来，他指尖一挑，结面就紧了。你照着他的样子绕，圈数对了，压法不对。绳在手里软着，不听使唤。绳是旧的，股子磨细了一截。新绳滑，旧绳涩，打法得跟着绳性走。他把自己那段绳在掌心摊开，指腹顺着股子捋过去，让你摸结面收紧的方向。"

    # --- 节点 3/8 · 三种打法（menu） ---
    menu:
        "结怎么往下练？"

        "拆了重打，打到结自己立住":
            $ vn2_aff_add("lan", 4)
            nar "第五遍，结成了，你右手心全是汗。"
            $ vn2_current_voice = "voice/lan/lan_0033.ogg"
            voice "voice/lan/lan_0033.ogg"
            lan "成了。以后你打，我不用看。"
            nar "他把绳收起来，收得很慢，像在数你打的每一个圈。结成的那个圈立在布上，不歪。他用指尖压了压结面，没松。他把结拎起来抖了两下，绳股不转。又递回你手里，让你自己捏一遍结面。"

        "请教白砚的活扣打法":
            $ vn2_aff_add("bai", 4)
            $ vn2_hide("lan")
            $ vn2_show("bai", pos="center")
            nar "白砚隔着两步看了一遍，伸手示范。活扣，一拉就开。"
            $ vn2_current_voice = "voice/bai/bai_0024.ogg"
            voice "voice/bai/bai_0024.ogg"
            bai "绳是死的，人要活的。两种都得会。"
            nar "他转腕收绳的时候，手腕比夜里那回顺，没再僵着停一下。"
            $ vn2_current_voice = "voice/bai/bai_0025.ogg"
            voice "voice/bai/bai_0025.ogg"
            bai "吊着胳膊，别硬拉。绳尾绕两圈再收，省手。"
            nar "他把活扣拉开又扣上，动作不快，让你看清绳尾从哪一面出。药箱在他脚边，瓶身排得齐整。他看绳的时候，另一只手没离箱扣。"

        "看青岩样本箱上的捆绳怎么收":
            $ vn2_aff_add("qing", 3)
            $ vn2_hide("lan")
            $ vn2_show("qing", pos="right")
            nar "青岩正给样本箱重新捆绳，你凑过去看他的走线。"
            $ vn2_current_voice = "voice/qing/qing_0014.ogg"
            voice "voice/qing/qing_0014.ogg"
            qing "箱绳只打活扣。翻山要开箱，不能跟箱子较劲。"
            nar "他走线一趟到底，绳尾压在箱扣底下，路上颠不开。样本箱的边角包着旧皮，磨出两道白印。他伸手把箱角的泥擦掉，擦得很慢。"

    $ vn2_hide_all(trans=dissolve_soft)

    # --- 节点 4/8 · 歇脚归置 ---
    nar "绳在掌心里绕来绕去。有人坐在火边，没开口。日头偏到坡后，林子里暗了一层。四个人各占一块地方：蓝羽盘绳，白砚理药箱，青岩蹲在样本箱旁归置今天采的东西。坡下的泥泡透了，踩上去一脚一个坑。只有树根背风那一块，被枝叶遮着，没怎么淋到，铺着一块旧防水布，布面还干。青岩把今天的样本一格一格归进箱里：叶片压平，枝条捆齐，小块的石头塞进棉纸。"
    nar "他做这些的时候不出声，箱扣开合只轻响一下。他翻开小本子，把样本编号记上去。笔尖在纸上走得很慢，写完一页，本子扣回箱侧的皮套。白砚把药瓶一只只擦干，瓶身朝外排进箱格。绷带卷松了的，重新卷紧，压在最上面一格。蓝羽盘完绳，把地图摊在膝上，指尖顺着路线走了一遍，没出声。坡下的泥地里留着一串上来的脚印，深浅不一。走在最后的那个，脚印轻。歇脚的工夫不长。"
    nar "四个人轮流喝一口水，谁也没多喝，水囊传一圈又回到原处。白砚把药箱打开又合上，检查瓶塞。青岩把样本箱的捆绳重新勒紧，箱扣扣到最底。林子里的光一层一层往下暗，坡顶的天还剩一点灰白，底下已经看不远。"
    think "歇脚就这一会儿。谁坐哪儿，谁挨着谁，都是这会儿定下来的。"

    # --- 节点 5/8 · 干处让给谁（menu） ---
    menu:
        "歇脚这一口，先递给谁？"

        "把水壶递给青岩":
            $ vn2_aff_add("qing", 3)
            $ vn2_show("qing", pos="right")
            nar "你把水囊递过去。青岩接了，喝一口，先搁在自己膝头。他抬头看见你吊着胳膊，站在湿泥边上，没说话。他把样本箱挪到脚边的树根上，自己起身，坐到旁边湿泥的根棱上，把那块干布往你这边拍了拍。"
            $ vn2_current_voice = "voice/qing/qing_0015.ogg"
            voice "voice/qing/qing_0015.ogg"
            qing "坐这儿。布是干的。"
            nar "你坐下，布面隔着裤子，一点不潮。他挨着你旁边坐下来，中间隔着一拳的距离，膝盖几乎碰着膝盖。他重新翻开本子，把刚才记下的编号又核了一遍，笔尖在纸边点了两下。写完，本子扣回箱侧皮套。白砚在药箱那边抬头看了一眼，又低下头去理药瓶。蓝羽盘绳的手顿了半拍，没说话。他没解释为什么把干处让出来。只把箱角往自己这边挪了挪，替你挡住坡上滑下来的泥水。"
            nar "湿泥的根棱上长着一层苔，他坐上去，裤脚边沾了泥点，没换位置。你坐着不动，能听见他翻本子时纸页轻响。两个人中间那一拳的距离，从头到尾没挪开。"

        "先问白砚，手腕还僵不僵":
            $ vn2_aff_add("bai", 3)
            $ vn2_show("bai", pos="center")
            nar "你坐到白砚旁边。他正把药瓶一只只排进箱格，瓶身朝外，标签顺着一个方向。"
            zhou "夜里揉开的那处，还僵吗？"
            nar "他抬手转了转腕，筋从皮底下走过去，没有停顿。"
            $ vn2_current_voice = "voice/bai/bai_0026.ogg"
            voice "voice/bai/bai_0026.ogg"
            bai "不僵了。阴天还会紧，不碍事。"
            nar "他看见你吊着的左臂，把箱里一卷干药布往你这边推了推，没多说。药布卷得很紧，卷边上写着日期，字是他自己的笔迹。他推过来的时候，手腕压着箱沿，没抖。"

        "把绳头绕回蓝羽手里":
            $ vn2_aff_add("lan", 3)
            $ vn2_show("lan", pos="left")
            nar "你把散在布上的绳收拢，绳头递回他手里。他接住，顺势把两段绳并成一股，往腰上试了试长短。"
            $ vn2_current_voice = "voice/lan/lan_0034.ogg"
            voice "voice/lan/lan_0034.ogg"
            lan "两段都带上。死结绑东西，活扣救人。"
            nar "他绳尾在指间绕了一圈，收尾的时候指节压着绳面，压得很紧。两段绳并在一处，一长一短。他把短的那段绕回你腰侧，说是走路时挂个小物件用。"

    # --- 节点 6/8 · 练熟与旧话（menu） ---
    menu:
        "绳练到什么程度才算够？"

        "不问，把结练熟":
            $ vn2_aff_add("lan", 3)
            $ vn2_show("lan", pos="left")
            nar "你把结拆开又打上。蓝羽看着，错的圈你自己退回来重绕。"
            $ vn2_current_voice = "voice/lan/lan_0035.ogg"
            voice "voice/lan/lan_0035.ogg"
            lan "练熟了，黑里也打得出来。"
            nar "你右手把结打了一遍又一遍，绳股在掌心里磨出一点温度。错的圈退回来重绕，绳尾压回股子底下。结成了，他在旁边点了一下头，没出声。你把结成的那个圈拎给他看，绳股不转，结面紧实。他伸手按了按，松手。"

        "顺嘴问一句，这结以前吊过什么":
            $ vn2_aff_add("lan", 3)
            $ vn2_show("lan", pos="center")
            nar "蓝羽的手停了一下。"
            $ vn2_current_voice = "voice/lan/lan_0036.ogg"
            voice "voice/lan/lan_0036.ogg"
            lan "吊东西。也吊人。"
            nar "他说完自己愣了愣，把后半个字咽回去。"
            $ vn2_current_voice = "voice/lan/lan_0037.ogg"
            voice "voice/lan/lan_0037.ogg"
            lan "……别问了。"
            nar "他把绳往身后收了收，像那句话不该在歇脚的时候说出来。坡上的风停了一瞬。你没追着问，把散在布上的绳缕捋直。"

        "把两种结都带上":
            $ vn2_aff_add("bai", 3)
            $ vn2_show("bai", pos="center")
            nar "你把死结和活扣各练了一遍。白砚看了很久，没说好，也没说不好。"
            $ vn2_current_voice = "voice/bai/bai_0027.ogg"
            voice "voice/bai/bai_0027.ogg"
            bai "活扣救命，死结绑人。都带上。"
            nar "他说完，把自己箱上的捆绳解下来又重打了一遍，两个结各留一个。活扣拉开，箱盖能掀；死结压紧，走路不松。他把两种打法各做了一遍给你看。"

    # --- 节点 7/8 · 干处与并肩 ---
    nar "歇脚的时间到了，四个人起身赶路。坡上的根绊脚，你走在中间，回头看了一眼那块干布。布上留着两个人坐过的压痕，一大一小。青岩把样本箱重新背好，箱侧皮套里的本子鼓着一角。他走在前面半步，遇到泥洼，脚步往外侧让了让，把干一点的路留给你这边。坡上的泥水顺着根往下淌，淌到干布边上就停住，没漫上来。四个人顺着盘根往下走。蓝羽在前头探路，白砚压在中间，青岩和你落在后半段。"
    nar "身后的干布被风掀起一角，又落回原处。那一块压痕留在布上，等下次歇脚。路上遇到横倒的朽木，青岩先过去，回身把样本箱递到你这边，让你托一把。他没说谢。过完朽木，他又退回后半段，跟你隔着半步并排走。样本箱在他背上一下一下磕着，箱扣扣得很紧，一路没响。"
    think "把干的地方让出来，挨着坐一段。这种事他不说，只做。"

    # --- 节点 8/8 · 腰上两段绳 ---
    nar "那天之后，你的腰上一直挂着两段绳。一段打死去的结，一段留着活扣。绳跟着步子晃，碰着腰侧，不响。林子里的天色一点一点暗下去，四个人的脚印在泥里排成一串，没散。绳结练会了，路还长。腰上这两段绳，往后每过一道岔口都用得上。天暗下来之前，队伍赶到下一处背风的位置。四个人的影子被树影拉得很长，叠在一处。"

    $ vn2_hide_all(trans=dissolve_soft)
    $ vn2_leave_chapter()
