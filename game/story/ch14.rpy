# 第 14 章 • 锁线（第 14 天 / 锁线）

label ch14:

    scene bg marsh with slow_fade
    $ vn2_enter_chapter("ch14")
    call vn2_title_card(None, "锁线", "第 14 天 • 分岔")
    $ vn2_amb("rain")

    if vn2_story_mode == "cut":
        jump ch14_cut

    $ vn2_show("lan", pos="left", trans=dissolve_soft)
    $ vn2_show("bai", pos="center", trans=dissolve_soft)
    $ vn2_show("qing", pos="right", trans=dissolve_soft)

    # --- 定场：四条路 ---
    nar "雾压到最低。沼泽边上分出四条路：一条顺着水线，一条翻脊，一条钻进密林，一条没入乱石。雨不大，绵的，落在防水布上一声叠一声。四个人站在岔口，鞋面上糊着旧泥，裤脚往下滴水。三个人都停下来，等你先开口。"
    think "跟谁走，还是自己走。"
    nar "风从四条路里轮流穿过来，带着湿土和枯叶的味。林子里没有鸟叫，只有雨打蕨叶的声。背包压在肩上，背带勒过旧伤的位置。十四天走下来，干粮袋瘪了一层，水壶晃起来，水声发空。地上的脚印叠着。进来时四个人，出去也要从这四条里挑一条。雾里看不清路尽头，只有四条浅痕从脚边散开，被雨泡得发浅。四个人身上的衣服都潮着，贴在背上，风一吹发凉。"
    nar "靴底沾的泥一步一沉，拔起来带一点黑。岔口上方枝叶被风掀动，漏下一块天。天色发灰，云压得低，像午后，又像傍晚。"

    # --- 三人表态 ---
    nar "蓝羽把地图折在手里，指节压着图边。他先看左边那条水线，又抬眼看你。"
    $ vn2_current_voice = "voice/lan/lan_0088.ogg"
    voice "voice/lan/lan_0088.ogg"
    lan "跟我走，我在前头认路。绳放我肩上，滑了有人拉。"
    nar "白砚把药箱换到身前，手指搭在箱扣上，没扣。他一个一个看过三个人的鞋和腿。"
    $ vn2_current_voice = "voice/bai/bai_0065.ogg"
    voice "voice/bai/bai_0065.ogg"
    bai "能走的我管伤。走不动的，我先停下来等。"
    nar "青岩靠着样本箱站定，箱带绕了一圈。他目光在四条路上扫了一遍，落回箱盖。"
    $ vn2_current_voice = "voice/qing/qing_0051.ogg"
    voice "voice/qing/qing_0051.ogg"
    qing "箱子不轻。要抬，得两个人抬。"
    nar "三句话三个方向。蓝羽认路，白砚看人，青岩看箱子。谁也没说服谁，雨里站成半圈。你没接话，这一步，得你先落。"

    # --- 独处：清点、绑绳、擦灯 ---
    nar "你退到岔口边一块干石头旁，把背包卸下来，东西一件件清点。一盘三股绳，湿过又晾干，股间发硬；一盏矿灯，水汽凝在灯罩上；两份压缩粮，切四份；半包受潮的火绒；一卷药布，剩半卷。绳摊在膝上，收尾重打双结。湿绳沉，多绕一道，雨里才不会松。绳头你捻了捻，芯里有一股发脆，还没断。矿灯拧亮一格，又拧小。灯罩上的水汽用袖口擦一遍，亮半刻；再擦一遍，指腹留一道水印。"
    nar "干粮数了两遍。两份，一天一顿，撑不到第三天。谁都没提饿。你把火绒撮成小束，最外面一撮发了霉，拈出来丢掉，剩下的塞回盒底，盒盖扣紧。水壶提起来摇了摇，水声不大，壶底剩一层浑的。你拧开盖抿了一小口，水是温的，有一股金属味。药布剩半卷，缝线压在包底位置。你摸了摸布角，塞回原处。背包内衬磨出一道浅痕，是这十几天背带勒出来的。"
    nar "你把清点过的东西按来路归位：绳在外侧，灯在顺手的侧袋，干粮贴着胸口。少一样都不行，多一样也没有。林子里的滴水声一阵一阵，像有人在远处数数。数到第四声，停一停，又接着数。你把湿外套搭在矮枝上，水一滴一滴落进泥里。雨还在下，四个人隔着半步，谁也没凑近，谁也没走开。"
    think "今晚还是四个人。过了明早，路上就未必是这个数。"
    nar "沼泽边起一层白雾，贴地，把四条路的尽头都藏住。你把绳盘回背包外侧，扣带检查过一遍，日字扣回到原位。守夜的时辰排不排，到这儿没人再提。十四天里每回扎营都要分的工，今晚压在舌根底下。你抬头看了一眼三个人。蓝羽在拨地图的折痕，白砚按着药箱，青岩的手搭在箱盖上。都没看你，都在等你先开口。"

label ch14_choice:

    $ _vn2_lock_opts = vn2_lock_options()

    menu(screen="vn2_lock_choice", opts=_vn2_lock_opts):
        "跟蓝羽走——他记得你腰上那截双结绳头":

            if vn2_lock_pick("lan"):
                nar "他接过你腰上那截双结绳头，在自己腕上比了比，又塞回你手里。收口那道结，是他当初多绕一道打上的。"
                $ vn2_current_voice = "voice/lan/lan_0089.ogg"
                voice "voice/lan/lan_0089.ogg"
                lan "跟得上，就别掉队。"
                nar "他把地图折好，先走左边那条。你跟上去。"
            else:
                jump ch14_choice

        "跟白砚走——他记得你腕上那道活扣":

            if vn2_lock_pick("bai"):
                nar "他翻开药箱，目光先落在你腕上那道活扣。布边磨起毛，结一拉就开。"
                $ vn2_current_voice = "voice/bai/bai_0066.ogg"
                voice "voice/bai/bai_0066.ogg"
                bai "伤口我来管。你只管走路。"
                nar "他背起药箱，往中间那条路让了半步。"
            else:
                jump ch14_choice

        "跟青岩走——他记得留给你的那份干粮":

            if vn2_lock_pick("qing"):
                nar "他把样本箱往你这边递了递。箱底那半页记录隔着板压着，边角磨毛。"
                $ vn2_current_voice = "voice/qing/qing_0052.ogg"
                voice "voice/qing/qing_0052.ogg"
                qing "样本箱不轻。你帮我抬。"
                nar "他等你接。"
            else:
                jump ch14_choice

        "独自进入":

            $ vn2_lock_pick("solo")
            nar "你没接任何人的话。刀握在自己手里，你低头看了一眼左脚。那处旧伤发紧，每踩一步踝骨酸一下，你没出声。"
            zhou "我走前面。你们跟不跟，随你们。"

    nar "雨里四条路，脚印只留下一组。"

    $ vn2_hide_all(trans=dissolve_soft)
    $ vn2_leave_chapter()
