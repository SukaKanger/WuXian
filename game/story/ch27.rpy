# 第 27 章 • 清算（第 27 天 / 结局演出）

label ch27:
    scene bg hall with slow_fade
    $ vn2_enter_chapter("ch27")
    call vn2_title_card(27, "清算", "第 27 天 • 结局")
    $ vn2_amb("tunnel")

    # --- 节点 1/6 · 地上的账 ---
    nar "站里能清点的东西都摊在走廊地上：记录、钥匙、药箱、地图。不算命，算剩下多少，哪些能带走，哪些留下。"
    nar "头灯压在肩上，光圈照着这一地。纸边卷着，金属锈出一层褐。清点到哪样，哪样在光里停一息，再归到该去的那一堆。"
    nar "记录一摞一摞摊开，编号顺着走廊墙根排，纸角被潮气浸软，掀起来要捏住边角，怕撕坏。"
    nar "钥匙搁在灯闸铁壳边上，齿痕磨平，金属凉的，和铁皮碰出一声轻响。"
    nar "药箱扣着放在靠墙一侧，箱带盘在箱盖上，搭扣一道一道扣齐。"
    nar "地图卷成筒，压在最上面，纸筒两端用绳扎住。断线那一段在纸筒侧面露出半截铅笔记号。"
    nar "地上还散着空瓶、半截扎绳、撕过的信封。哪样归哪堆，清点到跟前才分。"
    nar "光圈慢慢挪过去，尘粒在灯里浮起来，又落回石地。走廊尽头暗着，水声一滴一滴。"
    nar "墙根的水痕高过一人，水渍干成一圈一圈的印。"
    nar "头灯电池剩一格，光圈边缘发暗，你把亮度往回收了半档。"
    nar "地上的物件按来路分：带出站的一堆，留下的一堆，中间隔着半步。"
    nar "记录纸边发脆，掀重了就掉渣；你动作放轻，一页一页挪到光里。"
    nar "药箱提起来晃了晃，箱里器械碰出轻响，又静下去。"
    nar "地图纸筒的折口用指甲压过，两端扎绳不松。"
    $ _route_name = "lan" if vn2_ending_key.startswith("lan") else ("bai" if vn2_ending_key.startswith("bai") else ("qing" if vn2_ending_key.startswith("qing") else ""))
    $ _route_aff = vn2_aff_value(_route_name) if _route_name else 0

    # --- 节点 2/6 · 按结局对账 ---
    if vn2_ending_key == "seventh":
        nar "这一档账，是从十七那扇石门里算出来的。证据在防水袋里，一页没湿；守门人留在门内，骨珠搁在门槛上，人不用送，珠留下。"
        nar "袋口你又扎紧一遍。誊过的副本按编号排好，最底下压着半页不齐的记录。纸角被汗浸软了一点，字还认得出来。"
        nar "半页记录的署名起笔往上挑，和副本上抄录的笔迹对在一处。你把纸角压平，没去翻第二遍。"
        if trust_shiqi:
            nar "信是早交过的。他信你把东西带出去，信到最后一步。"
            nar "门内没有第二句话跟出来。那一点信任留在石门边上，你把它记在心里，不带出这道门。"
        if station_key:
            nar "钥匙还在你口袋里。出去之后，这道门从哪边开，由外面定。"
            nar "金属隔着布碰着大腿侧，凉的一下。走路时它轻轻晃，你没把它换到别处去。"
        nar "墙角那台无线电还剩半格电。杂音里夹着一串编号，念得很快，念完就断。没有人去拨它，也没有人记。"
        nar "杂音里没有新的编号念出来。你把机身上的灰抹掉，手又收回袖中。"
        nar "灯闸推上去一半：留一盏给门里的人，其余一盏一盏熄掉。你和本线同行的人往外走，没有人回头数留下多少。"
        nar "门槛那粒珠子你没有回头再看。它留在原处，和门里的东西搁在一处。"
        nar "防水袋在怀里贴住胸口，每走一步，纸页的棱角轻轻硌一下。"
    elif vn2_ending_key == "sealed":
        nar "这一档账，算到最后，是把站名也一并抹掉。记录封回档案柜，一份不揣；十七没露面，石门在远处合上，骨头响了一声就没了。"
        if not evidence_kept:
            nar "你亲手把最后一摞纸压回柜里。纸边整齐，像从来没人翻过。"
            nar "抽屉槽底的灰印你没有抹平。灰留在原处，压着先前抽走那些格子的痕迹。"
        nar "抽屉推到底，柜门关好。指节上沾的灰，在裤腿上蹭掉。登记表烧了一半，剩下的半页卷成筒，塞进柜角，和空瓶搁在一处。"
        nar "空瓶一排，标签早磨掉了，瓶底留着一圈暗色的药渍。你把它们推进柜角最深处，柜门挡上。"
        nar "登记表残页上的名字被火烧去半截，剩下的笔画朝一个方向歪。"
        nar "柜角的空瓶挤在一起，瓶底碰瓶底，发出很轻的一声，被柜门压住。"
        nar "走廊墙上的编号牌被人摘过，钉子留在原处，锈成褐色。"
        nar "无线电被你关在最后。开关按下去，杂音断在半截，编号没念完。走廊一下子静下来，静得能听见水管滴水。"
        nar "钥匙搁在灯闸边上，门不锁，也不再开给下一批人。灯闸全落到底，整座站暗下来，只剩走廊尽头一点余温。"
        nar "人从站里走出来。话在门里说完了，外面不再有人提起。"
    else:
        nar "这一档账，算不出干净，也不算彻底。能带的带走，带不走的留下。"
        if _route_name == "lan":
            nar "蓝羽把地图卷好，队徽别在两人背包带挨着的那一段上；断线那一段，他用指甲描过一遍。"
            nar "三股绳盘在背包外侧，收尾打了双结。路标记号他在树干上补了两处，圈加一横，出去的人顺着找得到路。"
            nar "地图纸筒压在背包最上层，绳扎紧。队徽隔着布别在背包带上，金属的硬处在带侧鼓出一点。"
        elif _route_name == "bai":
            nar "白砚扣上药箱，泡烂的笔记塞在最上面；药还剩四支，一支没丢。"
            nar "空药瓶一只只装进回收袋，袋口扎紧。药布剩半卷，缝线压在箱底。他把器械一件一件擦过，码回盘里。"
            nar "箱盖搭扣一道一道扣上，箱带收成十字。回收袋搁在脚边，瓶身在袋里碰出轻响，又静下来。"
        elif _route_name == "qing":
            nar "青岩把样本箱扣紧，登记簿夹在胳膊底下；空着的柜子格子，他数过一遍。"
            nar "半页记录夹在登记簿最里层，纸边不齐。柜面的灰印他用指腹抹过，哪一格抽过，记在心里。"
            nar "登记簿的纸角露出来，被他压回夹层。空格子一排一排留在身后，柜面的灰重新盖住拉手。"
        if _route_aff >= 60:
            nar "他看你的眼神不像告别，像只是先把这一程放下，后头还有见。"
        else:
            nar "他点了个头。礼数到了，心里那截没说透的话，跟着人一起留下。"
        if evidence_kept:
            nar "一摞档案由你带出站外。原件留下，你手里是誊过的副本。"
            nar "副本按编号摞齐，压进防水袋。半页记录夹在最里层，纸边不齐的一角朝里。"
        else:
            nar "档案一份没动。你空着手出来，只记得纸上写过什么。"
        nar "灯闸留半盏。站不全黑，也再照不亮整条走廊。"
        nar "地上两堆东西之间，你的脚印落了几个，深浅不一。"
        nar "带来的东西归到背包一侧，留下的归到柜子一侧。手上分完，心里也分完。"
        nar "留在站里的东西不再属于哪个人，只属于这座站本身。"

    # --- 节点 3/6 · 归档的顺序 ---
    nar "留在走廊地上的纸，你按编号重新排。编号小的在最下，大的在上，一页一页对齐，不齐的纸角用指腹压平。"
    nar "誊过的副本摞在上面，残页压在中间，半页不齐的记录塞到最里层。三层分开，哪层是哪层，手上分得清。"
    nar "旧信封一只只摊开。纸浆发软，封口没有粘，折痕顺着原来的走，不另压新痕。副本折好塞进去，封口留出一道缝，不糊死。"
    nar "扎绳从背包侧袋解开，绕信封两道，横竖各一道，收尾打双结。绳头塞到结底下，不往外翘。"
    nar "指腹搓过柜面的灰，灰里混着碎纸毛。你把手上的灰在裤侧蹭掉，柜面上不留新的指印。"
    nar "空瓶、登记表残页、磨掉标签的小纸卡，归到留在站里的那一堆。不带走的东西，按原位置搁回去。"
    nar "纸页摞齐以后，你用掌心压了一遍顶面。边角参差的地方按住，松手，纸不再散。"
    nar "信封折口压过很多回，纸浆发软，再折一次就要裂开，你顺着旧痕走。"
    nar "绳结最后留成活结，到外面一拉就开；打死了结，路上不好解。"
    nar "摞好的纸页用手背推了推，侧面齐成一条线，参差的角再压一遍。"
    nar "扎绳的断头用火燎过，收口缩成一小团，摸上去发硬。"

    # --- 节点 4/6 · 最后一件东西（menu） ---
    menu:
        "最后一件东西，怎么处置？"
        "档案贴身带出去，交给外面能接住的人":
            $ vn2_flag("evidence_kept", True)
            nar "你把防水袋按在胸口。纸隔着布，硬的。你带出去，放哪儿都记得。"
            nar "袋口贴着心口，走一步碰一下。夜里宿营，你先摸它还在不在，再摸别的东西。"
            nar "袋身贴住肋骨，纸页的棱角隔着布硌着。你把它往内侧又按了按，塞进外衣最里层。"
            nar "外面要找的人还没见过面。袋子交到谁手上，到了外面再定；先保证它跟你走完这段林。"
        "档案封回站里，一份不留" if vn2_ending_key != "seventh":
            $ vn2_flag("evidence_kept", False)
            nar "抽屉推到底，柜门关好。指节上沾的灰，在裤腿上蹭掉。留这儿，烂在这儿比散出去强。"
            nar "柜门关合的声音很闷。你退后半步，看了一眼柜面，转身走开。"
            nar "抽屉槽底压着残页的印子，灰重新盖住拉手。你没有再拉开第二回。"
            nar "留在柜里的纸受潮、长霉，都在这座站里头。外面翻不到，也不必有人翻到。"
        "钥匙留在闸边，门不再打开":
            $ vn2_flag("station_key", False)
            nar "钥匙放在铁壳上，磕出一声轻响。你把手收回来，没再去碰。门到这儿，下一批人不必进来了。"
            nar "闸柄上两道旧指印被你看了一眼。手离开铁壳，金属凉的温度留在掌心一瞬，散掉。"
            nar "口袋里空出一块。走路时大腿侧不再有金属碰布的那一下。"

    # --- 节点 5/6 · 离开走廊 ---
    nar "归档做完，你最后走到灯闸跟前。铁壳凉的，闸柄落到底，廊里的灯一盏一盏暗下去。"
    nar "剩最后半盏，光圈贴着墙根。你站在光里停了一息，听走廊里的水声。"
    nar "门推开一道缝。门外的气灌进来，干一点，混着土腥和枯叶味，和门里的潮气对在一处。"
    nar "脚步声踩在石地上，一下一下，回音很短。走到门口，鞋底从石面换到门槛，再换到门外的土上。"
    nar "潮气从衣摆、墙根退回去。墙皮上的水痕留在身后，门一带上，水声被隔在门里。"
    nar "你没有在门口站第二遍。手离开门框，衣料擦过冰凉的铁皮。"
    nar "石地被鞋底磨出一条亮痕，从柜前一直到门口。你顺着这条痕走出去。"
    nar "门轴没有响。推门时你垫了手，和进来那天一样。"
    nar "走廊在身后暗下去，最后一点光缩在墙根，很快也没了。"
    nar "门外的干土沾在鞋帮上，和门里带出来的潮气一道，慢慢分开。"
    nar "身后的门合拢到一半，缝里漏出最后一点廊里的光。"

    # --- 节点 6/6 · 落账 ---
    if evidence_kept:
        nar "出林之前，袋子一直在你身上。夜里宿营，你先摸它还在不在。"
    else:
        nar "身上没有纸，也没有钥匙。轻了，心里却压着一件事。"
    if station_key:
        nar "钥匙还在口袋里。走过闸口时，它碰在布上，凉的一下。"
    nar "走廊的潮气从身后退干净。鞋底沾的泥在门口蹭掉，蹭成一小片，没人扫。"
    nar "人还在。只是有些东西从这一天起，回不去了。"

    $ vn2_hide_all(trans=dissolve_soft)
    $ vn2_leave_chapter()
