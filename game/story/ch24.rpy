# 第 24 章 • 守站人（第 24 天 / 青岩线）
# 节点：1/10 石门对峙（menu · 灯闸）· 2/10 骨珠与规则 · 3/10 证据带走（menu · evidence_kept）
#       · 4/10 阿瑞补给回报（cond ari_helped）· 5/10 站内最后一夜（干粮掰两份 · 并肩）
#       · 6/10 封门前的准备（C 批容器 · menu：先护箱子 / 先护记录 / 先护门）
#       · 7/10 走 / 留一夜 / 封门（menu · 三样归位）· 8/10 三样清点 · 9/10 收束到 ch25 · 10/10 章末

label ch24:
    $ vn2_unlock_cg("cg_route_qing_ruins_v0")

    scene bg hall with slow_fade
    $ vn2_enter_chapter("ch24")
    call vn2_title_card(3, "守站人", "第 24 天 • 青岩线")
    $ vn2_amb("tunnel")

    $ vn2_show("qing", pos="center", trans=dissolve_soft, expr="angry")
    $ vn2_cg_show("images/cg/cg_route_qing_ruins_v0.png", trans=dissolve_soft)

    # --- 节点 1/10 · 石门对峙 ---
    nar "走廊尽头是一道石门，半掩着。门侧暗处立着一个背影，黑豹的轮廓，不动。你看不清他的脸，他也没有走近。门里门外隔着一段石廊，谁先动，谁先开口。背影靠着石壁站，肩膀不高，尾巴收在身后。地上没有他走动的脚印，像已经在那里站了很久。灯闸在走廊另一头。铁壳上写着「照明总闸」，闸柄落下来，整座站黑到现在。铁壳边缘磨得发亮，闸柄上有两道旧指印，被人反复握过。"
    nar "走廊两侧的墙皮和外间一样湿，只是这里的水痕更高，一直漫到一人多高。你站在青岩侧后半步。石门那边的背影没有动，也没有出声，整段石廊像被人按了暂停。石廊两侧的墙根各摆着一只旧木箱，箱盖钉死，边角用铁皮包过。箱面上落着灰，灰上没有新指印。地上的石缝里塞着几根旧骨签，和骨珠同一种料，磨得圆滑。你没去碰，目光从上面扫过去。"
    $ vn2_current_voice = "voice/qing/qing_0077.ogg"
    voice "voice/qing/qing_0077.ogg"
    qing "我知道它在哪。"
    zhou "你怎么知道？"
    $ vn2_current_voice = "voice/qing/qing_0078.ogg"
    voice "voice/qing/qing_0078.ogg"
    qing "关灯那天，我在场。"

    if store.qing_trusted:
        nar "柜子前他交过底。这回他把手直接放在闸上，没藏话。"
    else:
        nar "他的手在闸壳上停了一下，掂量要不要推。"

    think "闸推上去，整座站会亮。亮了，藏在暗处的东西也藏不住。"

    menu:
        "灯闸，谁来推？"

        "信青岩，让他自己推":
            $ vn2_aff_add("qing", 5)
            nar "他把闸推上去。灯逐盏亮，每一盏都比上一盏慢。"
            $ vn2_current_voice = "voice/qing/qing_0079.ogg"
            voice "voice/qing/qing_0079.ogg"
            qing "这些年。它还能亮。"
            nar "灯光落到石门方向，那个背影退进更暗的一处，没有跟过来。"

        "先不动闸，等守站人示意":
            $ vn2_aff_add("qing", 2)
            $ vn2_flag("trust_shiqi")
            nar "你按住他的手腕，先不推。走廊那头，黑豹站在暗处，点了一下头。"
            $ vn2_current_voice = "voice/qing/qing_0080.ogg"
            voice "voice/qing/qing_0080.ogg"
            qing "……行。等他发话。"
            nar "闸柄在两个人手中间，凉的。等背影重新静住，他才松开手腕。"

        "你替他推，让他空着手":
            $ vn2_aff_add("qing", 3)
            nar "你上前把闸推上去。他的手停在半空，灯亮时闭上了眼。"
            $ vn2_current_voice = "voice/qing/qing_0081.ogg"
            voice "voice/qing/qing_0081.ogg"
            qing "……谢了。"
            nar "灯逐盏爬过走廊，他靠着墙站了一会儿，才直起身。"

    # --- 节点 2/10 · 骨珠与规则 ---
    nar "石门侧边挂着那串骨珠，七颗，刻纹顺着一个方向转。灯亮之后，珠子比在石廊里看着清楚。珠子不是装饰。每一道刻纹对应一条规矩：哪格抽屉可以动，哪条廊不能进，哪样东西带出这道门要留下。"
    think "规矩刻在骨头上，比写在纸上耐久。"
    nar "七颗珠子七种纹，走线宽窄不一。最末那颗磨得最亮，被人拨过最多回。青岩站在骨珠前，一颗一颗看过去，手指没碰绳子。"
    $ vn2_current_voice = "voice/qing/qing_0082.ogg"
    voice "voice/qing/qing_0082.ogg"
    qing "珠子的顺序没乱。守着它的人，一直按这套规矩来。"
    nar "他把刻纹的走向在本子上记了两行，和石廊里看到的对在一起。规矩只刻在珠子上，没有第二条文字说明。哪条对应哪条，要靠看的人自己对上。暗处没有话音接上来。骨珠被穿堂风带得轻轻一旋，又停住。灯绳垂在闸边，旧布缠了一圈。他抬手试了试灯绳的松紧，绳头磨起了毛，换过不止一回。七颗珠子的纹路你对着本子又核了一遍：哪一道对应留物，哪一道对应封门，珠子上没写字，全靠纹路走法分。"
    nar "最末那颗珠子旁边多刻了一道浅痕，比其余纹路新，是近年才补上的规矩。青岩把这道新痕也记了下来。"

    # --- 节点 3/10 · 证据带走（menu · evidence_kept） ---
    nar "灯亮之后，走廊里第一次有了影子。档案柜在尽头，门关着。"

    if store.evidence_copied:
        nar "你本子上抄着编号。哪一格抽过、哪一格留过底，对得上。"
    else:
        nar "你没抄过名单。柜子里还剩什么，只能凭柜面的灰印认。"

    nar "柜里剩下的残留档案，怎么处置，得在出门前定下来。带出去的东西要经得起路上的潮气和磕碰；留在柜里的，早晚可能再被人抽走。"

    menu:
        "柜子里的东西，怎么带走？"

        "交出证据，一格都不带，原样留回去":
            $ vn2_aff_add("qing", 2)
            nar "你把抽屉推回去，扣好锁。柜子和进来时一样空。"
            $ vn2_current_voice = "voice/qing/qing_0083.ogg"
            voice "voice/qing/qing_0083.ogg"
            qing "也行。东西留在这儿，人先出去。"
            nar "他看了一眼合上的柜门，没再去拉第二下。柜面的灰重新盖住拉手，看不出刚才有人开过。"

        "留下证据，按编号带走那一格的残留档案":
            $ vn2_aff_add("qing", 4)
            $ vn2_flag("evidence_kept")
            if store.evidence_copied:
                nar "照着抄下的编号，你抽出对应的那一格，把残页塞进袋里。"
            else:
                nar "你凭灰印挑了一格，残页不多，压在最底下。"
            $ vn2_current_voice = "voice/qing/qing_0084.ogg"
            voice "voice/qing/qing_0084.ogg"
            qing "带出去。留这儿，早晚又被抽走。"
            nar "残页用油纸包了两层，压在袋底，不跟干粮和工具挤在一处。"

        "分散藏，把柜里的压痕拓一份在本子上":
            $ vn2_aff_add("qing", 3)
            $ vn2_flag("evidence_kept")
            nar "你把薄纸覆在槽底压痕上，一笔一笔拓下编号和半行字。青岩站在旁边看，没出声，临走把本子往你这边推了推。拓下的纸页分两处夹：一页在本子里，一页折进样本箱的内衬夹层。一处丢了，另一处还在。他看明白这个安排，尾巴松了一点。"

    # --- 节点 4/10 · 阿瑞的补给回报（cond ari_helped） ---
    if store.ari_helped:
        nar "门口有人放下一只布包，没进来。"
        $ vn2_current_voice = "voice/ari/ari_0005.ogg"
        voice "voice/ari/ari_0005.ogg"
        ari "补给搁这儿了。别在站里过夜。"
        nar "红毛一闪，退回雾里，你没追出去。布包里是干肉和一卷绷带，扎得很紧。包角压着一片干树叶，是沼泽边的记号。干肉有四份，够两个人撑到出林。你把布包拎进走廊，搁在干燥的墙角。布包里还压着一小卷干药草，扎在绷带旁边，是沼泽边认得的那种止血草。青岩解开包角看了一眼，又原样扎好。"
    else:
        nar "门口空着。地垫被潮气浸软，上面没有布包，也没有脚印。你把门口看了一圈，回身把虚掩的门带上。补给只能靠自己袋里剩的那份。袋里的干粮数了一遍，省着分，只够两顿。夜里得先垫一口，明早留一口。"

    # --- 节点 5/10 · 站内最后一夜（干粮掰两份 · 并肩） ---
    nar "夜里站里只剩灯的电流声，很细，贴着天花板走。你和青岩分靠走廊两侧坐下。样本箱搁在中间，箱盖扣紧，带子绕了一圈。他把剩下的半块干粮掰成两份，干的那份推给你，自己留软的。"
    $ vn2_current_voice = "voice/qing/qing_0085.ogg"
    voice "voice/qing/qing_0085.ogg"
    qing "样本不怕潮，人怕。先垫一口。"
    think "他自己那份还在袋里，没动。"
    nar "门外的雾压着站墙，雨又下起来，打在窗上，一声接一声，不密。石门方向没有动静。骨珠不响，背影也没再出现在廊口。你把外套叠成枕，垫在墙根。墙是凉的，隔着一层布，凉意慢慢透上来。青岩把样本箱横在膝前，一手搭在箱盖上。夜里换过一次姿势，手没离开箱子。"
    think "箱子比他自己睡得稳。"
    nar "灯的电流声里夹着远处滴水，一滴一滴，间隔很长。你数到第十七滴，才合上眼。干粮掰成两半，他那份小一圈。你看出来了，没说，把自己那份又分了一点过去。他低头看了看递回来的那口干粮，没推让，揣进怀里，留到后半夜再吃。"

    if store.know_qing_secret:
        nar "分岔火堆那回，他把干肉推到你手边；这一回掰开，干的那半还是先过来。哪份涩、哪份干，他分得不用看。他把软的那份嚼得很慢，舌根那点涩他咽得下去，干的那半一直搁在你手边，没再往回要。"

    if store.qing_trusted:
        nar "后半夜他往你这边挪了挪，两个人肩膀挨着肩膀，都没说话。箱子横在两人中间，他的手搭在箱盖，你的手按着袋口。他把垫在墙根的外套往你那边推了推，盖住你靠墙那条腿的凉意，自己半边肩膀贴着石壁。尾巴收在两人中间，尖梢压着箱带，没扫到你。走廊里只剩滴水和电流声。他呼吸慢慢匀下来，睡着那只手也没从箱盖上挪开。你偏头能看见他侧脸，没叫醒他。"
        nar "换姿势时他先把箱子往上托了半寸，才挪动身子，免得箱角磕到墙。做完这些他没睁眼，肩膀还挨着你这边，距离没再拉开。"

    if store.qing_trusted:
        nar "靠着墙，他难得话多了一句，说的是导师当年怎么进的遗迹，说到一半又停住。"
    else:
        nar "他背对着走廊坐，尾巴压在腰后，一整夜没怎么翻身。"

    # --- 节点 6/10 · 封门前的准备（C 批容器 · menu） ---
    nar "后半夜的灯烧得发暗，玻璃罩子上一层薄灰。青岩把样本箱从膝上挪到脚边，箱盖打开，里头的东西要在天亮前归置一遍。档案柜已经空了。柜面的灰印留在原处，哪一格抽过、哪一格留过底，本子上都记着。柜子这边不用再守，剩下三件事，在箱子、记录和门之间。样本箱要腾位：内衬夹层压着杂件，记录和干粮得有各自的格。半页记录要定怎么带：誊一份留底，还是原件一起走。"
    nar "封门的材料要配齐：门边堆着旧铁皮、一串骨珠、几只木楔子。手电光在箱底停了一停。箱内衬是旧布缝的，边角磨得起毛，贴着箱壁。三样东西分属三处：箱子要走得动，记录要留得住，门要封得严。走廊深处没有动静。骨珠不响，石门那边的背影也没出现在廊口。后半夜剩下的时间不多，先动哪一样，后头两样就得等着。他蹲在箱前，手电搁在膝边，光落在箱底。"
    nar "三样事有先后，先护哪一样，由你开口。"

    menu:
        "天亮之前，先护哪一样？"

        "先护箱子":
            $ vn2_aff_add("qing", 1)
            nar "你先把样本箱腾出来。箱内杂件一件件清到布上：旧棉线、干叶、磨秃的铅笔，各归各堆。内衬夹层铺平，留出能搁油纸包的半格。他接过箱子，把箱带扣环一只只试过去，松的那只收紧一格。箱角用旧布包了边，免得路上磕着墙。箱子搁回干燥的墙角，四角对齐，推一下不晃。腾出来的半格空着，留给出门要带的东西。干粮剩下的那半块，油纸包好，在箱盖上有个稳当位置；记录的折痕压平，不折角。"
            $ vn2_current_voice = "voice/qing/qing_0086.ogg"
            voice "voice/qing/qing_0086.ogg"
            qing "箱子稳，人就稳。路上先护它。"
            nar "清出来的杂件用油纸另包了一包，搁在箱侧袋，不占夹层的干处。他把箱盖开合试了两次，扣环落槽的声音很轻。他做完这些，手搭在箱盖上，没立刻收回去。箱带在他肩上勒出一道印，他换了一次肩。"

        "先护记录":
            $ vn2_aff_add("qing", 2)
            nar "你先把半页记录就着手电誊一份。薄纸覆在原件上，一笔一笔描过笔划：日期、采样点、空着的炉号栏。誊件留在你本子里，纸边压平。原件他折回原来的折痕，一丝没偏，压进箱底夹层。两份纸各在各的位置：誊件在你怀里，原件在他箱底。他把夹层布面按了按，确认走路不滑出声。誊到空着的炉号栏，笔停了一下。那一栏从第一行到最后一行都是空的，你照空着描过去，没补一个字。"
            nar "誊一份，两份就都有底；不誊，原件只有一份，跟箱子压在一处。这一份的去向，要等出门前再定。"
            $ vn2_current_voice = "voice/qing/qing_0087.ogg"
            voice "voice/qing/qing_0087.ogg"
            qing "副本你收着。原件……我带着。"
            nar "两份纸的折痕对在一起，方向一致。他把原件压回箱底时，指腹在纸角上压了压，压平翘起的边，才把箱盖合上。"

        "先护门":
            $ vn2_aff_add("qing", 1)
            nar "你先去配封门的材料。门边旧铁皮裁下合用的两块，骨珠串从石门侧边取下来搁在布上，木楔子挑出三只，长短配门槽。他跟过来，把铁皮边角的锈磨掉，楔子在门槽里比了比深浅。骨珠七颗排开，刻纹顺着一个方向转，最末那颗新痕朝上。材料在门边码成一排，封不封，留到天亮定。铁皮背面还留着旧钉眼，他用指尖一个个摸过去，挑出没裂的那两块。"
            nar "楔子长短不一，最粗的那只留着卡主槽，细的两只补缝。门槽里的旧泥刮干净，楔子试落了一次，没敲实。他把木栓放回原处，位置记住，真要封的时候不用再找第二回。"
            $ vn2_current_voice = "voice/qing/qing_0088.ogg"
            voice "voice/qing/qing_0088.ogg"
            qing "封门的东西备着。用不用，看出去那条路。"
            nar "他退回箱边，尾巴扫过石地，没碰门边那排材料。"

    nar "三样事都备到一半。箱子腾好位，记录定了誊法，封门材料码在门边。剩下的去留，等天亮再开口。他把布上的杂件拢成一堆，没再往箱里塞。门边那排材料离箱不远，真要动门，两步就够到。走廊里只剩滴水和灯的电流声。他把样本箱横回膝前，一手搭在箱盖上。干粮剩下的半块油纸包着，不跟工具挤在一处。你把本子按在胸口。箱子留在站里还是抬出去，记录原件带走还是留下，出门那一刻才算数。"

    # --- 节点 7/10 · 走 / 留一夜 / 封门（menu · 三样归位） ---
    nar "天快亮的时候，去留要定。站门在身后，雾还没散。夜里下过一轮小雨，门板外头挂着水线。廊里的灯烧了一整夜，玻璃罩子发烫。青岩已经把箱子的外袋检查过一遍，绳结、扣环、内衬夹层，一处没漏。"

    menu:
        "最后怎么安排？"

        "天亮就走，不留":
            $ vn2_aff_add("qing", 3)
            nar "你把本子和残页收进袋里，扎紧袋口。青岩提起样本箱，试了试箱带的松紧。"
            $ vn2_current_voice = "voice/qing/qing_0089.ogg"
            voice "voice/qing/qing_0089.ogg"
            qing "走。趁雾没全散，路还认得出来。"
            nar "他先起身，把靠墙的位置让给你收东西。箱带分到两人手里，箱子由一前一后两个人提着，不压在他一个人怀里。记录原件压回箱底，誊过的副本在你本子里，各在各的位置。干粮干的那份你收进怀里，留着路上垫口。手电拧到最暗，留在走廊里照着来路，出门时再吹灭。"

        "再留一夜，把站里看完":
            $ vn2_aff_add("qing", 4)
            nar "你决定多留一夜。青岩看了你一下，把刚提起来的箱子又放回脚边。"
            $ vn2_current_voice = "voice/qing/qing_0090.ogg"
            voice "voice/qing/qing_0090.ogg"
            qing "再看一夜。剩下的格子，明天一上午能对完。"
            nar "他把手电换到满电的那盏，搁在手边，留着夜里照柜。多留这一夜，柜子里没对完的编号还能再核一遍。代价是补给又要紧一分。箱子搁回干燥的墙角，记录压回箱底，干粮掰剩的那半留到后半夜再分，谁也没先动。"

        "走之前把站门封上":
            $ vn2_aff_add("qing", 2)
            nar "你找来门边的旧木栓，把门槽卡紧。封不封得死，要看外头的风。"
            zhou "封死。以后没人找得到这儿。"
            nar "青岩摸着箱盖，没反对，也没接话。石门方向依旧没有动静。样本箱靠墙留下，箱盖扣紧；半页记录归回柜格，和空着的抽屉留在一处；没吃完的那块干粮搁在箱盖上，油纸包了一半。木栓落槽的一声很闷。封门这件事，做了就不再改。"

    # --- 节点 8/10 · 三样清点 ---
    nar "定完去留，三样东西在站里各归各位：样本箱、半页记录、剩下的干粮。你把三样的位置在本子边上又记了一遍：箱子靠哪面墙，记录压在箱底还是归进柜格，干粮在怀里还是箱盖上。青岩站在旁边看你记，手搭在箱带上，没催。样本箱的箱带在他肩上勒出一道印，他换了一次肩。记录按刚才定的位置收妥，纸边压平，不折角。"
    nar "干粮剩下的那半用油纸包着，不跟工具挤在一处。三样东西各有各的位置，谁也没混在一堆。他做这些的时候手很稳。"
    think "出去以后，这三样跟着谁走、留在谁那边，到站门外才算数。"

    # --- 节点 9/10 · 收束到 ch25 ---
    nar "灯还亮着。守站人立在走廊那头，没有跟过来。"
    $ vn2_unlock_cg("cg_qing")
    think "站门在身后。出去以后，这些东西要交给谁，下一章再定。"
    nar "雾从门缝里渗进来，和站里的潮气混在一处。你把本子按在胸口，等着天亮。青岩把样本箱的带子重新系了一遍，结打在外侧。他抬眼看了一眼石门，又收回目光。廊外的天色一点点发灰。这座站留在身后，账本上的最后一笔，留到出去再算。石门半掩的缝里漏出一线极淡的天光，和站里的灯混在一处，分不出哪一缕是外头的。你把袋口又扎紧一道。残页、拓痕、半页记录，各在各的位置，路上不会散。"

    # --- 节点 10/10 · 章末 ---
    nar "手电光往门口照过去，湿石地反出一层薄亮。两个人先后起身，箱子在两人中间，没再分开抱。雾还没散。走出这道门，站里的账要一笔一笔，带到外头去算。"

    $ vn2_hide_all(trans=dissolve_soft)
    $ vn2_leave_chapter()
