# 第 10 章 • 改过的地图（第 10 天 / 共同线）
# 节点：1 崖线滑脚 · 2 营地图上的一指宽 · 3 这一笔怎么处理（menu）
#       · 4 半片药 · 5 缺药的夜（menu）· 6 电台杂音 · 7 明天按哪张图走（menu）
#       · 8 三样裂痕 · 9 入夜

label ch10:

    scene bg cliff with slow_fade
    $ vn2_enter_chapter("ch10")
    call vn2_title_card(10, "改过的地图", "第 10 天 • 共同线")
    $ vn2_amb("rain")

    $ vn2_show("lan", pos="left", trans=dissolve_soft)
    $ vn2_show("qing", pos="right", trans=dissolve_soft)

    # --- 节点 1/9 · 崖线滑脚 ---
    nar "上午的雨比夜里大。崖壁上的苔吸饱了水，脚踩上去先滑半寸。"
    nar "雾贴着坡走，三五步外就看不见人。前头的脚印踩出来，后头的人跟着踩，一步不偏。"
    nar "队伍贴着岩壁走，一人一段，间距不到一臂。前面的人踩落碎石，石子滚下去，很久才听见落地声。"
    $ vn2_current_voice = "voice/lan/lan_0058.ogg"
    voice "voice/lan/lan_0058.ogg"
    lan "看脚下。裸岩那段不挂绳。"
    nar "崖壁上留着旧水痕，一道一道斜着往下，最旧的那几道已经干成白印。"
    think "这种坡，绳只能在人滑出去之后吃一下力。第一下稳不住，后面就没绳可吃了。"
    nar "你腰上挂着两段绳。其中一截绳头，是守火那晚蓝羽从自己绳上解下来塞给你的——收口打的是双结，圈数比你学的多绕一道。"
    nar "这一路你一直把它系在腕口，没解过。最早那会儿你当过一回活锚，说过这条绳以后归你收。"
    nar "前面的人让位置，你跟着挪步，脚下一滑，整个人往崖边倾。"
    nar "腕上的绳头绷紧。双结勒进皮肉，吃了第一下力。"
    $ vn2_current_voice = "voice/lan/lan_0059.ogg"
    voice "voice/lan/lan_0059.ogg"
    lan "抓住岩缝！"
    nar "蓝羽回身拽住你后背的带子。青岩从侧面压过来，两人一齐把你拉回岩面。"
    nar "站稳以后你才解下绳头看。双结还立着，收口散出三根细股。你用指尖捻了捻绳芯，里头发黑发潮，一捻就成细粉。"
    $ vn2_current_voice = "voice/lan/lan_0060.ogg"
    voice "voice/lan/lan_0060.ogg"
    lan "这截不能再吃第二回力。"
    nar "他说得平，手却把绳头绕在自己手心看了看，又递回给你。"
    $ vn2_current_voice = "voice/lan/lan_0061.ogg"
    voice "voice/lan/lan_0061.ogg"
    lan "留着。芯烂了，外头看不出来。"
    think "它刚才吃住了那一下。可也只吃住了那一下。"
    nar "你想起第五天练结那会儿，自己打的三遍都松。那时候以为结是最要紧的，现在才知道，结再紧，绳头旧了也白搭。"
    nar "雨顺着崖壁往下淌。谁都没提刚才那一下有多近。队伍重新排好，接着往下走。"
    nar "坡上的风顺着崖壁往下灌，吹得外套贴在身上。你把袖口卷上去，腕口的绳结贴着皮肤，潮的。"

    # --- 节点 2/9 · 营地图上的一指宽 ---
    scene bg firelight with slow_fade
    $ vn2_amb("fire")

    nar "午后雨小，队伍下到背风的林边扎营。防水布摊开，地图铺在布上。"
    nar "纸边磨得起毛。一角被潮气泡软，铅笔痕洇开半道。"
    $ vn2_current_voice = "voice/lan/lan_0062.ogg"
    voice "voice/lan/lan_0062.ogg"
    lan "这条线，被人改过。"
    nar "改动很小：一条支线往北挪了一指宽。一指宽，在图上就是两里。"
    $ vn2_current_voice = "voice/qing/qing_0033.ogg"
    voice "voice/qing/qing_0033.ogg"
    qing "改的人手法很熟。用的是制图笔。"
    $ vn2_current_voice = "voice/lan/lan_0063.ogg"
    voice "voice/lan/lan_0063.ogg"
    lan "队里没有制图笔。"
    $ vn2_current_voice = "voice/qing/qing_0034.ogg"
    voice "voice/qing/qing_0034.ogg"
    qing "所以动图的人，不在我们四个里头。"
    think "蓝羽的指尖压在那一笔上，没有挪开。"
    nar "你想起第五天打绳结那会儿。他当时话留了半句，指尖先把绳收回腰上。"
    nar "现在那点不肯说的东西落在图上——改过的支线，正指着他当时避开的方向。"
    nar "火压在石头圈里，柴是潮的，烟比火旺。四个人围着布坐下来，谁都没先碰图。"
    nar "青岩把样本箱靠在树干上，箱带绕了一圈，系成活扣。白砚捡了几块平石垒火圈，垒到第三块，手腕停了一下，又接着垒。"
    nar "你把白天崖上那截毛了的绳头搁在布角。绳和图并排摆着，一样都有旧伤。"
    nar "雨打在防水布上，声音发闷。布底下的土还是湿的，坐久了，裤腿先潮。"
    nar "石圈里的柴先点着细枝，火苗顺着苔痕往上爬。四个人等着火稳，谁都没先翻背包。"

    # --- 节点 3/9 · 这一笔怎么处理（menu） ---
    nar "那一笔在火光下泛着白。先开口的人，得担后面的分量。"

    menu:
        "这一笔，怎么处理？"

        "当面摊牌，全队把话说开":
            $ vn2_aff_add("lan", 4)
            $ vn2_flag("lan_map_fixed")
            nar "你把图推到火光照得到的地方，当着三个人把改动指出来。"
            $ vn2_current_voice = "voice/lan/lan_0064.ogg"
            voice "voice/lan/lan_0064.ogg"
            lan "我早看见了。没说。"
            nar "他声音很低，没有躲。"
            $ vn2_current_voice = "voice/lan/lan_0065.ogg"
            voice "voice/lan/lan_0065.ogg"
            lan "我怕一说，队伍就散。"
            nar "白砚把图拉过去，青岩凑过来。四个人围着一笔改痕，把话说完了。"
            nar "话说开以后，火边安静了一阵。没人怪他先瞒着，也没人把图合上。"
            nar "四个人的影子投在防水布上，被火拉得很长。图上那一笔压在影子中间，谁都看得见。"

        "先私下问蓝羽，不当众说":
            $ vn2_aff_add("lan", 4)
            nar "你把他叫到火边另一侧。图上那一笔，只有你们两个看见。"
            $ vn2_current_voice = "voice/lan/lan_0066.ogg"
            voice "voice/lan/lan_0066.ogg"
            lan "给我一晚。明天天亮，我把知道的都说出来。"
            nar "他把袖子拉下来，盖住压图的手腕。"
            nar "你点头，没催。风从林子里穿过来，火偏了一下，两个人都往图上凑了凑。"

        "装作没看见，把图折回去":
            $ vn2_aff_add("qing", 4)
            nar "你把地图折好，递回去。青岩在旁边看着，没出声。"
            $ vn2_current_voice = "voice/qing/qing_0035.ogg"
            voice "voice/qing/qing_0035.ogg"
            qing "看见的东西，装看不见，也是一种记法。"
            nar "他把这句话记下了，像记进本子里。"
            nar "本子翻到新的一页，笔尖在纸上停了两秒，才落下去写。"

    # --- 节点 4/9 · 半片药 ---
    $ vn2_show("bai", pos="center", trans=dissolve_soft)

    nar "入夜，火小下去。你把背包倒过来，东西一件件摊在布上清点。"
    nar "绳：腰上两段，一段收口毛了；干粮：两份压缩粮，切四份，一天一顿；火绒半包，受潮；矿灯一盏，水汽凝在灯罩上，擦一次亮半刻。"
    nar "药箱摆在白砚脚边。他蹲在边上，把瓶子一只一只立起来，又一只一只放倒。"
    think "药比绳先紧。"
    nar "你左臂的旧伤在雨里扯了一回，骨头缝发酸，抬到一半就发沉。他没先问，把药箱翻开，搁在膝上。"
    nar "他取出自己那一份，掰成两半。一半推到你面前，另一半搁回掌心。纸包叠成小方，折痕压得很深。"
    $ vn2_current_voice = "voice/bai/bai_0041.ogg"
    voice "voice/bai/bai_0041.ogg"
    bai "这半片你拿着。我减着量，多的这半不留也搁不住。"
    nar "他说得像在分干粮。推过来的那半片，纸角先碰到你的手背，又缩回去一点。"
    think "推过来的这半片，是从他自己那份里掰出来的。"
    nar "药箱里空出一只瓶位。他用布塞住，没让你细看。瓶外壁贴着旧标签，字被潮气洇得发淡。"
    nar "他分药的时候，指节在瓶沿上停了一下，才把瓶塞按回去。"
    nar "你数了一遍干粮。四份里有一份要留到明早。谁都没提饿，肚子先叫了一声，又被压回去。"

    # --- 节点 5/9 · 缺药的夜（menu） ---
    nar "半片药在袋底。用，还是留，今晚得有个说法。"

    menu:
        "这半片药，怎么处置？"

        "留着，先自己扛":
            $ vn2_aff_add("lan", 3)
            nar "你把纸包放回袋底。胳膊僵着，后半夜换了姿势才睡下。"
            nar "第二天，蓝羽把绕远的那条线在图上圈出来，说下坡那段缓。"
            $ vn2_current_voice = "voice/lan/lan_0067.ogg"
            voice "voice/lan/lan_0067.ogg"
            lan "疼就说。别学那支散掉的队，硬撑到看不见人。"
            think "他记得第六天那场雨，队伍散开，再没凑齐。"
            nar "你把左臂往袖子里缩了缩，没应声。绳头压在腕下，毛茬硌着皮肉。"

        "服下半片，把药纸收回去":
            $ vn2_aff_add("bai", 3)
            nar "你就着水把半片药服下。纸包展平，折好收进自己口袋，没丢。"
            nar "白砚看见那张纸，看了两秒，没问吃的是哪片。"
            $ vn2_current_voice = "voice/bai/bai_0042.ogg"
            voice "voice/bai/bai_0042.ogg"
            bai "饿了再找我。"
            nar "他把自己瓶里最后两粒倒出来数了数，又塞回去，瓶塞按得很紧。"
            nar "药下去半个时辰，胳膊的酸意退了一层。你靠着背包歇，听见他在旁边把药箱扣上，扣了两回才扣牢。"

        "拿去问白砚，先对全队的药量":
            $ vn2_aff_add("qing", 3)
            nar "你把药箱翻开，和白砚、青岩一起把余量记成数。青岩蹲在边上，一项一项抄进本子。"
            $ vn2_current_voice = "voice/qing/qing_0036.ogg"
            voice "voice/qing/qing_0036.ogg"
            qing "药写在纸上，就不会有人匀错。"
            nar "数目对完，半片药仍放回你袋里，留给夜里最难受的那个人。"
            nar "本子上那一行字写得很密。青岩写完把笔帽扣上，压在纸角，怕风掀页。"

    # --- 节点 6/9 · 电台杂音 ---
    nar "电台在背包侧袋里自己响了一声。电流声漏出来，沙沙的，像隔着一层水。"
    nar "你掀开袋缝。没有说话声，只有一串断续的编号，数字念到一半，电流空了。"
    nar "空白里只有雨声，和柴火噼啪的响。隔了一会儿，编号又接上，从头开始，还是断在同一个位置。"
    $ vn2_current_voice = "voice/lan/lan_0068.ogg"
    voice "voice/lan/lan_0068.ogg"
    lan "别记。听见了也别往本子上写。"
    nar "他把袋口折回去压住。你按了按自己的本子，到底没掏出来。"
    think "没有人开口。可那串编号，是在点人。"
    nar "编号第三遍弱下去，袋里只剩一粒小灯亮着，不闪。"
    nar "青岩抬头听了一会儿，把本子往怀里挪了挪，没动笔。白砚把药箱往火堆边推了半寸，像离那串数字远一点。"

    # --- 节点 7/9 · 明天按哪张图走（menu） ---
    $ vn2_hide("bai", trans=dissolve_soft)

    nar "图还摊在布上。明天走哪条，得趁夜定下来。"

    menu:
        "明天按哪张图走？"

        "信原图，把改过的一笔刮淡":
            $ vn2_aff_add("lan", 4)
            if lan_map_fixed:
                $ vn2_current_voice = "voice/lan/lan_0069.ogg"
                voice "voice/lan/lan_0069.ogg"
                lan "断线才是真话。改过的，是想让我们走错。"
            else:
                $ vn2_current_voice = "voice/lan/lan_0070.ogg"
                voice "voice/lan/lan_0070.ogg"
                lan "先按原图走。那一笔，我再想想。"
            nar "他用指甲把纸边刮了刮，纸面起了一层白。"
            nar "刮完他又把那一笔描回去，没真抹掉。改过的痕迹留在图上，也是一条记号。"

        "两条线都抄下来，各带一份":
            $ vn2_aff_add("qing", 4)
            nar "你抄了两份。一份给蓝羽，一份自己收着。"
            $ vn2_current_voice = "voice/qing/qing_0037.ogg"
            voice "voice/qing/qing_0037.ogg"
            qing "纸比人可靠。两条路都留着，到岔口再认。"
            nar "他把抄好的那份折成小方，塞进样本箱的夹层，和干苔放在一处。"

        "停下来，等天亮辨过方向再走":
            $ vn2_aff_add("bai", 4)
            $ vn2_current_voice = "voice/bai/bai_0043.ogg"
            voice "voice/bai/bai_0043.ogg"
            bai "雾里别硬走。走错一里，回来就是两里。"
            nar "他把药箱压在图角上，怕风把纸掀开。"
            nar "箱子压住的一角，正好是改过那一笔的位置。纸没再掀起来。"

    # --- 节点 8/9 · 三样裂痕 ---
    nar "菜单收完，你把三样东西摊在膝上：毛了的绳头，叠成小方的药纸，电台压在包底。"
    nar "绳只能用一次。药箱少了一只瓶。编号念到一半就断。"
    nar "蓝羽把图折好，折痕压在旧折痕上。青岩把本子合上，压在箱盖下面。"
    nar "没有人受重伤。四个人点一遍，都在。可这一晚算明白了：再往前，每一样东西都得掰成两半用。"
    nar "绳头的毛茬你用指腹捋了一遍，捋不回去。散出的细股搭在布上，顺着一个方向歪。"
    nar "药纸折痕很深，叠过太多回，边角发软。三样东西都还能用，只是不能再当作新的使。"
    nar "三样东西并排搁着，谁也没说要先收起来。"
    think "今天压下来的不是哪一件东西，是路本身在变窄。"
    nar "火里爆了一下，炭塌下去半寸。你添了一根细柴，火苗又立起来，比刚才矮。"

    # --- 节点 9/9 · 入夜 ---
    zhou "今晚谁也别单独碰这张图。"

    nar "那天夜里，蓝羽睡得很浅。图折在他手边，折痕对着改过的方向。"
    nar "你把矿灯拧小一格，留给后半夜。绳头压在掌心，毛茬硌着皮肉。"
    nar "林子里的滴水声一阵一阵。火塌下去一层，又被人添了一根细柴。"
    nar "青岩靠着样本箱闭眼，本子压在箱面，没离手。白砚把药箱搁在两人中间，离手不远。"
    nar "你守前半夜。火添到刚好不冒烟，矿灯搁在膝上，隔一会儿擦一次灯罩上的水汽。"
    nar "风从林子深处过来，带着腐叶和湿土的气味。远处有树枝断落，响一声，又静下去。"
    nar "天快亮的时候，雨又下起来。"

    $ vn2_hide_all(trans=dissolve_soft)
    $ vn2_leave_chapter()
