# 第 13 章 • 分岔（第 13 天 / 共同线）
# 节点：1/8 岔口两条路 · 2/8 林间行军 · 3/8 扎营起火 · 4/8 最后一块干肉（menu · 青岩干粮甜点）
#       · 5/8 夜营留意（menu · 半页记录 / 白砚活扣 / 蓝羽补图）· 6/8 守夜分工
#       · 7/8 夜话与全队呼应 · 8/8 章末

label ch13:

    scene bg forest with slow_fade
    $ vn2_enter_chapter("ch13")
    call vn2_title_card(13, "分岔", "第 13 天 • 共同线")
    $ vn2_amb("forest")

    if vn2_story_mode == "cut":
        jump ch13_cut

    $ vn2_show("lan", pos="left", trans=dissolve_soft)
    $ vn2_show("bai", pos="center", trans=dissolve_soft)
    $ vn2_show("qing", pos="right", trans=dissolve_soft)

    # --- 节点 1/8 · 岔口两条路 ---
    nar "两条路。一条近，一条对。雾压在林梢上，走到岔口，风才把雾气撕开一道口子。地上两道旧脚印，一道往坡下，一道顺着山脊，被雨泡得发浅，分不清是哪一天的人留下的。"
    $ vn2_current_voice = "voice/lan/lan_0081.ogg"
    voice "voice/lan/lan_0081.ogg"
    lan "地图上标的是对的那条。远一天，但人齐。"
    $ vn2_current_voice = "voice/bai/bai_0058.ogg"
    voice "voice/bai/bai_0058.ogg"
    bai "近的那条我走过一段。坡塌了，伤员撑不住。"
    nar "青岩站在岔口，尾巴扫着落叶，没接话。"
    think "他看近路的眼神，不像第一次见。"
    nar "蓝羽把地图摊开，纸角被潮气卷着，他用两块石头压住两头。白砚把药箱换到身前，手指搭在箱扣上，没扣。青岩的样本箱搁在脚边，箱带收得很紧。四条人影在岔口站成半圈。林子里鸟不叫，只有风从两条道里轮流穿过来，一道带着湿土味，一道带着枯叶味。"
    $ vn2_current_voice = "voice/bai/bai_0059.ogg"
    voice "voice/bai/bai_0059.ogg"
    bai "今天必须定。天黑前扎营，再拖就要摸黑走坡。"
    $ vn2_current_voice = "voice/lan/lan_0082.ogg"
    voice "voice/lan/lan_0082.ogg"
    lan "图上这条线，前人走过。没有塌痕。"
    $ vn2_current_voice = "voice/qing/qing_0046.ogg"
    voice "voice/qing/qing_0046.ogg"
    qing "……嗯。"
    nar "他应得很短，目光还留在近路那边。岔口上方的枝叶被风掀动，漏下一块天。天色发灰，云压得低，像午后，又像傍晚。你把背包带往上提了提。肩带磨了十三天，垫肩的布已经发硬。四个人身上的衣服都潮着，贴在背上，风一吹发凉。近路那边坡上有碎石往下滚，滚了几步停住。对的那条路隐进林子，看不见尽头。"

    menu:
        "走哪条？"

        "跟蓝羽，走对的那条":
            $ vn2_aff_add("lan", 4)
            $ vn2_current_voice = "voice/lan/lan_0083.ogg"
            voice "voice/lan/lan_0083.ogg"
            lan "远一天，走得稳。"
            nar "他把地图摊开，指尖压在对的那条线上。队伍排成一线，顺着他指的方向进了林子。他走在最前，每过一处裸岩就停一息，等后面的人踩稳了再挪步。绳盘在他肩上，三股，走路时不晃。"

        "听白砚，按伤员状况定":
            $ vn2_aff_add("bai", 4)
            $ vn2_current_voice = "voice/bai/bai_0060.ogg"
            voice "voice/bai/bai_0060.ogg"
            bai "先看谁的脚先打晃。撑不住，就走近的。"
            nar "他一个个看过众人的鞋和腿，把步子慢的人排在中间。药箱压在中间那个人旁边，绳带绕了一圈。他自己走在队尾，回头看队伍散没散。"

        "问青岩，哪条通站":
            $ vn2_aff_add("qing", 4)
            nar "青岩张口就答，答得太快，说完顿了一下，才把后半句补上。"
            $ vn2_current_voice = "voice/qing/qing_0047.ogg"
            voice "voice/qing/qing_0047.ogg"
            qing "……对的那条。"
            nar "他说完，把样本箱往身前挪了挪，挡住箱盖的缝。他转身进林子的时候，脚步比平时快半拍。本子在箱侧的袋里，露出一角纸边。"

    # --- 节点 2/8 · 林间行军 ---
    nar "选定的路顺着山脊走。树一棵挨一棵，枝叶在头顶搭成棚，光漏下来，碎成一地。脚下是腐叶，踩上去软，底下是湿土，一滑就是半步。你把木棍攥在手里，点地借力。队伍拉成一线。前面的人拨开的枝叶，后面的人从缝里钻过去，枝叶弹回来，打在肩上。补给又薄了一层。干粮袋在腰侧晃，分量比昨天轻。水壶只剩半壶，走路时听见水在里面撞。白砚走在队伍中段，每隔一段就回头看一眼伤员。"
    nar "药箱带子勒在肩上，他换了一次肩。蓝羽在前头辨方向，地图折在手里，边走边对。青岩背着样本箱，走在你侧后半步，箱子不晃。路上有前人踩出的浅痕，时断时续。蓝羽每隔一段就蹲下看一眼地面，确认方向没偏。你的左脚旧伤在湿路上发紧，每踩一步，踝骨那处酸一下。你没出声，步子没慢。林子里的潮气从树叶上滴下来，落在脖子里，凉一下。外套早湿透了，贴在手臂上，抬臂的时候有阻力。"
    nar "青岩在前面拨开一丛带刺的藤，等后面的人都钻过去，才松手。藤条弹回去，扫在他袖子上，他没躲。"

    if store.saved_bai:
        nar "你从背包侧袋里翻出一只备用的旧手套，掌心补过一层薄皮，叠得齐整。你换上它，指端短一截，握棍不打滑，不用再光手攥湿木棍。"

    menu:
        "行军路上，怎么照应队伍？"

        "替脚步最慢的人托一把背包":
            nar "你退到队尾，把伤员肩上的背包带接过来一段，搭在自己肩侧。他步子沉，鞋面上全是泥。"
            $ vn2_current_voice = "voice/bai/bai_0061.ogg"
            voice "voice/bai/bai_0061.ogg"
            bai "背包我来分。你只管走你的。"
            nar "他把药箱往中间又挪了挪，眼睛盯着那双打晃的脚，直到那人踩稳下一截坡。"

        "跟在队尾，一段一段清点人数":
            $ vn2_flag("trust_team")
            nar "你数人头：四个，一个不少。过一处倒木，你等最后一个钻过来，才跟上队伍。"
            $ vn2_current_voice = "voice/lan/lan_0084.ogg"
            voice "voice/lan/lan_0084.ogg"
            lan "人数对得上，再往前走。"
            nar "他在前头回头看了你一下，把绳头往肩上甩了甩，等你归队。"

        "把落脚的干处指给青岩记":
            nar "你把避开湿泥、裸岩和断根的位置一处一处说给他。他边走边记，本子翻开一角。"
            $ vn2_current_voice = "voice/qing/qing_0048.ogg"
            voice "voice/qing/qing_0048.ogg"
            qing "记下退路。回去也按这套落脚。"
            nar "他笔尖在纸上走得很快，写完一行，把本子按回箱侧袋里。"

    $ vn2_hide_all(trans=dissolve_soft)
    scene bg firelight with slow_fade
    $ vn2_amb("fire")

    $ vn2_show("lan", pos="left", trans=dissolve_soft)
    $ vn2_show("bai", pos="center", trans=dissolve_soft)
    $ vn2_show("qing", pos="right", trans=dissolve_soft)

    # --- 节点 3/8 · 扎营起火 ---
    nar "天黑前扎营。四个人围着一堆火，分今晚的饭。四份熟食，一人一份。火光照着四张脸，谁也没提明天。火是干枝子架的，烧得稳，烟往林子上头走。防水布铺在地上，背包围着火堆摆成一圈。"
    $ vn2_current_voice = "voice/lan/lan_0085.ogg"
    voice "voice/lan/lan_0085.ogg"
    lan "今天的粥比昨天稠。"
    $ vn2_current_voice = "voice/bai/bai_0062.ogg"
    voice "voice/bai/bai_0062.ogg"
    bai "稠就多吃。路上不一定有。"
    $ vn2_current_voice = "voice/qing/qing_0049.ogg"
    voice "voice/qing/qing_0049.ogg"
    qing "嗯。"
    nar "你把最后一块干肉，分给轮不到的那个人。火堆边安静了一阵，又有了说话声。"
    think "十三天，这是四个人坐得最近的一夜。"
    nar "风从林子外头绕过来，火苗偏了一下。四个人的影子投在防水布上，叠在一处。干粮袋里剩的不多，今晚分完，明早还得省一顿，谁都没说。火堆边的石头被坐得发热。你把湿外套搭在树枝上，水落进火里，滋一声就没了。白砚把药箱打开一条缝，数了一遍里面的瓶和布，又扣上。他数得很快，指尖挨过每一只瓶沿。蓝羽把地图摊在膝上，就着火光补铅笔的记号。"
    nar "铅笔短到快捏不住，他用指节顶着写。青岩把样本箱搁在干处，箱盖打开一半，他没看你，先听了一会儿林子里的动静。"

    # --- 节点 4/8 · 最后一块干肉（menu · 青岩干粮甜点） ---
    nar "四份饭分到手里。干粮有干有软：干的那块压得平整，还剩一点油光；软的那份发潮，边角发黑，嚼起来发涩，咽下去舌根发麻。最后一块干肉搁在防水布中间，谁都没先伸手。火光在四张脸上停了一会儿。"

    menu:
        "最后一块干肉，先递谁？"

        "让他先吃":
            nar "你把干肉往青岩那边推了推，让他先拿。他翻了翻两份干粮，指腹在干的和软的之间停了一下，把发涩发软的那份拨到自己膝前，干的那块连同最后一块干肉，一起推回你手边。他分得很快，像早试过哪份涩、哪份干。干肉塞进你手里，还带着他掌心的一点温度。"
            $ vn2_current_voice = "voice/qing/qing_0050.ogg"
            voice "voice/qing/qing_0050.ogg"
            qing "干的给你。我这份涩，能咽。"
            nar "你想起路上随口说过一回：苦的涩的咽不下，咽下去反胃。他当时没应声。火堆对面，白砚抬眼看了看这两份，又低头去搅自己的粥，没说话。蓝羽往火里添了根枝子，火星子起来一点。他把自己那份软干粮掰下一角塞进嘴里，嚼得很慢，另一只手把你那份的包角折好，推到你够得着的位置。尾巴尖在身后扫了一下落叶，没出声。"
            think "他当时没应声，可都记着。"

        "先把热粥端给白砚":
            nar "你把还冒热气的那份粥递过去。他接过来，先看了一眼自己药箱，又看你。"
            $ vn2_current_voice = "voice/bai/bai_0063.ogg"
            voice "voice/bai/bai_0063.ogg"
            bai "你先喝。我这只手不挑温度。"
            nar "他嘴上推，碗却没往回送，捧在手里暖了一会儿，才小口喝。"

        "先给蓝羽留一份干的":
            nar "你把压得平整的那份干粮拨到他手边。他正低头补地图，闻言抬了抬眼。"
            $ vn2_current_voice = "voice/lan/lan_0086.ogg"
            voice "voice/lan/lan_0086.ogg"
            lan "留着。明天路上垫一口。"
            nar "他没拆包，把那份压进内侧口袋，贴着图放。"

    # --- 节点 5/8 · 夜营留意（menu · 半页记录 / 白砚活扣 / 蓝羽补图） ---
    nar "饭吃完，火压小了一圈。四个人各占火堆一边，夜里的动静都在眼睛底下。"

    menu:
        "夜里，你注意到什么？"

        "看见青岩把一页纸塞回样本箱":
            $ vn2_aff_add("qing", 4)
            $ vn2_flag("know_qing_secret")
            nar "他低头把一页折过的纸塞回箱底，边角磨毛，没抬眼看四周。纸上有字。离得远，你只看清一道被划掉的痕，划得很重，透到背面。刚分干粮那会儿，他还坐在你旁边，箱子往两人中间推了半寸。这会儿箱盖合上，带子绕了一圈，手在箱盖上停了一息。他没解释，你也没问。火堆那边有人添柴，火星子起来又落下去。"
            think "刚觉得被当成自己人，就发现他有一页纸，是不打算给你看的。"
            nar "他把样本箱横到膝前，一手搭着箱盖，侧脸对着火，不说那页纸写的什么。"

        "替白砚把药布再缠一圈":
            $ vn2_aff_add("bai", 4)
            nar "他的手搁在膝上。你把松了的药布解开，重新缠紧，绕一圈，扯一下，再绕一圈，最后打了个活扣。"
            $ vn2_current_voice = "voice/bai/bai_0064.ogg"
            voice "voice/bai/bai_0064.ogg"
            bai "活扣好。一拉就开。"
            nar "他低头看了看自己的手，没再说别的。指节贴着布边，按了按活扣的位置，确认一拉就能松。药布缠完，他把右手攥了攥，又松开，筋还是硬的。他把袖口往下拉了拉，盖住腕上发硬的旧处。火光照着两个人的手。你的手刚缠完他的，他的手还搁在你手边，没立刻收回去。"
            think "活扣一拉就开，他没把它系死。"

        "帮蓝羽把地图起毛的角补好":
            $ vn2_aff_add("lan", 4)
            nar "图角磨穿了。你找了片薄皮，替他贴在背面。"
            $ vn2_current_voice = "voice/lan/lan_0087.ogg"
            voice "voice/lan/lan_0087.ogg"
            lan "补过的图，还是图。"
            nar "他把图收进怀里，贴着胸口放。薄皮贴上去，他用指节压了两遍，确认边角不翘，才把图折好。腰上那盘三股绳，他顺手往你这边挪了半寸。"

    # --- 节点 6/8 · 守夜分工 ---
    nar "夜更深。虫声一阵一阵，听不出远近。守夜排到四个人身上。前半夜两个人，后半夜两个人，火堆不能断。蓝羽把绳盘在火边，说他守头一段；白砚把药箱搁在两人中间，后半夜他叫人。青岩把样本箱横在膝前，一手搭着箱盖，说他可以守后半夜。没人争，排班就这么定了。"
    think "十三天走下来，谁先困、谁先撑不住，彼此心里都有数。"
    nar "火边摊着一张旧防水布，边角磨破，缝过两次。谁坐下来，就把它折成三层垫在膝盖下面。你把矿灯拧小一格，留给后半夜。灯的光圈落在脚边，照不到林子深处。守夜的时辰排了一遍：四个时辰，两个人轮，每人两个。谁先睡，谁先把要紧的东西搁在手边。"

    # --- 节点 7/8 · 夜话与全队呼应 ---
    zhou "都早点歇。过了明天，就快到了。"

    nar "夜深了。火压得很低，四个人各守一段夜。再往前走，就是那座地图上没有的站。"
    think "有些话，到了门口才说得出口。"
    nar "你在心里把人数过了一遍：四个。从第一天起就是四个，走到今天，一个不少。二十七天的路，已经走掉十三天。火边这一圈位置，谁挨着谁，今晚排得最齐。火苗只剩一层红炭，偶尔爆一声。林子外头的雾顺着坡漫上来，贴地。你把手套往上拉了拉。火边的人各想各的事，没人提明天进门以后的安排。青岩膝上的样本箱扣着，箱缝压得严。白砚的药箱搁在手边，箱带绕了一圈。"
    nar "蓝羽的图贴着胸口，绳盘在火旁。这一夜睡得都浅。一有树枝断，就有人睁眼。炭里偶尔爆出一点火星，升起来，灭在暗里。虫声稀了，风也小下去。你靠着背包坐着，听见身边三个人的呼吸，一浅一沉，慢慢匀下来。口袋里的干粮袋贴着腰，硬的一块，软的一块。明天进林子之前，还得再分一次。"

    # --- 节点 8/8 · 章末 ---
    $ vn2_hide_all(trans=dissolve_soft)
    $ vn2_leave_chapter()
