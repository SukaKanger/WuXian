# 第 16 章 • 旧队徽（第 16 天 / 蓝羽线）
# 节点：1 炭火清点 · 2 队徽的断口 · 3 收法（menu）· 4 三股绳与第三种结（menu）
#       · 5 断线（cond lan_map_fixed）· 6 明早路线（menu）· 7 夜营喊名 · 8 背面的半边字

label ch16:
    $ vn2_unlock_cg("cg_key_badge_v2")
    scene bg firelight with slow_fade
    $ vn2_enter_chapter("ch16")
    call vn2_title_card(1, "旧队徽", "第 16 天 • 蓝羽线")
    $ vn2_amb("fire")

    $ vn2_show("lan", pos="center", trans=dissolve_soft, expr="happy")
    $ vn2_cg_show("images/cg/cg_key_badge_v2.png", trans=dissolve_soft)

    # --- 节点 1/8 · 炭火清点 ---
    nar "雨停了半个时辰，林子里还在滴水。火压得只剩一臂高的炭，红光贴着地皮走。"
    nar "你把背包倒过来，东西一件件摊在防水布上：一盘绳、一盏矿灯、两份压缩粮、半包受潮的火绒，还有一把卷了齿的锯。"

    think "绳子够走一段断线。够不够回来，看走哪条。"

    nar "蓝羽坐在火对面，给地图补铅笔记号。铅笔短到快捏不住，他用指节顶着写。"
    $ vn2_current_voice = "voice/lan/lan_0093.ogg"
    voice "voice/lan/lan_0093.ogg"
    lan "你包里叮当响了一路。"
    zhou "矿道里捡的。一直没清点。"
    nar "他抬眼，看你摊着的这一地，视线最后落在绳上。"
    $ vn2_current_voice = "voice/lan/lan_0094.ogg"
    voice "voice/lan/lan_0094.ogg"
    lan "三股。"
    zhou "嗯。"
    $ vn2_current_voice = "voice/lan/lan_0095.ogg"
    voice "voice/lan/lan_0095.ogg"
    lan "我们那队用四股。"
    nar "他说得很平，像在说别人家的事。火光照着他半边脸，另外半边在暗里。"
    nar "你数了一遍干粮。两份压缩粮，切四份，一天一顿，撑不到第三天。"
    nar "矿灯的水汽凝在灯罩上，擦一次亮半刻，再擦一次。"
    think "三天。到站要四天。差的那一天，得靠林子里捡。"
    nar "背包侧袋里还有一小把盐，用布包着。布上写着两个字，墨早洇开了。"
    nar "绳盘在最边上。三股，湿过一回，股身发硬，你拿指甲把粘在一处的细股一根根分开。"
    nar "腕口还缠着那截旧绳头——守火那晚他从自己保命绳上解下来的，双结多绕一道。绳芯早潮得发暗，你这一路一直没解。"
    nar "火塘外圈的石头被雨泡黑，石缝里塞着去年的枯叶。你把柴一根根架上去，火苗顺着柴舔上来，又被压回一臂高。"
    nar "防潮布边角磨破，缝过两回，垫在两个人膝下。滴水声从林冠上一阵一阵落下来，落在火里，滋一声就没了。"
    nar "锯子卷了齿，掰不开硬木，只能砍细枝。火绒受潮，得靠手心搓热了才能引着。"
    nar "两份粮压在包底，边角被绳勒出一道印。你把印子捋平，免得明天分的时候碎成渣。"

    # --- 节点 2/8 · 队徽的断口 ---
    nar "最底下压着那枚队徽。金属磨得发亮，别针断在半截，背面刻着三个字，泥把两个糊住了。"
    nar "你把它拈起来，在袖子上蹭了两下，泥没掉多少。"

    if store.close_lan:
        nar "上一回在火边，他已经把银纹的事交过底。这回看见你手里的东西，他没有先去看别处。"
        $ vn2_current_voice = "voice/lan/lan_0096.ogg"
        voice "voice/lan/lan_0096.ogg"
        lan "给我看看。"
    else:
        nar "他先看队徽，又看你。尾巴收在腿边，等你先开口。"
        $ vn2_current_voice = "voice/lan/lan_0097.ogg"
        voice "voice/lan/lan_0097.ogg"
        lan "……哪儿捡的。"

    zhou "塌方矿道。挂在半塌的木梁上，被水泡了很多年。"

    nar "他把队徽接过去。指腹蹭过那道断口，来回三次，才停下。"
    $ vn2_current_voice = "voice/lan/lan_0098.ogg"
    voice "voice/lan/lan_0098.ogg"
    lan "这是我原来那支队的。一圈线，中间断一道。她画的。"
    nar "他没说「她」是谁。你也没问。"
    nar "队徽边上有道浅凹痕，像被什么东西硌过很久。你用拇指按了按，凹痕对得上他的虎口。"
    nar "他在掌心掂了掂，重量比看起来轻。"
    think "队徽在火光下转了半圈，背面朝上，又朝下。"
    nar "断口不齐，别针是从根部断的，茬口磨得圆滑——不是新折的，是被人攥了很多年，磨断的。"
    nar "他把队徽搁在膝头，金属贴着裤布，没再翻过来。火光在断口上走了一遍，又走一遍。"
    nar "队徽正面那圈线磨得最亮，中间断的一道反而浅，像被手指常年蹭着，蹭得比别处都光。"
    nar "他拇指压在那圈线上，停了一会儿，才把队徽收回掌心。"

    # --- 节点 3/8 · 收法（menu） ---
    menu:
        "队徽怎么收？"

        "收进他内侧口袋，贴着银纹":
            $ vn2_aff_add("lan", 5)
            $ vn2_flag("close_lan")
            nar "别针断了，挂不住。你把它压进他内侧口袋，贴着银纹那一侧。隔着两层布，能摸到一点硬。"
            $ vn2_current_voice = "voice/lan/lan_0099.ogg"
            voice "voice/lan/lan_0099.ogg"
            lan "……嗯。比挂外面稳。"
            nar "他把手按在口袋上，压了一会儿才放开。指节上有旧疤，压下去的时候更白。"
            nar "他顿了顿，又把队徽掏出来，断口那一面朝上，搁回你掌心里。"
            $ vn2_current_voice = "voice/lan/lan_0100.ogg"
            voice "voice/lan/lan_0100.ogg"
            lan "这儿。"
            nar "他伸手，指尖按着你的手背，把你的拇指引到那道断口上。金属凉，茬口磨圆了，硌着指腹。他没有缩手，你的指腹下，他的指节一直松着，没用力。"
            nar "断口边上的金属被他常年攥着，磨得比别处都光。你拇指顺着茬口蹭过去，他的呼吸放轻了一点，手却没往回抽。"
            nar "就这一处旧伤，他让你碰。碰完他才把队徽收回口袋，按紧袋口。两个人的手在口袋边上停了一息，先后收回去，谁都没提刚才那一下。"

        "替他收着，和地图放在一处":
            $ vn2_aff_add("lan", 3)
            nar "你拿防水袋，把队徽和地图压在一起。他盯着看了两秒，没有说不行。"
            $ vn2_current_voice = "voice/lan/lan_0101.ogg"
            voice "voice/lan/lan_0101.ogg"
            lan "丢了它，我就找不到她们那支队了。"
            nar "这话说得太快，快得像早就准备过。"
            nar "袋口折了两折，队徽压在地图折痕上，金属边贴着纸角。他伸手把袋口抚平，指腹在袋面上停了一息，才挪开。"

        "把背面的泥擦干净，看清名字":
            $ vn2_aff_add("lan", 4)
            nar "你就着炭火一点点擦。泥硬了，得用指甲抠。三个字出来：两个清楚，一个只刻了半边。"
            $ vn2_current_voice = "voice/lan/lan_0102.ogg"
            voice "voice/lan/lan_0102.ogg"
            lan "三个人。两个没出去。剩下那个，我一直在找。"
            nar "他把手伸过来，又停在半空，最后落在自己膝上。"
            nar "那半个字的泥被你抠下来，落在炭边，滚成一小撮黑灰。他看着那撮灰，没把背面再翻回去。"

    # --- 节点 4/8 · 三股绳与第三种结（menu） ---
    nar "你重新盘绳。三股的绳，收尾要打双结，不然雨里会松。绳湿了比干的时候沉。"
    nar "雨里绳会发硬，硬了不好收。你把绳摊在石头上，隔一会儿翻一次面。"
    nar "他递来一小块蜡，说抹在绳头，结不容易滑。蜡是旧的，边上咬出过牙印。"
    nar "蜡在指腹上搓开，抹过的绳股颜色深一道，干得慢。"
    nar "蜡抹完，他把绳头在火上燎了一下，收口缩成一小团，摸上去已经硬了。"

    if store.close_lan:
        nar "他看了两秒，伸手把你打歪的那一圈压平。"
        nar "接着他从自己绳身上分出一小段，绕在你腕上比了比，打出第三种结——不像双结那样收尾，结眼藏在股里，拽一下只会更紧。"
        $ vn2_current_voice = "voice/lan/lan_0103.ogg"
        voice "voice/lan/lan_0103.ogg"
        lan "第三种。留着给你自己用。"
        nar "绳段不长，绕腕一道正好，多出来的股头压在结眼里。他打的时候手背贴着你的腕骨，打完把绳尾塞回你掌心，指尖在结眼上按了按，确认滑不开。这截绳和腕口那截旧绳头一道，系在你这边。"
        nar "结眼压在腕骨上，他指腹又碾过一遍，确认不会自己松开。绳股贴着皮肤，潮的，被体温焐得慢慢回温。"
        $ vn2_aff_add("lan", 1)
    else:
        nar "他在旁边看着，没插手。"

    menu:
        "绳怎么打？"

        "照他旧队的打法，四股、双结":
            $ vn2_aff_add("lan", 4)
            nar "你把绳拆开重编，多绕一股。四股的绳更沉，湿透了也不塌。"
            $ vn2_current_voice = "voice/lan/lan_0104.ogg"
            voice "voice/lan/lan_0104.ogg"
            lan "谁教你的。"
            zhou "没人教。看过图。"
            nar "他愣了一下，笑得很轻——这是这一路上，你第一次看见他笑。"
            $ vn2_current_voice = "voice/lan/lan_0105.ogg"
            voice "voice/lan/lan_0105.ogg"
            lan "画那图的人，也没教过我。"

        "按你惯用的三股打法":
            $ vn2_aff_add("lan", 2)
            nar "你按自己的习惯收尾，快，省绳。多出来的那一段绕在腰上。"
            $ vn2_current_voice = "voice/lan/lan_0106.ogg"
            voice "voice/lan/lan_0106.ogg"
            lan "也行。断了再说。"
            nar "他嘴上这么说，还是伸手扯了扯绳结，确认够紧才走开。"

        "问他第四股是怎么断的":
            $ vn2_aff_add("lan", 3)
            nar "你问得不直。他听懂了，也答得不直。"
            $ vn2_current_voice = "voice/lan/lan_0107.ogg"
            voice "voice/lan/lan_0107.ogg"
            lan "第四股不是断的。是有人拿刀割的，救人。"
            nar "他没说救的是谁。指甲陷进绳股里，松开的时候，绳上留下一个浅印。"

    # --- 节点 5/8 · 断线 ---
    nar "火里爆了一下，炭塌下去半寸。"

    if store.lan_map_fixed:
        nar "地图上那条断线，你替他补过一回。断口处用铅笔描了两道，重叠在一起。"
        nar "他把队徽和折小的地图并排放在膝上，一边一个。"
        $ vn2_current_voice = "voice/lan/lan_0108.ogg"
        voice "voice/lan/lan_0108.ogg"
        lan "图上的线接上了。人没回来。"
        $ vn2_current_voice = "voice/lan/lan_0109.ogg"
        voice "voice/lan/lan_0109.ogg"
        lan "那天雨比今晚大。我们走到断口，她在前面。"
        nar "他停在这里。你知道后面的话，他今晚不打算讲完。"
        think "线接上了，人也回不来了。接图这件事，到底算补救还是算提醒。"
    else:
        nar "地图上那条断线还断着。他把队徽翻了个面，背面的字不让你看。"
        $ vn2_current_voice = "voice/lan/lan_0110.ogg"
        voice "voice/lan/lan_0110.ogg"
        lan "先别问刻的是谁。"
        nar "你把手收回来，去拨火。"
        think "线断在地图上，人断在别的什么地方。"

    nar "火堆边摊着一张旧防水布，边角磨破，缝过两次。他把它折成三层，垫在膝盖下面。"
    nar "你把湿外套搭在树枝上，水一滴一滴落进火里，滋一声就没了。"
    nar "炭灰里埋着半截没烧透的柴，扒开还冒着细烟。他拿棍把柴拨到外圈，让它自己慢慢熄。"

    # --- 节点 6/8 · 明早路线（menu） ---
    nar "临睡前他把地图摊开，摊在两个人中间。"
    $ vn2_current_voice = "voice/lan/lan_0111.ogg"
    voice "voice/lan/lan_0111.ogg"
    lan "明天两条走法。沿水线，稳，多半天。翻脊线，快，坡陡。"
    nar "两句话说完，他不催。火光把两条线照成一样亮。"
    nar "旧防水袋压在石头底下，纸角卷起来。他拿石块压住袋口，免得风掀。"
    nar "你问沿水线要过几处塌方。他伸出三根手指，又弯下去一根。"
    nar "翻脊线那边，他指了图上一条极细的等高线：坡上有两处裸岩，雨里滑。"

    nar "他把铅笔在指间转了两圈，又停下来，问你脚上的旧伤怎么样。"
    nar "你说能走。他没接话，只在图上两条线的交汇处画了个小圈。"

    menu:
        "明早怎么走？"

        "沿水线，稳一点":
            $ vn2_aff_add("lan", 3)
            nar "他把手指顺着水线走了一遍，在每个该停的位置点了点，一共四处。"
            $ vn2_current_voice = "voice/lan/lan_0112.ogg"
            voice "voice/lan/lan_0112.ogg"
            lan "那就慢。慢一点，少出一次事。"
            nar "你点头。他把地图折好，折痕压在原来那道旧痕上，一丝没有偏。"

        "翻脊线，抢在雨前":
            $ vn2_aff_add("lan", 4)
            nar "你说，明天午后还有一场。翻脊线能赶在雨前下到对面的洼地。"
            $ vn2_current_voice = "voice/lan/lan_0113.ogg"
            voice "voice/lan/lan_0113.ogg"
            lan "坡陡，绳得四个人拉。"
            zhou "两个人拉。你走前面。"
            nar "他看你一眼，把绳往自己肩上甩了甩，甩得比刚才重。"
            $ vn2_current_voice = "voice/lan/lan_0114.ogg"
            voice "voice/lan/lan_0114.ogg"
            lan "行。脚下滑了别喊。"

        "把路线交给他定":
            $ vn2_aff_add("lan", 5)
            nar "你把铅笔推过去。"
            zhou "你画。这条路你比我熟。"
            nar "他握着那截短铅笔，在两条线之间来回比了两次，最后选了靠里面的一条。"
            $ vn2_current_voice = "voice/lan/lan_0115.ogg"
            voice "voice/lan/lan_0115.ogg"
            lan "这条。绕远，但能看见站。"
            nar "他把笔放下，像放下什么更重的东西。"

    # --- 节点 7/8 · 夜营喊名 ---
    nar "地图折好，炭火压到最矮。守夜的时辰分过，轮到你后半夜。他靠着树根歇，外套搭在膝上，尾巴压在腿边。"
    nar "火堆这一圈暖得很薄，离两步就散。他呼吸放得很慢，像怕自己先睡着。"

    if store.lan_map_fixed:
        nar "他偏头，隔着半步看你拨火。开口时没叫「队长」，叫的是名字。"
        $ vn2_current_voice = "voice/lan/lan_0116.ogg"
        voice "voice/lan/lan_0116.ogg"
        lan "[player_name]。"
        zhou "嗯？"
        $ vn2_current_voice = "voice/lan/lan_0117.ogg"
        voice "voice/lan/lan_0117.ogg"
        lan "没什么。"
        nar "他说完就把视线挪回火上，耳朵却朝着你这一侧。火噼啪响了一声，两个人之间隔着的那半步，谁也没往中间并，也没谁退开。"
        nar "你递过去半块烤热的干粮，他接了，指尖擦过你的指节，没躲。尾巴尖在草上扫了一下，又收回去。"
        nar "干粮烤得外脆里软，他掰成小块嚼，嚼完把掌心的碎屑拢干净。火光在他侧脸走了一遍，他没再开口，也没挪位置。"
        $ vn2_aff_add("lan", 1)
    else:
        nar "他背对着火歇，尾巴压在腰后，一整夜没翻身。开口只叫「队长」，多一个字都没有。"

    # --- 节点 8/8 · 背面的半边字 ---
    nar "夜更深。虫声一阵一阵，像有人在远处数数。"
    nar "队徽在他口袋里，隔着布，不响。"

    if store.close_lan:
        nar "他睡得很浅，一有树枝断就睁眼。睁眼看你还在，才又闭上。"
    else:
        nar "他背对着火睡，尾巴压在自己腰后，一整夜没翻身。"

    nar "你最后看了一眼那三个字。两个清楚的，笔画收得很紧。那半个字的起笔，是往上挑的。"
    think "往上挑的起笔。不是那两个人里的任何一个。"
    nar "你把他扔在火边的湿袜子翻了个面，晾到离火近一点的地方。"
    nar "他的靴子立在石头旁，鞋帮上糊着一圈旧泥，泥里嵌着碎苔。"
    nar "你把矿灯拧小一格，留给后半夜。"
    nar "营地四周的蕨叶被压出一道弯，是白天走过的人留下的。明早这弯会被雨抹平。"
    nar "风从林冠缝里漏下来，火苗往一边歪，又直回去。外圈的黑一层压一层，听不出远近。"
    nar "你把守夜的柴码在手边，细的在上，粗的在下，夜里伸手就够得到。"
    nar "你数了一遍守夜的时辰：四个时辰，两个人轮，每人两个。"
    nar "你压小火焰的那一下，听见他在梦里念了一个名字。只念了一半。"
    nar "天快亮的时候，雨又下起来。"

    $ vn2_hide_all(trans=dissolve_soft)
    $ vn2_leave_chapter()
