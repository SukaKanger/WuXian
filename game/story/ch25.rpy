# 第 25 章 • 结算（第 25 天 / 共同线）
# 节点：1/6 站里的灯 · 2/6 点名 · 3/6 三样东西 · 4/6 站怎么处置（menu）
#       · 5/6 最后一样（menu）· 6/6 落账与派发

label ch25:
    $ vn2_unlock_cg("cg_key_settle_v2")

    scene bg hall with slow_fade
    $ vn2_enter_chapter("ch25")
    call vn2_title_card(25, "结算", "第 25 天 • 清算")
    $ vn2_amb("tunnel")

    if vn2_lock_route == "lan":
        $ vn2_show("lan", pos="center", trans=dissolve_soft)
    elif vn2_lock_route == "bai":
        $ vn2_show("bai", pos="center", trans=dissolve_soft)
    elif vn2_lock_route == "qing":
        $ vn2_show("qing", pos="center", trans=dissolve_soft)
    $ vn2_cg_show("images/cg/cg_key_settle_v2.png", trans=dissolve_soft)

    # --- 节点 1/6 · 站里的灯 ---
    nar "站里的灯还亮着。走廊一排白炽灯，罩子蒙灰，光发黄。该算的账，都摆到了桌上。石地返潮，墙根水痕干成几圈。廊深处水声一滴一滴，间隔很长。桌上摊着：一摞记录、一只药箱、一只样本箱、一盘绳、一枚旧队徽、几只空瓶。清点到哪样，哪样在光里停一息，再归到该去的那一堆。头灯电池剩一格，你把亮度往回收了半档。尘粒在灯里浮起来，又落回石地。"
    nar "桌上两堆东西之间隔着半步：带出站的一堆，留下的一堆。哪样归哪堆，清点到跟前才分。灯是旧白炽灯，钨丝发暗，开关旁边的墙皮起了一层细泡。记录成摞摊开，编号顺着墙根排，纸角被潮气浸软，掀起来要捏住边角，怕撕坏。地图卷成筒，压在最上面，断线那一段在纸筒侧面露出半截铅笔记号。地上还散着空瓶、半截扎绳、撕过的信封。哪样归哪堆，清点到跟前才分。"
    nar "光圈慢慢挪过去，走廊尽头暗着，水声一滴一滴。"
    think "最后一个决定，留在你手里。"

    # --- 节点 2/6 · 点名 ---
    nar "你先不点东西，先点数。蓝羽在左，白砚在中，青岩在右，加上你自己。四个。从第一天进雾到今天，二十七天的路。雨停那天点过一回，四个人，一个不少；这会儿再点，还是四个。灯底下每个人都应了一声。能走的人，都还站着，你一个一个叫过来。蓝羽应得短，白砚先看了一圈别人的伤再应，青岩应完，手仍搭在箱盖上。"
    nar "你把这四个人在心里又过了一遍：谁脚上有旧伤，谁手上发过抖，谁怀里一直抱着箱子。你身边站着的那个人，步子和你并着，背包压在同一侧肩。四个人的呼吸一浅一沉，在半盏灯底下慢慢匀下来。"
    think "承诺是四个人，一个不少。往后少不少，就看桌上这几样东西怎么分。"
    nar "二十七天。第一天进雾时四个人的脚印并排，泥深差不多；走到今天，脚印深浅不一，负重的那串踩得最深。守夜、分饭、包扎、抬箱，每一样都是四个人分摊过来的。哪一份少了人，路上就留一处空。无线电在墙角，杂音一阵一阵，中间夹着编号，念完就断。没人去拨，也没人记。廊壁上的编号牌被人摘过，钉子留在原处，锈成褐色。"

    # --- 节点 3/6 · 三样东西 ---
    nar "桌上的东西分三堆：能带走的，要留下的，已经坏的。"

    if vn2_lock_route == "lan":
        nar "能带走的是那截断绳。三股，湿过又晾干，绳头双结多绕一道，一直挂在你腰上。要留下的是那枚旧队徽。别针断在半截，背面三个字只刻出半边，断口被指腹蹭得发亮。已经坏的是绳芯。双结还立着，收口散出细股，捻开里面发黑发潮，一捻成粉——它吃住过一次力，只能再用一回。"
    elif vn2_lock_route == "bai":
        nar "能带走的是药箱夹层里那支没标签的针剂。管身编号磨平，液面剩小半管，纸上没写字。要留下的是整只药箱。箱带盘成十字，搭扣一道扣齐，瓶瓶布布各在各的格。"
        if store.bai_rationed:
            nar "箱里余量按你那次的选择，全压在他一个人身上；你手边只剩应急的一小份。"
        else:
            nar "箱里余量分成公账，三份各归各格，谁也没多占。已经坏的是敲碎的那半支。碎石管壁和干了的药渍搁在废料角，谁也没再去碰。"
    elif vn2_lock_route == "qing":
        nar "能带走的是箱底那半页记录。纸边角磨毛，折痕发白，最后一行笔锋断在纸上。要留下的是那只样本箱。四角对齐，箱盖扣紧，内衬贴着手写标签。已经坏的是被抽空的那些档案格。抽屉槽底一层浅灰，纸边磨出的印子还在，格子里什么都没有。"
    else:
        nar "三条线的东西都摊在桌上，没有一样归你贴身带走。绳、队徽、药箱、样本箱，各回各的位置。"

    nar "三堆东西在桌上隔开：带走的靠灯亮处，留下的靠墙根，坏掉的搁在最偏的废料角。你把三样东西在心里排了一遍：哪样贴身，哪样靠墙，哪样进废料角。你看了一遍又一遍。哪样轻，哪样沉，哪样已经不能再用，手上掂得出。三样里只能贴身收一样。其余的搁回原处；坏的那一样，不带走，也不必再摆回好东西里头。"

    $ _vn2_force_sealed = False
    $ _vn2_force_alone = False
    $ vn2_flag("route_commit", False)

    # --- 节点 4/6 · 站怎么处置（menu） ---
    nar "站的去向，得先定。"

    menu:
        "最后怎么处理这座站？"

        "把站封掉，谁也别再进来":
            $ _vn2_force_sealed = True
            nar "你把灯闸拉下。走廊一截一截暗下去。"
            zhou "封。连来路一起留在里面。"

        "把记录和证据带出去":
            $ vn2_flag("evidence_kept", True)
            nar "你把档案装进防水袋，扎紧袋口。纸比电可靠。"

        "和身边的人一起离开":
            $ vn2_flag("route_commit", True)
            nar "你回头。能走的人，都还站着。"

        "一个人走，不跟谁同路":
            $ _vn2_force_alone = True
            nar "你把自己的包提起来，没等谁。身后的人停了一下，没有跟上来。你听见有人把箱带重新绕紧，声音很轻。"

    # --- 节点 5/6 · 最后一样（menu） ---
    nar "站的去向定了，桌上还剩最后一样，要你亲手归置。归置东西不用快。桌上每一样都跟过这一程，放哪一堆，手上都有个准数。"

    menu:
        "最后一样，怎么处置？"

        "把能带走的那件贴身收好":
            if vn2_lock_route == "lan":
                nar "你把那截断绳解下来，盘小，塞进内侧口袋，贴着胸口放。绳结隔着布，硬一点。"
            elif vn2_lock_route == "bai":
                nar "你把那支没标签的针剂从夹层取出来，插进自己内侧口袋的布套，管口朝上。"
            elif vn2_lock_route == "qing":
                nar "你把半页记录展平，折成小方，压进贴身的防水袋，纸角朝里。"
            else:
                nar "你站在桌前，没有伸手收任何一样。"

            nar "贴身的位置只有一处。哪样放进去，哪样就跟着你走完剩下的路。"

            if store.saved_bai:
                nar "收完东西，白砚还站在灯边没动。他那只手搁在箱盖上，指节发硬，比平时凉。你走过去，把自己袖口解下来，绕住他的手腕拢了一拢。布是干的，贴着他发凉的手背焐了一会儿。他没抽回去。两个人站在半盏灯底下，谁也没提往后。廊外水声一滴一滴，隔着墙听着很远。过了一会儿，他把手收回去，扣好箱扣。你袖口重新系上，结打在外侧。"
                think "清算完了，人还在灯底下站着。这就够走到下一段路。"

        "把要留下的那样搁回原处":
            if vn2_lock_route == "lan":
                nar "你把队徽放回靠墙那堆，断别针朝上，金属磨亮的一面贴着布。背包轻了一块。"
            elif vn2_lock_route == "bai":
                nar "你把药箱推回靠墙一侧，箱带收成十字，搭扣一道扣齐。箱底那格空着，他没往里补。"
            elif vn2_lock_route == "qing":
                nar "你把样本箱对齐墙角放下，箱带系在外侧。空着的柜子格子，他临走又扫了一眼。"
            else:
                nar "桌上的东西一件件归回原处，你手上没留任何一件。"

            nar "搁回去的东西不再属于谁，只属于这座站本身。"

        "把已经坏的那件单独挑出来":
            if vn2_lock_route == "lan":
                nar "烂芯的双结你从绳上解下，搁进废料角。结还立着，芯已经成粉，不能再吃住力。"
            elif vn2_lock_route == "bai":
                nar "敲碎的半支你扫进废料角，碎石管壁并拢，药渍干在石面上。不带走，也不搁回好东西里。"
            elif vn2_lock_route == "qing":
                nar "抽空的档案格你推到底，灰印留在槽底，没抹平。格子里空着，不再塞回任何纸。"
            else:
                nar "废料角的空瓶和残页你归到一处，抽屉推到底，柜门关好。"

            nar "坏过的东西不补，也不藏。它坏在哪一程，就记在哪一程。"

    # --- 节点 6/6 · 落账与派发 ---
    nar "补给分完，方向定下来。账到此结清。"

    $ vn2_hide_all(trans=dissolve_soft)

    $ vn2_decide_ending(force_sealed=_vn2_force_sealed, force_alone=_vn2_force_alone)

    nar "出廊之前，你最后看了一眼灯。半盏光贴着墙根，再照不亮整条走廊。走廊的潮气从衣摆、墙根退回去。墙皮上的水痕留在身后。石地被鞋底磨出一条浅痕，从柜前一直到门口。你顺着这条痕站了一会儿。灯闸留半盏。站不全黑，也再照不亮整条走廊。"

    $ vn2_leave_chapter()
