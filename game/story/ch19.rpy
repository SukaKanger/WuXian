# 第 19 章 • 空药瓶（第 19 天 / 白砚线）
# 节点：1 猎人废营遗物 · 2 空药瓶与旧病历 · 3 收好 / 当面问 / 不说（menu）
#       · 4 活扣（甜点·你替他重缠，ch13 习惯二次）· 5 他敲碎自己那半支（小刀·秘密露一角）
#       · 6 说破 / 替他挡一次 / 记在本子上（menu）· 7 骨珠刻纹（menu）
#       · 8 夜话过渡 · 9 他把针剂分你一半（甜点·半片药二次，ch10 纸包回声）

label ch19:
    $ vn2_unlock_cg("cg_key_half_pill_v2")
    $ vn2_unlock_cg("cg_key_crush_v0")
    scene bg firelight with slow_fade
    $ vn2_enter_chapter("ch19")
    call vn2_title_card(1, "空药瓶", "第 19 天 • 白砚线")
    $ vn2_amb("fire")

    $ vn2_show("bai", pos="center", trans=dissolve_soft)
    $ vn2_cg_show("images/cg/cg_key_half_pill_v2.png", trans=dissolve_soft)

    # --- 节点 1/9 · 猎人废营遗物 ---
    nar "黄昏前摸到一处猎人废营。棚架塌了半面，横梁斜撑着没倒，围栏倒在长草里，陷阱锈成一团，铁齿上挂着干了多年的藤。"
    nar "风从棚缝里钻过去，带起一股霉味。地面潮，草叶上压着去年的落叶，踩上去软塌塌的，靴子底沾了一层泥。"
    nar "你把还能带走的东西一件件挑出来：一截干裂的绳、一只卷边铁盒、半捆发黑的药草、几块压在石头底下的旧布。东西摊在防水布上，一排摆开，泥点子甩在布角。"
    nar "棚架横梁上挂着半截断绳，绳头被人割过，切口齐整。围栏外的长草没过靴面，风一过，草浪往一个方向倒。铁盒里还压着半盒受潮的火绒，捏一把，散成碎末。"
    nar "干的搁布上，潮的另堆一处。火堆三面用石头围住，风从棚缝里穿过来，火苗往一边偏，又直回去。"
    nar "火堆压得很低。林子里的光一层一层暗下去，最远的树已经看不清轮廓。白砚坐在火对面，把药箱搁在膝上，一支一支点针剂。他数得很慢，嘴唇不出声，指尖在每支管身上停一下。"
    nar "他翻针剂的动作很稳，一支一支搁到掌心，对完编号再排回箱里。只有翻到旧伤那侧时，指节僵半息，才接着动。"
    nar "火堆不旺，刚好够烤干袖口。四周的黑一层压一层，只有圈里这一块是暖的。林子里的潮气从树身往下淌，裹着腐叶的味，你把靴底在石头上蹭了蹭，泥点子甩到布外。"
    $ vn2_current_voice = "voice/bai/bai_0071.ogg"
    voice "voice/bai/bai_0071.ogg"
    bai "六支。"
    think "六支针剂。队里四个人，加上他自己常年压症状的那份，账上按五个人算。怎么分都紧。"

    if store.saved_bai:
        nar "上一回你接住过那根朽杆，没让他那只旧手再折一次。他把药箱往你这边推了半寸。"
        $ vn2_current_voice = "voice/bai/bai_0072.ogg"
        voice "voice/bai/bai_0072.ogg"
        bai "你帮着对。"
    else:
        nar "他把药箱往自己这边挪开半寸，箱盖压住，没让你碰。"
        $ vn2_current_voice = "voice/bai/bai_0073.ogg"
        voice "voice/bai/bai_0073.ogg"
        bai "我自己来。"

    # --- 节点 2/9 · 空药瓶与旧病历 ---
    nar "铁盒最底下压着几只空药瓶。标签泡烂了，字一个不剩，瓶壁上结着一层白霜似的痕迹，干在里面，抠不下来。瓶口的橡皮塞发黑，拔过又塞回去，塞不紧。"
    nar "瓶口凑近闻，只剩一股药味泡久了的苦，甜不回来。"
    nar "瓶子底下是一卷纸，折了四折，边角泡软，一碰就起毛。你展开，纸贴在膝上，先压住角，不然纸自己卷回去。是一份旧病历。日期一栏写到很多个月前，一笔一笔连着；剂量一栏分着两列：一列按方子里写，另一列数字越走越低，低到方子的一半。"
    nar "足的一列字迹稳，低的一列越往后越轻，像下笔的人一次比一次不敢用力。"
    nar "名字那一栏被水糊住，只剩一个偏旁，看不全。纸边有指甲掐过的印子，一道一道，掐得很深。"
    nar "病历上的字迹是蓝墨水，后来几行换成铅笔，笔锋越来越轻。"
    nar "空瓶一共四只，塞在铁盒最底，瓶底贴着盒壁，摆得整整齐齐，像走的人临走前收过一遍。"
    nar "白砚的视线扫过来，又挪回火上。他没有伸手抢，也没有把纸翻过去。"
    think "瓶子是空的。箱里的，也不多。"
    nar "你把纸折回原来的折痕，折得比原来还齐，压回瓶子旁边。折痕对上旧印的时候，纸发出一点脆响。"

    # --- 节点 3/9 · 收法（menu） ---
    nar "火伸上来一截，炭红了一下，又暗下去。"

    menu:
        "这些东西怎么收？"

        "把空瓶和病历收好，放回原处":
            $ vn2_aff_add("bai", 4)
            nar "你找了块干布，把瓶子和纸卷包进去，塞回铁盒底层，压上旧布。铁盒盖合上的时候，他一直看着，等扣好，手才从箱盖上挪开。"
            $ vn2_current_voice = "voice/bai/bai_0074.ogg"
            voice "voice/bai/bai_0074.ogg"
            bai "……行。别摆在火边。"
            nar "他顿了顿，又补了半句，声音压得更低。"
            $ vn2_current_voice = "voice/bai/bai_0075.ogg"
            voice "voice/bai/bai_0075.ogg"
            bai "烂纸怕潮，也怕火。"
            nar "你把铁盒推回布角，用石头压住盒盖，免得风掀开。"

            # --- 节点 4/9 · 甜点 · 活扣（共同线习惯二次出现，ch13 回声） ---
            nar "收完铁盒，你看见他腕上那圈药布松了一道，布边翻起，旧处露在外面。你没问，把布接过来，解开重缠。绕一圈，扯一下，再绕一圈，收口照旧打了个活扣。"
            nar "他低头看了看自己的手，指腹在活扣的位置按了一下，确认一拉就能松。这回他没说那句话。火光照着两个人的手，你的刚缠完他的，他的手还搁在你手边，没立刻收回去。"
            nar "你想起第十三夜在火边，也是这样一圈一圈缠，他说活扣好，一拉就开。那回是四个人围着火，这回只剩火堆两边。"
            nar "他把手缩进袖口，盖住腕上发硬的旧处，喉结动了一下，没道谢。"
            think "活扣一拉就开。他肯让你缠，就是把腕子交到你手里过一回。"

        "当面问他，病历上减的是哪一支":
            $ vn2_aff_add("bai", 3)
            nar "你把纸摊到他面前，指尖点在那列走低的数字上。他顿了一下，没抬头，火光照着睫毛的影子落在纸上。"
            $ vn2_current_voice = "voice/bai/bai_0076.ogg"
            voice "voice/bai/bai_0076.ogg"
            bai "减的那支，不算在队里的账上。"
            nar "他说得很短，像这句早就压在舌根底下。说完他把纸推回给你，指腹在折痕上停了一息，收回去的时候蹭过纸面，带起一点毛。"

        "不说，先把空瓶清出营地":
            nar "你一只只把空瓶装进回收袋，瓶与瓶碰着，闷响。袋口扎紧，压到背包最底下。他没有拦，也没有道谢。火堆两边静了一会儿，只剩柴在响，炭塌下去半寸。"
            think "先不碰那卷纸。碰了，今晚这堆火就安不到天亮。"

    # --- 节点 5/9 · 他敲碎自己那半支（小刀） ---
    $ vn2_cg_show("images/cg/cg_key_crush_v0.png", trans=dissolve_soft)
    nar "针剂对完，箱底还压着一卷药布和半盒缝线。线轴上的蜡磨得发亮。"
    nar "白砚从箱侧夹层摸出一支没用完的针剂。剩下小半管，液面贴着管壁，晃一下才动。他站起来，走到塌棚边，把半支搁到石头上，用钳背敲碎。"
    nar "玻璃响了一声，很轻。残液渗进泥土，火光照不到。碎玻璃他一片一片捡起来，用布包好，压进回收袋，没留下一片在营地上。"
    nar "他蹲在棚边，等残液渗完，才把石头上的碎玻璃扫进布里。敲碎自己那半支的时候，他的手没抖，一片一片捡得很干净，像处理一件用过的器械。"
    nar "他回到火边，拍了拍手上的灰，像扔的是一块没用的布。火上挂着的铁罐水响了一声，没人去提。"

    if store.saved_bai:
        nar "他那只旧手撑了一下膝，指节僵了半息才松开。"
    else:
        nar "他攥了攥右手，又松开，没出声。"

    $ vn2_current_voice = "voice/bai/bai_0077.ogg"
    voice "voice/bai/bai_0077.ogg"
    bai "伤药不留过夜。留到明天，瓶里是什么就说不清了。"
    think "他扔的是自己那份。你看见了，他知道你看见了。"
    nar "你想起第十天火边，药箱里空出的那只瓶位，他用布塞住，没让你细看。又想起病历上那列走低的数字。两回对上了，中间隔着九天。"

    nar "火堆压到最低，炭面上一层灰白，底下还红着。你把脚边的湿柴挪开，拣两根干的架上去，火苗舔上来，先把袖口烤出一层潮气。"
    nar "药箱重新摊开在干布上。空管收进回收袋，用过的药布条拢成一团，剩下的针剂按编号排回格位，瓶身标签朝同一个方向。他一支一支点过去，指尖在管身上停一下，对完才压下箱盖。"
    nar "你把干粮从袋里掏出来数：油纸包还剩几份，干肉还剩几条，掰成小块的那份搁在最上面。水壶轮着喝过，每人一口，润嗓子，不喝足，剩下的水倒回壶里，塞紧木塞。"
    nar "棚角滴下来的水在布角洇开一小片，你把布角往里折了折，免得潮气渗进箱底。他把脚边的碎石踢开，腾出一块能坐下两个人的干处，又把矿灯拧小一格，搁在石头上，光不往林子里扫。"
    nar "火堆两边静了一阵，只剩柴响和远处林子的风。你活动了一下手指，把缠过药布的腕子转了半圈，布边还软，没发硬。"

    # --- 节点 6/9 · 说破（menu） ---
    nar "你把本子摊在膝上，页角卷起，铅笔头咬得很短。"

    menu:
        "这件事，怎么接？"

        "说破：你自己那份，也在减":
            $ vn2_aff_add("bai", 3)
            nar "你把话说得很平，没有抬声。他盯着火看了很久，火光照着他半边脸，另外半边在暗里。"
            $ vn2_current_voice = "voice/bai/bai_0078.ogg"
            voice "voice/bai/bai_0078.ogg"
            bai "……减了有一阵了。"
            nar "他没否认，也没往下讲。下颌绷着，像这句说完已经费了力气。他伸手拨了一下炭，没拨出火苗。火堆两边静了一阵，他拨炭的手停在炭上，没再拨第二下。"

        "替他挡一次：账上把他那份算足":
            $ vn2_aff_add("bai", 4)
            nar "你在本子上划了一栏：谁用、用哪支、哪天用。他那一份，你按全份记，数字写得比他自己记的还足。"
            nar "他凑过来看了一眼，笔尖在纸面上悬着，最后没划掉那一行。目光在“全份”两个字上停了一息。"
            $ vn2_current_voice = "voice/bai/bai_0079.ogg"
            voice "voice/bai/bai_0079.ogg"
            bai "记上就丢不了。"
            nar "你把本子翻到新的一页，吹干墨迹，合上的时候压平页角。"

        "记在本子上，先不吭声":
            nar "你把空瓶的数目、敲碎的半支，一笔一笔记进自己的本子，字写得很小。铅笔头在纸上磨出一点木屑，你吹掉，把本子按平。他看见你合本，眼皮抬了一下，什么都没问。"
            think "记下，不等于说破。先留着，等他自己肯讲。"

    # --- 节点 7/9 · 骨珠刻纹（遗物，非人） ---
    nar "废料里还有一串骨珠。磨得发亮，一共七颗，穿在晒硬的皮绳上，绳头打了个死结，结眼里塞着蜡。"
    nar "每颗珠子侧面刻着一道纹：有的一道，有的两道，打结的方式不一样。最边上那颗裂了一半，纹却刻得最深，裂缝里填过别的颜色，磨得差不多了。"
    nar "皮绳磨得发毛，打结的地方浸过油，硬邦邦的。珠子一颗一颗轻重不一，裂的那颗最轻。"
    nar "白砚把珠子接过去，指腹顺着刻纹走了一遍。他认得这套记号。"
    $ vn2_current_voice = "voice/bai/bai_0080.ogg"
    voice "voice/bai/bai_0080.ogg"
    bai "旧营里那位留下的。刻纹记的是用药的分量，珠子裂一颗，就是减过一回。"
    nar "他没说那个人去了哪。珠子在他掌心里转了半圈，又放回布上，皮绳盘成一圈。"
    think "七颗珠子，一道一道刻下来。他认得，是因为这套办法他自己也在用。"

    menu:
        "骨珠怎么收？"

        "替他收进铁盒，和病历放在一处":
            $ vn2_aff_add("bai", 3)
            nar "你把骨珠放回铁盒，压在旧布上，和那卷病历并排。他看了一眼，没说不行。"
            $ vn2_current_voice = "voice/bai/bai_0081.ogg"
            voice "voice/bai/bai_0081.ogg"
            bai "珠子别沾水。沾水，刻纹就花了。"

        "留在原处，不动它":
            nar "你把珠子摆回废料堆最上面，皮绳盘好。他蹲下来看了一眼，起身时把铁盒盖扣上。"
            think "遗物归遗物。今晚不替谁做决定。"

        "把裂的那颗单独收好":
            $ vn2_aff_add("bai", 2)
            nar "你解下最边上那颗裂珠，用布包好，塞进自己内袋。剩下六颗串回皮绳，递还给他。"
            $ vn2_current_voice = "voice/bai/bai_0082.ogg"
            voice "voice/bai/bai_0082.ogg"
            bai "……裂的那颗，记的是最后一回。"

    # --- 节点 8/9 · 夜话过渡 ---
    nar "夜更深。虫声一阵一阵，像有人在远处数数。雾从林子边压过来，贴着火堆外圈走，不敢近。"
    nar "他靠着树根闭上眼，手还搁在箱盖上，呼吸放得很匀。你守前半夜，火压到最矮。两个人中间隔着药箱，谁都没先睡沉。"
    nar "火堆里偶尔爆一声，火星起来又落下去。远处林子有树枝断落，响一声，又静。你把矿灯拧小一格，搁在膝上。他呼吸匀下来，右手却还搭在箱扣上，没松。"
    nar "雨又开始下，落在塌棚上，一声压一声。"

    # --- 节点 9/9 · 他把针剂分你一半（甜点·半片药二次） ---
    nar "白砚把药箱扣好，六支针剂一支没少。他从箱侧摸出一支针剂，推到你面前。又取过自己那支，把液面匀成两半：一半留在他自己管里，一半推给你。"
    nar "管壁上的液面晃了晃，一半对一半，谁也没多拿。他先把你那半管的液面调平，才动自己那支，像怕你这半管不够撑到进站。"
    $ vn2_current_voice = "voice/bai/bai_0083.ogg"
    voice "voice/bai/bai_0083.ogg"
    bai "你手上这道口子，夜里要换药。一半够撑到进站。"
    nar "他撕了一角药纸，把你那半管裹进去，纸角对折，叠成小方，折痕压得很深。折法和第十天火边那回一样，纸包搁到你掌心，先碰到你的手背，又缩回去一点。"
    nar "他说得嘴硬，没看你，把自己那半管掖回夹层，夹层的布磨起了毛。"
    think "他自己减着的那份，分了一半给你。剩下的一半，他今晚就靠它压症状。"
    nar "你把小方纸包收好，贴着内袋放。他靠着树根，耳朵还留着外头的动静，一点脚步都不肯漏。"

    $ vn2_hide_all(trans=dissolve_soft)
    $ vn2_leave_chapter()
