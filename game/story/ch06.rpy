# 第 6 章 • 雨幕（第 6 天 / 共同线）
# 节点：1 雨幕开场 · 2 合流决策（menu）· 3 半坡寻回（menu）· 4 凑齐点名
#       · 5 避雨处夜宿 · 6 火圈外那个人（menu）· 7 夜里各自的位置
#       · 8 守夜安排（menu）· 9 帐外的位置

label ch06:

    scene bg forest with slow_fade
    $ vn2_enter_chapter("ch06")
    call vn2_title_card(6, "雨幕", "第 6 天 • 共同线")
    $ vn2_amb("rain")

    if vn2_story_mode == "cut":
        jump ch06_cut

    # --- 节点 1/9 · 雨幕开场 ---
    nar "雨从午后开始下，一直没停。林子里的声音全被它吃掉一半。前面的人影一晃，就没了。"
    $ vn2_current_voice = "voice/lan/lan_0038.ogg"
    voice "voice/lan/lan_0038.ogg"
    lan "[player_name]！"
    nar "喊声出去三米，就被雨按回地上。泥地上有三串脚印，指向三个方向。雨砸在树叶上，连成一片白响。几步之外就看不清人，只剩树影一层叠一层。你抹了一把脸上的水，布带贴在左臂上，凉得刺骨。鞋底陷进泥里，拔出来带出一股腐叶味。雨幕把林子切成一段一段。刚才还在身边的人，眨眼就被树影和白响吞掉，喊声传不出三步。你按住腰上两段绳，绳被雨打湿，股子发沉。"
    nar "四周只剩雨打树叶的声音，分不清哪一声是人踩出来的。泥地上的脚印被雨砸得发糊，浅的快平了，深的还留着鞋尖的方向。"
    think "追谁？先散，还是先凑齐？"

    # --- 节点 2/9 · 合流决策（menu） ---
    menu:
        "先往哪边动？"

        "先吹哨合流，清点人数再找人":
            $ vn2_flag("trust_team")
            $ vn2_aff_add("lan", 2)
            nar "你想起蓝羽夜里说的那支队伍——也是在这种雨里散的，再没凑齐。你把哨子咬进嘴里，一声接一声吹。先把人叫回来，再谈别的。"
            zhou "都别走远！应声！"
            nar "哨声被雨压得发闷，一声断一声。你竖着耳朵等回应，林子里只剩雨声。吹到第三声，坡上传来一声很轻的应。又过一会儿，另一侧也有了动静。你把哨子攥在手里，没再走远。先把人叫到一处，再谈往哪边走。"

        "分头找人，每段路留一个结做记号":
            $ vn2_aff_add("bai", 3)
            nar "你解下腰上两段绳，边走边在树干上打活扣。记号留一路，人就不会丢第二回。"
            $ vn2_current_voice = "voice/bai/bai_0028.ogg"
            voice "voice/bai/bai_0028.ogg"
            bai "我这边顺路收记号。你跟上。"
            nar "活扣一拉就开，记号留在树皮上，回头照着结往回找。你走一段打一个结，绳尾压在股子底下。记号之间隔着十来步，雨里也看得清。白砚顺着记号往回收，经过的树干上，一个结挨着一个结。"

        "先占住高处，看清三串脚印再动":
            $ vn2_aff_add("qing", 2)
            nar "你踩着盘根上到半坡，蹲在一块裸岩后面往下看。三串脚印在泥里深浅不一，各指一方。青岩不知什么时候跟了上来，蹲在你旁边，顺着脚印方向看了一圈。"
            $ vn2_current_voice = "voice/qing/qing_0016.ogg"
            voice "voice/qing/qing_0016.ogg"
            qing "浅的那串走得急。深的那串，扛了东西。"
            nar "他说完，指了指岩壁凹处的方向，样本箱的轮廓在雨幕里隐约可见。高处看得远。三串脚印里，两串往坡下，一串贴着岩壁走。贴着岩壁那串，步幅最稳。青岩蹲在岩边，尾巴压在脚边，眼睛顺着脚印一路扫到凹处。"

    # --- 节点 3/9 · 半坡寻回（menu） ---
    $ vn2_hide_all(trans=dissolve_soft)

    menu:
        "顺着哪条踪迹先找人？"

        "沿哨声上半坡找蓝羽":
            $ vn2_aff_add("lan", 4)
            $ vn2_show("lan", pos="left")
            nar "哨声断断续续，像被雨打散。半坡上，蓝羽浑身是水，手里还攥着地图。"
            $ vn2_current_voice = "voice/lan/lan_0039.ogg"
            voice "voice/lan/lan_0039.ogg"
            lan "我以为你们走了另一条。"
            nar "你把外套撕下半幅，先裹到他肩上。地图被他压在胸口，边角没湿。他指节冻得发白，看见你，肩线松下来一点。半坡的泥滑，他靠着一棵斜树站着，裤脚全是泥。地图折在怀里，折痕对着胸口。你裹外套的时候，他没躲，任由你把半幅布搭上他的肩。"

        "循药箱磕碰声找白砚":
            $ vn2_aff_add("bai", 4)
            $ vn2_show("bai", pos="center")
            nar "白砚回来的时候，肩上扛着两个人的包。"
            $ vn2_current_voice = "voice/bai/bai_0029.ogg"
            voice "voice/bai/bai_0029.ogg"
            bai "走散就站在原地。这是规矩。"
            nar "两只包分在地上，你的那只就在脚边。他自己先坐下喘气。他裤脚全湿，药箱抱在怀里，箱扣扣到最底。喘气的时候，他眼睛一直在找其余的人。两只包分量不轻，他肩带勒进湿外套里，坐下的时候先把药箱搁稳，才揉了揉肩。他报了一声人数，听见其余方向还有动静，才把气喘匀。"

        "找青岩守样本箱的方向":
            $ vn2_aff_add("qing", 4)
            $ vn2_show("qing", pos="right")
            nar "青岩蹲在岩壁凹处，样本箱抱在膝头，箱面一点没湿。"
            $ vn2_current_voice = "voice/qing/qing_0017.ogg"
            voice "voice/qing/qing_0017.ogg"
            qing "人可以淋。箱子不行。"
            nar "凹处挡掉大半的雨，他身后的岩壁上留着几道水痕。看见你过来，他把箱往怀里收了收。样本箱搁在膝头，箱面用外套角擦过，没有一点水痕。他坐在干燥的岩台上，脚边没沾泥。他抬下巴指了指凹处外沿，让你先进来避一避，别站在雨里。"

    # --- 节点 4/9 · 凑齐点名 ---
    nar "雨停的时候，天已经黑了。火堆围成一个很小的圈。点名，四个，一个不少。你一个一个数过去：蓝羽在左，地图攥在手里；白砚在中间，两只包分在脚边；青岩在右，样本箱抱在膝头。"
    zhou "四个。都在。"
    nar "火是捡来的干枝压着湿柴生起来的，烟大，火苗矮。四个人围着小圈坐下，衣服上的水一滴一滴落进火里，滋一声就没了。你又数了一遍人数。四个影子围着火，谁也没少。雨幕外面的林子黑成一片，火圈里这一小块是干的。蓝羽把湿头发往后捋了一把，水珠顺着下颌落进火里。青岩把样本箱搁在脚边，箱扣重新扣好。"
    think "散过一回，又凑齐了，这句先记着。"

    # --- 节点 5/9 · 避雨处夜宿 ---
    scene bg firelight with slow_fade
    $ vn2_amb("fire")

    nar "避雨处选在岩壁凹进去的一片根棚下。头顶盘根交叠，挡得住后半夜的露，挡不住从缝里钻进来的风。火堆就生在根棚口，离岩壁一步。四个人的睡袋在火边排开，箱包搁在身后干燥的泥台上。雨里散开那一阵，谁都没顾上谁。白砚扛着两只包，听见喊声的时候人已经错开了方向，等他绕过去，那边只剩一串脚印。这件事他没提，你也没问。火边没人提雨里散开的那几分钟。"
    nar "他把药箱放在自己手边，没搁到中间。瓶塞一只只检查过，箱扣留着一线，伸手就能够到。蓝羽把地图摊在膝上，指尖顺着路线走了一遍，没出声。青岩把样本箱的捆绳重新勒紧，箱扣压到底。根棚外的风一阵接一阵，吹得火堆边的草伏下去。岩壁上渗着水，顺着石缝往下淌，在脚边汇成一小股。四个人换下湿外套，搭在身后的泥台上滴水。鞋里的泥倒出来，混着水在台边摊成一摊。"
    nar "白砚坐在离火最远的那块岩台边。他没往火圈里靠，药箱横在膝上，手搭在箱扣上。"
    think "人是齐了。可火圈里有一个位置，一直空着。"

    # --- 节点 6/9 · 火圈外那个人（menu） ---
    menu:
        "火圈外那个人，怎么应对？"

        "出去坐到他旁边，把人拉回火圈":
            $ vn2_aff_add("bai", 3)
            nar "你起身，绕到根棚口。白砚坐在岩壁边的石头上，药箱搁在脚边，背对着火圈。你在他旁边坐下，没说话。雨停后的风从洞口穿过来，两个人身上都是凉的。他坐了一会儿，把肩上湿外套往下扯了扯，往你这边让了半寸。"
            $ vn2_current_voice = "voice/bai/bai_0030.ogg"
            voice "voice/bai/bai_0030.ogg"
            bai "那会儿我扛着两只包。听见喊，人已经错开了。"
            nar "他只说这一句。说完，他抱着药箱往火圈那边挪了半步，没再退回石头上。洞口的风比火边硬，你俩并排坐着，谁都没再提雨里错开的那几分钟。他把药箱从膝上挪到两人中间，箱扣松开一线，伸手就能够到。"

        "留在火圈里，把他那份位置和东西留出来":
            $ vn2_aff_add("lan", 2)
            nar "你没起身。把他的睡袋在火边铺开，包搁在睡袋旁边，位置留出一拳宽。白砚在洞口看见了。他没过来，也没把睡袋收走，就那么坐着，背对着火。火圈里那份位置空着，一直空到后半夜。他的包在睡袋旁边，没离手。你坐在火边，时不时往洞口看一眼。那个位置留出来了，人没坐过来。夜风吹得睡袋边角掀起来，又落回去。"

        "当众把话说开，问他为什么不进来":
            $ vn2_aff_add("bai", 2)
            nar "你转头朝洞口开口，问他为什么不进火圈。声音不大，火边三个人都听得见。白砚的手在药箱扣上停住，他张了张嘴。"
            $ vn2_current_voice = "voice/bai/bai_0031.ogg"
            voice "voice/bai/bai_0031.ogg"
            bai "我那会儿……"
            nar "后半句他咽了回去。他把箱扣扣死，站起身，坐到更靠外的石头上，不再看火圈。蓝羽低头拨火，青岩把箱绳又勒了一道。没人接话。火边静下来，只剩炭响。白砚坐在更外的石头上，背对着所有人，药箱抱得很紧。那句话断在半截，谁也没替他补完。"

    # --- 节点 7/9 · 夜里各自的位置 ---
    nar "夜一点点深下去。火压成一层暗红的炭，烟顺着根棚顶往外走。蓝羽靠着树根，地图折好压在膝上，尾巴收在腿边。青岩把样本箱抱在怀里，尾巴搭在箱盖缝上。白砚的位置随你刚才的选择：要么挪回了火圈边，要么还坐在洞口的石头上。药箱始终在他手边，没搁到中间。你想起守夜那晚蓝羽说的规矩：雨里听不见喊声，离火之前先把绳结留在树上。今晚没人离火，可有人坐在了火圈外头。"
    nar "风从岩壁缝里钻进来，吹得火苗一歪。四个人的影子投在根棚上，叠在一起，分不出谁挨着谁。"
    think "点名是四个，可齐不齐，不光看人数。"

    # --- 节点 8/9 · 守夜安排（menu） ---
    menu:
        "后半夜的守夜怎么排？"

        "你守头一班，让其余人先睡":
            $ vn2_aff_add("lan", 2)
            nar "你把第一班揽到自己身上。蓝羽看了你一眼，没争，把地图压在你手边。"
            $ vn2_current_voice = "voice/lan/lan_0040.ogg"
            voice "voice/lan/lan_0040.ogg"
            lan "后半夜我叫你。火别压太死。"
            nar "你坐在火边，眼睛盯着洞口的方向。睡袋里的呼吸一个接一个变长。"

        "把白砚换到火圈里，你去洞口守":
            $ vn2_aff_add("bai", 3)
            nar "你走到洞口，把白砚从石头上换下来。他没推让，抱着药箱挪回火圈边的睡袋。"
            $ vn2_current_voice = "voice/bai/bai_0032.ogg"
            voice "voice/bai/bai_0032.ogg"
            bai "洞口风硬。你别坐太久。"
            nar "你在他刚才坐的石头上坐下，背对着火，替他盯着根棚外的黑。"

        "叫青岩一起排后半夜，两人轮一段":
            $ vn2_aff_add("qing", 2)
            nar "你喊青岩对守夜的班次。他把样本箱搁稳，过来跟你把后半夜分成两段，一人一段。"
            $ vn2_current_voice = "voice/qing/qing_0018.ogg"
            voice "voice/qing/qing_0018.ogg"
            qing "前半夜我先眯。后半夜我叫你。"
            nar "他说完，把箱侧皮套里的本子按了按，靠着树根闭上眼。"

    # --- 节点 9/9 · 帐外的位置 ---
    nar "天快亮的时候，林子里起了一层雾，贴着地皮走。火熄成灰，灰里还留着一点温。火圈边那份睡袋铺开着，旁边搁着包，位置一直留着。洞口的石头上，还留着一个坐过的压痕。夜里有人坐在那儿，坐了很久。蓝羽先醒，把地图折好塞进怀里。青岩起身把样本箱背好，箱扣扣紧。你回头看了一眼洞口。压痕还在，火圈里给他留的位置也还空着；那句断在半截的话，没人替他补完。"
    think "明天到了站牌底下，这笔账再算。人先带出去。"

    $ vn2_hide_all(trans=dissolve_soft)
    $ vn2_leave_chapter()
