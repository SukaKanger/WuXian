# 第 12 章 • 旧营地（第 12 天 / 共同线）
# 节点：1 背风处的帐篷 · 2 朽杆 · 3 杆子落下来（menu）· 4 坐下（saved_bai 甜点）
#       · 5 营地遗物 · 6 歇脚做什么（menu）· 7 离开前清点（menu）· 8 不留宿

label ch12:

    scene bg forest with slow_fade
    $ vn2_enter_chapter("ch12")
    call vn2_title_card(12, "旧营地", "第 12 天 • 共同线")
    $ vn2_amb("fire")

    if vn2_story_mode == "cut":
        jump ch12_cut

    $ vn2_show("bai", pos="center", trans=dissolve_soft, expr="sad")
    $ vn2_show("lan", pos="left", trans=dissolve_soft)

    # --- 节点 1/8 · 背风处的帐篷 ---
    nar "旧营地藏在林子背风处。帐篷还立着，帆布上全是霉斑。三只睡袋摊在地上，都是空的。营地四周的蕨叶长到了路中间。原先生火的石圈塌了一半，缝里钻出细草。"
    $ vn2_current_voice = "voice/lan/lan_0079.ogg"
    voice "voice/lan/lan_0079.ogg"
    lan "这个营地有人住过。走得很急。"
    nar "白砚蹲下去翻一只旧药箱，手指在箱沿上停了一下。"
    think "他的右手一直攥着，指节发白。"
    nar "帐篷绳松了两股，杆顶被风推得歪向一边。林子里很静，鸟叫都绕着这片走。地上落着几片干针叶，踩上去没有声音。空气里有一股潮木头和旧布混在一起的气味。林子到这里忽然稀了一截。树冠让出一片天，灰白色的云压得很低。来路的脚印在身后断了。昨夜一场雨把坡上的泥冲过一遍，踩出来的浅痕只剩最后两三步。蓝羽走在前头认路，到营地边上先停住，抬手让后面的人慢下来。"
    nar "青岩把样本箱换到胸前，护住箱扣。帐篷外晾着一排旧绳，绳头散着，早被雨水泡得发黑。这条背风沟在林图上没有记号。沟口被两层矮树挡着，不走到跟前看不见帐篷。空气里的霉味混着土腥气，吸进肺里发沉。青岩先闻了闻风向，把样本箱换到背风一侧。沟底积着一层落叶，踩上去发软，分不清底下是土还是根。"

    # --- 节点 2/8 · 朽杆 ---
    nar "头顶一根朽帐篷杆被风掀动，斜着往下滑。白砚伸手就去接——他那只旧伤的手，一直没好利索。杆身朽了一半，木纹顺着裂口翻开。压下来的势头不快，可接的人闪不开。蓝羽在营地另一侧，离杆两步远。青岩蹲在箱边，听见响动才抬头。"
    think "杆落下来之前，先伸手的总是他那只不利索的手。"
    nar "风从林隙里挤进来，帐篷杆吱呀响了一声，又一声。那根朽杆原本靠着横杆，两头的绳扣先后松脱。杆身顺着篷布的坡度往下滑，带起一层霉灰。你离白砚两步。伸手够到他手腕之前，杆子已经压到他抬手的高度。帐篷布让雨水泡得发胀，风一鼓，整顶篷往杆顶压。绳扣吃不住，一根接一根松。"

    # --- 节点 3/8 · 杆子落下来（menu） ---
    menu:
        "杆子落下来，你先做什么？"

        "抢在他前面接住杆子":
            $ vn2_aff_add("bai", 5)
            $ vn2_flag("saved_bai")
            nar "你横身过去，双手接住杆子，扛到肩上。木头压得肩膀一沉。白砚的手停在半空，收回去的时候很慢。"
            $ vn2_current_voice = "voice/bai/bai_0051.ogg"
            voice "voice/bai/bai_0051.ogg"
            bai "……谢了。这只手再折一次，就握不住针了。"
            nar "杆身的碎木渣落在你袖口。你把杆子斜靠到树边，木头上的裂口朝着自己，没对着人。木头上的潮气顺着袖口渗进来。你把杆子抵在树干上，等卸力卸完才松手，肩背一直绷着。"

        "按住他的手腕，不让他伸手":
            $ vn2_aff_add("bai", 4)
            nar "你攥住他的手腕，把他的手按回身侧。杆子被蓝羽接住。"
            $ vn2_current_voice = "voice/bai/bai_0052.ogg"
            voice "voice/bai/bai_0052.ogg"
            bai "我自己有数。"
            nar "他嘴上这么说，手腕却没挣开。蓝羽把杆子放平，拖到营地边上。风又推了一下杆顶，被他一脚顶住。他腕骨硌在你掌心里，筋绷着。蓝羽接住杆子的闷响从侧面传过来，风把霉灰吹散。"

        "喊青岩一起把杆子卸下来":
            $ vn2_aff_add("qing", 4)
            nar "你喊一声。青岩从侧面托住杆梢，两人合力把杆子放平。"
            $ vn2_current_voice = "voice/qing/qing_0043.ogg"
            voice "voice/qing/qing_0043.ogg"
            qing "朽了。再挂一晚，风一吹就倒。"
            nar "他把杆子拖出营地，免得再砸到人。拖的时候他顺带扫了一眼帐篷绳，把松脱的两股重新绕回杆顶。两个人托着杆梢往下放，朽木屑簌簌落进领口里。杆身落地时闷响一声，震得脚下地皮轻颤。"

    # --- 节点 4/8 · 坐下 ---
    nar "营地清出来一块平地。白砚坐在睡袋上，把右手摊开看了看。"

    if store.saved_bai:
        nar "他闭眼前扶了一下旧木箱沿。再睁开时，目光先没看自己的手。"
        $ vn2_current_voice = "voice/bai/bai_0053.ogg"
        voice "voice/bai/bai_0053.ogg"
        bai "你的胳膊。刚才接杆那一下，旧伤有没有再扯着？"
        nar "他问得很慢，声音还有点哑。说完才把自己那只手翻过来，看掌根的疤。你把他的袖子推上去一点，看腕上有没有压出红印。他没躲，由着你看，另一只手把药布递过来。"
        $ vn2_current_voice = "voice/bai/bai_0054.ogg"
        voice "voice/bai/bai_0054.ogg"
        bai "我这只老毛病。阴天僵，平时能用。你的别硬撑。"
        nar "他把药布塞到你手里，自己先靠着箱子喘匀了气。这一回换他坐着不动，让你替他把箱角松了的带子系紧。"
    else:
        nar "他低头看自己的右手，活动了两下手指，皮发紧，没出声。他把右手翻来覆去看了两遍，又握了握拳，指节响了一声。"

    nar "你在他旁边坐下。风从帐篷缝里钻进来，吹得霉斑的气味淡了一点。火堆没敢生大的。只拢了一小堆细柴，火光照得见眼前一圈，其余仍在林子里的暗里。"

    # --- 节点 5/8 · 营地遗物 ---
    nar "营地一角堆着旧炊具，锅沿锈穿了。三只睡袋的拉链坏了两只，塞着干苔藓。地上散着几只空瓶，标签泡烂。青岩一只只捡起来，对着光看瓶壁。"
    think "住这儿的人撤得快，能带走的药都带走了。"
    nar "蓝羽绕帐篷走了一圈，把松动的绳扣按了按，没进帐篷里面。木箱底下压着一块折过的油布，布角用石头压住。他掀开看了一眼，又原样盖回去，没动里面。旧铺位按脚印排过，三个人的位置，铺位中间隔着等距的空当。炊具旁边搁着一只缺口陶碗，碗底扣着，碗沿磨出一圈亮。空瓶有六只，大小不一。两只塞着旧布塞，其余敞着口，瓶壁上挂着干透的水痕。"
    nar "蓝羽在帐篷后找到一截断绳，绳头割口整齐，像被刀齐着割断。他看了一眼，没拾。"
    think "撤得急，连刀割绳都顾不上留完整的一截。"
    nar "睡袋里的干苔结成块，一捏就碎。袋底压着几片褪色的布片，辨不出原来的颜色。石圈边上堆着烧尽的柴灰，灰里插着半截没烧完的火绒，已经受潮点不着。旧铺位边上各压着一块平石，石头磨得发亮，是当年坐人的位置。"

    # --- 节点 6/8 · 歇脚做什么（menu） ---
    menu:
        "歇脚的时候，做什么？"

        "替他检查手上的旧伤":
            $ vn2_aff_add("bai", 4)
            nar "他把手伸过来。旧伤在掌根，一道长疤，皮肉发紧。"
            $ vn2_current_voice = "voice/bai/bai_0055.ogg"
            voice "voice/bai/bai_0055.ogg"
            bai "不碍事。阴天会僵，平时能用。"
            nar "你替他把药布重新缠了一圈，他没躲。药布缠到腕骨，他把手翻过来，指了指内侧一处发硬的皮，说那是早年针戳的旧点。药布是从旧营地捡的那卷，干透了，缠上之前先在指间揉软。他的掌心比常人凉，指腹有练针磨出的薄茧。他指尖在你手腕上停了停，像在量脉，又松开。药布收尾打了个活扣，一拉就开。"

        "翻旧营地留下的空药瓶":
            $ vn2_aff_add("qing", 4)
            nar "地上几只空瓶，标签泡烂了。青岩一只只捡起来，对着光看。"
            $ vn2_current_voice = "voice/qing/qing_0044.ogg"
            voice "voice/qing/qing_0044.ogg"
            qing "瓶型不一样。住这儿的不止一批人。"
            nar "他把能辨认的收进样本袋，其余放回原处。瓶底沉着一点白霜似的痕迹，他用指甲刮了点下来，封进小纸包，记上营地位置。纸包封好，他在外面写了编号，字很小，紧贴封口。本子翻到那一页，和信标方位记在相邻两栏。他把瓶型按高矮排开，比划了一下容量，记进本子。瓶身上没有一处能辨认的字迹。"

        "守在营地外，让他一个人待一会儿":
            $ vn2_aff_add("bai", 3)
            nar "你走到营地边上，背对着帐篷。里面很久没有声音。出来的时候，白砚把药箱扣好了，脸上看不出什么。"
            $ vn2_current_voice = "voice/bai/bai_0056.ogg"
            voice "voice/bai/bai_0056.ogg"
            bai "走吧。这儿不留宿。"
            nar "你在坡上等了他一刻。他跟上来，脚步比进去时慢半拍，背挺得直。林子里的鸟停在斜枝上，叫了两声又飞走。你数着步数，从营地边到坡沿，一共三十多步。营地内偶尔碰响一只瓶，声音闷闷的。你没回头，把脚步声压在草叶上。"

    # --- 节点 7/8 · 离开前清点（menu） ---
    menu:
        "离开前，怎么处理营地遗留？"

        "把能用的旧药布收进药箱":
            $ vn2_aff_add("bai", 3)
            nar "睡袋缝里夹着两卷旧药布，干透了。你捡出来抖掉草屑，叠好放进药箱侧袋。"
            $ vn2_current_voice = "voice/bai/bai_0057.ogg"
            voice "voice/bai/bai_0057.ogg"
            bai "洗过晒过就能用。路上卷布比卷纸省。"
            nar "他接过箱子掂了掂，把最上面那只瓶往里推了推，扣上箱扣。旧药布上还沾着一点草屑，抖不干净。白砚说回去拿火烤一烤，潮气散了就能缠。侧袋里的瓶子已经排满，旧药布卷塞进最窄的那条缝，卡住不晃。"

        "帮青岩把空瓶留作样本":
            $ vn2_aff_add("qing", 3)
            nar "你替他捧着样本袋，他挑出三只瓶型不同的空瓶，塞进袋底，中间用干苔隔开。"
            $ vn2_current_voice = "voice/qing/qing_0045.ogg"
            voice "voice/qing/qing_0045.ogg"
            qing "瓶子不能碰碎。回程比来路晃。"
            nar "他把袋口系成活扣，拎起来试了试重量，又换到靠里那只手上。干苔垫在瓶与瓶之间，晃不响。他拎着袋子走了两步，又停下把袋口再系紧一圈。样本袋压在箱底，上面盖着干苔。他拍了拍箱盖，确认袋口没松。"

        "在营地外留个方向记号":
            $ vn2_aff_add("lan", 3)
            nar "你在岔口树干上打了个活扣，结眼里塞一小段干苔。"
            $ vn2_current_voice = "voice/lan/lan_0080.ogg"
            voice "voice/lan/lan_0080.ogg"
            lan "记号留浅一点。后来的人能认，找站的人也顺这条线。"
            nar "他看完结，伸手把翘起来的绳头压进结底，没让它往外翘。活扣打完，他扯了扯绳头试松紧，结眼里的干苔没掉。记号留在岔口，不凑近看不大显眼。蓝羽把树干上的记号又看了一遍，确认两个方向都看得见，才跟上队伍。"

    # --- 节点 8/8 · 不留宿 ---
    zhou "把能用的带走，别碰帐篷里的旧东西。"

    nar "旧营地留在身后。地上的睡袋空着，像几页没人读完的旧纸。出了林子背风处，四个人重新排上路。白砚走在中间，右手垂在身侧，活动幅度比早上大了一点。走出营地半里，回头已经看不见帐篷。雾把那片背风处整个罩住，只留林子连成一片的绿。四个人前后排开，间隔一臂。蓝羽在前，白砚在中间，青岩押后，你走在侧后照看全队。林子里的滴水声又起来了。白天的路还长，脚下的泥一步一滑。"
    nar "沟口的矮树在身后合拢，把旧营地遮回林子里。再往前，树冠慢慢稀疏，露出前面的坡脊。队伍拉开的距离拉回一臂，脚步声前后接上。身后的帐篷被雾气包住，霉斑和旧布的气味一点点淡下去，只剩林子里潮湿的土味。"

    $ vn2_hide_all(trans=dissolve_soft)
    $ vn2_leave_chapter()
