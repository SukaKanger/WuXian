# 第 4 章 • 夜哨（第 4 天 / 共同线）
# 节点：1 火边第一班哨 · 2 上一任队长 · 3 拎水囊的人 · 4 守夜分工
#       · 5 班次怎么落（menu · C 批营地容器）· 6 旧事怎么接（menu）
#       · 7 后半夜换班 · 8 哨位上的靠近（menu）· 9 炭光下的记号（menu）· 10 天亮前

label ch04:
    $ vn2_unlock_cg("cg_key_four_people_v0")

    scene bg firelight with slow_fade
    $ vn2_enter_chapter("ch04")
    call vn2_title_card(4, "夜哨", "第 4 天 • 共同线")
    $ vn2_amb("fire")

    $ vn2_show("lan", pos="left", trans=dissolve_soft)
    $ vn2_cg_show("images/cg/cg_key_four_people_v0.png", trans=dissolve_soft)

    # --- 节点 1/9 · 火边第一班哨 ---
    nar "火压得低。头一班守夜，你和蓝羽。"
    nar "雨是傍晚停的，林子里还在滴水，一滴一滴打在落叶上，隔很久才响一声。"
    nar "白天走的那段坡，泥里全是脚印，踩进去拔出来，鞋底带出一股腐叶味。四个人的裤脚都湿到小腿，贴在皮肤上发凉。"
    nar "四个人的睡袋在树根边排开。白砚靠着药箱先合上眼，青岩把样本箱搁在腿边，尾巴压在箱盖上。"
    nar "你的左臂还吊着布带，挂在胸前。抬肩就扯着疼，你把右手压在膝上，焐着。"
    nar "火只剩一臂高的炭，红光贴着地皮走，走到鞋尖就停住。"
    nar "背包搁在树根边，绳、火绒、药瓶各在各的格。你伸手把松动的箱扣按紧。"
    nar "水囊挂在树枝上，离地一掌，免得夜里蹭到泥。"
    nar "火绒用布包着，压在背包最里层。绳盘在腰上，两段，一段死结一段活扣，白天刚练过。"
    nar "营地选在两棵老树中间，背风。树根把泥扎住，不至于夜里塌下去。头顶的枝桠交在一起，雨再落下来也先被叶子接住。"
    nar "你的鞋脱在火边，泥糊在鞋帮上，干了一层。脚指头蜷了蜷，还麻着。"
    nar "前两晚扎营的潮气没全散，火绒就得慢，这堆火起来得也不容易，火苗一直压不高。"
    nar "有人靴帮没干透，搁在火边烤着，袜底还是潮的。睡着的人里有谁压着嗓子咳了一声，翻个身又静下去。"
    nar "白天走过的路在身后缩成一条黑线，看不清哪儿是哪儿。"
    think "四天下来，东西一样一样在变少。人还齐。"

    # --- 节点 2/9 · 上一任队长 ---
    $ vn2_current_voice = "voice/lan/lan_0019.ogg"
    voice "voice/lan/lan_0019.ogg"
    lan "上一任队长，也在这片林子里。"
    nar "他把一根树枝丢进火里。火苗塌了一下，又立起来。"
    $ vn2_current_voice = "voice/lan/lan_0020.ogg"
    voice "voice/lan/lan_0020.ogg"
    lan "他带六个人进来。出去四个。"
    nar "他说这话的时候看着火，没看你。火光把他半边脸照亮，另外半边沉在暗里。"
    nar "树枝烧断，炭里爆出一小片火星，落进灰里就灭了。"
    nar "你顺着他的视线往林子深处看。黑是一层叠一层的，树影后面还是树影，看不见尽头。"
    nar "他用脚尖把火堆边一块松动的炭踢回火里，动作很熟，像守过很多个这样的夜。"
    nar "上一任队长的事，他只说过这几句。队里谁带的路，谁断的后，他都没提。"
    nar "他把袖口往下扯了扯，盖住手腕，像那里有什么不想让火光照见。"
    think "六个人进来，四个出去。差的那两个，留在了哪一层黑里。"

    # --- 节点 3/9 · 拎水囊的人 ---
    $ vn2_show("qing", pos="right", trans=dissolve_soft)

    nar "暗处传来一声轻响。青岩拎着水囊从树影里走出来。"
    $ vn2_current_voice = "voice/qing/qing_0011.ogg"
    voice "voice/qing/qing_0011.ogg"
    qing "那两个不是死。是没找到。"
    $ vn2_current_voice = "voice/lan/lan_0021.ogg"
    voice "voice/lan/lan_0021.ogg"
    lan "……一样。"
    nar "青岩把水囊搁在两人中间的石头上，没坐下。他低头看了一眼火，又看了一眼睡着的白砚。"
    $ vn2_current_voice = "voice/qing/qing_0012.ogg"
    voice "voice/qing/qing_0012.ogg"
    qing "找到找不到，先把人凑齐。散在林子里，喊是喊不回来的。"
    nar "他说完，退回树根边，把样本箱往怀里收了收。箱扣上沾着白天的泥，他用拇指抹了一圈。"
    nar "水囊在石头上滚了半圈，谁也没先拿。火光在囊皮上晃。"
    nar "青岩守夜有个习惯，不坐死位置。隔一阵换个树根站一站，眼睛把营地四周扫一圈。"
    think "他还有话没说完。"

    # --- 节点 4/9 · 守夜分工 ---
    nar "你把守夜的顺序在心里排了一遍。头一班你和蓝羽，后半夜白砚顶，青岩睡到天快亮再接一段。"
    zhou "夜里谁也别单独离火。要走动，喊一声。"
    $ vn2_current_voice = "voice/lan/lan_0022.ogg"
    voice "voice/lan/lan_0022.ogg"
    lan "雨里听不见喊声。离火之前，先把绳结留在树上。"
    nar "他说这句的时候，手按在腰上那两段绳上。"
    nar "白砚在睡袋里翻了个身，药箱没离手。青岩闭着眼，尾巴尖搭在箱盖缝上。"
    nar "你把火拨小一圈。夜里火不能太旺，旺了耗柴，也把人影投到林子里，招东西。"
    nar "柴堆在树根另一侧，只留够后半夜添的量。再多，明早就没得烧。"
    nar "你把绳、水囊、药瓶在背包里各归各位，又检查了一遍箱扣。东西放熟了，黑里摸得到。"
    think "规矩是旧队留下的。他没说哪条是教训，哪条是习惯。"

    # --- 节点 5/10 · 班次怎么落（menu · C 批营地容器） ---
    nar "三个人都累了一整天。裤脚还潮着，鞋帮上的泥半干半湿，谁先睡、谁后睡，差的就是这一两个钟头。"
    nar "白砚靠着药箱，右手腕搁在膝上，指节时不时蜷一下，像是还没松开白天的劲。青岩在队尾走了一路，尾巴压在箱盖上，眼皮已经抬不起来。蓝羽头一班还撑着，眼睛盯着林子黑处。"
    nar "你的左臂吊在胸前，抬肩就扯着疼，右手压在膝上焐着。守夜轮到你，能使力的只有这一只手。"
    nar "柴只留够后半夜添的量，多一根，明早就没得烧。水囊里的水按口数过，夜里谁起来喝，都得省着。火边这点地方，谁坐哪一班，得排明白。"
    nar "白天那段坡谁都没少受累。白砚的药箱一路抱在怀里，青岩的箱子压在队尾，蓝羽在前头探路，眼睛没敢离开过两边的黑。"
    nar "你把三班的次序在灰上又划了一遍。头班、中班、尾班，一段压一段。睡下去的人能歇几个钟头，全看这道次序怎么排；谁少睡一段，夜里看得见。"
    think "班次怎么排，不省事的那个人今晚先扛。"

    menu:
        "三班的次序，怎么落？"

        "照旧三班，一人一段":
            nar "班次按原先排定的走。头班你和蓝羽，中班白砚，尾班青岩。"
            nar "青岩听见自己排在最后一段，没争，只把样本箱往怀里收了收，确认箱扣扣死，才蜷进睡袋里先眯着。"
            nar "尾班要守到天快亮。前半夜他睡得浅，隔一阵就睁眼听一下外头的声。后半夜轮到他的时候，他坐在树根边，头一点一点的，眼睛睁开一下又合上。"
            nar "添柴的手慢半拍。一根枝拨进火里，搁了一会儿才想起来再压一根；火矮下去一截，他才发觉，伸脚把炭往中间拢了拢。"
            nar "尾巴从箱盖缝上垂下来，搭在脚边，没再动。他撑着没躺下去，可那一段哨，全靠硬撑。天快亮那阵，他坐着打了个盹，惊醒过来先看一眼箱子，箱扣还在原位。"
            nar "这一段缺的觉，今夜没有别处补。他揉了揉脸，把尾巴重新压回箱盖上，接着盯林子黑处。"

        "把白砚的后半夜拆两段，你替他顶一段":
            $ vn2_aff_add("bai", 2)
            $ vn2_hide("qing")
            $ vn2_show("bai", pos="center")
            nar "你跟白砚换了个排法。他的后半夜拆成两段，中间一段你替他守，让他多睡一个整觉。"
            $ vn2_current_voice = "voice/bai/bai_0018.ogg"
            voice "voice/bai/bai_0018.ogg"
            bai "……你那只胳膊，别硬撑。"
            nar "他没多推让，抱着药箱蜷进睡袋，呼吸比先前匀得快。药箱压在身侧，箱扣留着一线，他睡梦里手还搭在边上。"
            nar "轮到他接手的时候，手腕转过来顺了些，指节没再发僵。他先看了一眼你吊着的左臂，才在火边坐下。"
            nar "你顶的那一段，困意一阵一阵往上涌。你靠着树根坐直，眼睛盯着林子黑处，没躺下。添柴的动作放慢，怕出声吵醒刚睡沉的人。"

        "陪蓝羽坐完头一班，再去睡":
            $ vn2_aff_add("lan", 2)
            $ vn2_hide("qing")
            $ vn2_show("lan", pos="center")
            nar "头一班你不轮换，陪着蓝羽坐到有人来接。他看了你一眼，往旁边让了半寸，给你腾出火边的位置。"
            $ vn2_current_voice = "voice/lan/lan_0023.ogg"
            voice "voice/lan/lan_0023.ogg"
            lan "坐着别说话。眼睛扫四周，隔一阵换一个方向。"
            nar "你接过他递来的一根干枝，添进火里。火苗塌了一下，又立起来。他腰上那两段绳盘得整齐，绳头压在包带底下。"
            nar "两个人并排坐着，谁都没再开口。林子里有什么踩过枯枝，响一声就没了，他尾巴尖朝那边动了一下，没起身。水滴从叶尖落下来，隔很久才断一回。"
            nar "他把火边塌下去的炭拨了拨，动作很慢。火光把两个人的影子叠在一处，投到树根上，分不出谁挨着谁。"
            nar "后半夜换班的脚步声过来之前，你就这么陪着他坐完了头一段。"

    nar "班次排定，睡袋里的人一个接一个合上眼。火压成暗红的炭，谁守哪一段，黑里都摸得到位置。"
    nar "少睡的那个人，夜里坐得住坐不住，火边看得见。添柴快慢、头点不点，都瞒不过守下一班的人。"
    nar "火边的呼吸一个接一个变长。轮到谁的班，谁就把困意压下去，坐到炭火暗下去之前。"

    # --- 节点 6/10 · 旧事怎么接（menu） ---
    menu:
        "旧事怎么接？"

        "让蓝羽把那两个人说完":
            $ vn2_aff_add("lan", 4)
            $ vn2_hide("qing")
            $ vn2_show("lan", pos="center")
            $ vn2_current_voice = "voice/lan/lan_0024.ogg"
            voice "voice/lan/lan_0024.ogg"
            lan "一个姓陈。一个没名字，队里都叫他小七。"
            nar "他说完就把脸转向火，不再看你。"
            $ vn2_current_voice = "voice/lan/lan_0025.ogg"
            voice "voice/lan/lan_0025.ogg"
            lan "也是一场这样的雨。队里散开找人，再没凑齐。"
            think "雨里不能散开。这句你记下了。"
            nar "他伸手把火里塌下去的炭拨了拨，动作很慢，像怕惊动灰底下的什么。"
            nar "姓陈的那个，他说以前在队里管绳。没名字的那个最小，背包上挂着个铁盒，夜里响。"
            $ vn2_current_voice = "voice/lan/lan_0026.ogg"
            voice "voice/lan/lan_0026.ogg"
            lan "铁盒后来在半坡找到。人不在。"
            nar "他停在这里，不再往下说。火里又塌了一块炭。"

        "劝他先歇，后半夜再讲":
            $ vn2_aff_add("lan", 3)
            nar "你把自己的外套往他那边推了推。他看了你一眼，把后半句咽回去。"
            $ vn2_current_voice = "voice/lan/lan_0027.ogg"
            voice "voice/lan/lan_0027.ogg"
            lan "……行。后半夜还有得讲。"
            nar "他把外套接住，没往身上披，搭在两人中间的石头上，挡风。"
            nar "他把话头收住，目光落回火堆边，指尖在外套边上压了一下，没再往下说。"
            nar "他靠着树根，把外套往身上裹了裹。火光照不到的那只手，一直按在腰侧。"

        "叫白砚来顶哨，你先去睡":
            $ vn2_aff_add("bai", 3)
            $ vn2_hide("qing")
            $ vn2_show("bai", pos="center")
            nar "后半夜，白砚提着药箱来换班。看见你还坐着，他愣了一下。"
            $ vn2_current_voice = "voice/bai/bai_0019.ogg"
            voice "voice/bai/bai_0019.ogg"
            bai "去睡。两个人轮，比一个人硬撑强。"
            nar "他在你原来的位置坐下，药箱搁在脚边，手搭在箱扣上。"
            $ vn2_current_voice = "voice/bai/bai_0020.ogg"
            voice "voice/bai/bai_0020.ogg"
            bai "你那只胳膊今晚不许再用力。药布我睡前看过，没渗。"

    # --- 节点 7/10 · 后半夜换班 ---
    $ vn2_hide_all(trans=dissolve_soft)

    nar "火只剩一点红。林子里的潮气往衣领里钻。"
    nar "换班的脚步声踩着湿泥过来。白砚坐到火边，把药箱放在两人中间，先看了一眼你吊着的左臂。"
    $ vn2_current_voice = "voice/bai/bai_0021.ogg"
    voice "voice/bai/bai_0021.ogg"
    bai "布带没松。夜里别压着它睡。"
    nar "你点头。他没再问，把袖口往上挽了挽，露出右手腕。"
    nar "他的右手在膝上握了一下，又松开。指节发僵，活动的时候，手腕那里有一声很轻的响。"
    nar "青岩在树根边翻了个身，睡袋窸窣响了一阵，又静下去。蓝羽靠在另一棵树上，眼睛半闭，尾巴收在腿边。"
    nar "林子的声音换了一轮。虫声稀了，水滴声重起来，远处有什么踩过枯枝，响一下就没了。"
    nar "后半夜的风从树缝里穿过来，贴着地面走。你把外套领子拢了拢，没起身。"
    nar "白砚坐得很直。他守夜的时候不靠着东西，说靠着容易睡过去。药箱在两人中间，他的手离箱扣不到一拳。"
    nar "你就着炭光把背包里的东西又归置一遍：绳盘紧，火绒包好，药瓶排齐。黑里摸得到，才不至于慌。"
    nar "白砚的药箱搁在两人中间，箱扣没扣死，留着一线，他夜里伸手就能够到。"
    think "守夜的人眼睛不能离开营地四周。东西归置好，心才定。"

    # --- 节点 8/10 · 哨位上的靠近（menu） ---
    menu:
        "后半夜的哨位上，先做什么？"

        "按住白砚发僵的手腕，替他揉开":
            $ vn2_aff_add("bai", 3)
            nar "你伸手过去，在他缩手之前先握住了他的手腕。"
            nar "脉搏在拇指底下跳，一下一下。他的手凉，指节僵着，掌根那一处皮肉发紧。"
            nar "你用指腹按着那处僵的地方，慢慢揉。他的手在你掌心里停了一下，没有抽回去。"
            nar "揉到第三下，他把手翻过来，掌心朝上，让你按腕骨旁边那道硬筋。"
            nar "他一直没说话。火光照着他的侧脸，他先看了一眼你吊着的左臂，又看回自己被你握着的手腕。"
            nar "等你揉开那处硬筋，他才慢慢把手指松开，指节不再绷着。"
            nar "你松开之后，他抬手把你左臂的布带重新掖紧，掖到肩窝不磨皮的位置，动作很稳。"
            $ vn2_current_voice = "voice/bai/bai_0022.ogg"
            voice "voice/bai/bai_0022.ogg"
            bai "手我自己有数。你的胳膊别再用力。"
            nar "他说完才把手收回去，重新搭在药箱扣上，像刚才那一会儿只是火边的错觉。"
            nar "树边的蓝羽眼睛半闭着，尾巴尖朝这边动了一下，没睁眼。"

        "跟蓝羽把散队的方位对一遍":
            $ vn2_aff_add("lan", 2)
            $ vn2_show("lan", pos="left")
            nar "你把蓝羽叫醒半分。他摊开地图，就着炭光，指尖压在旧队出事的那一带。"
            $ vn2_current_voice = "voice/lan/lan_0028.ogg"
            voice "voice/lan/lan_0028.ogg"
            lan "这一片。图上擦过，路也塌了。"
            nar "他用绳头在图角点了三个位置，点完把绳绕回自己腕上。"
            $ vn2_current_voice = "voice/lan/lan_0029.ogg"
            voice "voice/lan/lan_0029.ogg"
            lan "记着方位。真散了，往高处找。"
            nar "你借着炭光，把那三个位置在心里过了一遍。图角起毛的地方，他用指甲压出一道浅印。"
            nar "他指点方位的时候，绳头从指间垂下来，扫过图边。收绳的时候，他把绳绕得比平时紧半圈。"

        "把干外套盖到睡袋上，替睡着的人挡风":
            $ vn2_aff_add("qing", 2)
            $ vn2_show("qing", pos="right")
            nar "你起身，先把青岩脚边的样本箱角掖好，再把干外套搭在睡袋外侧，挡住从树缝里钻进来的风。"
            nar "青岩没醒，尾巴从箱盖底下挪出来，搭到外套边上。"
            nar "你顺手把背包侧袋的绳结收紧，把露在外面的角折进去，压到最干燥的夹层。"
            $ vn2_current_voice = "voice/qing/qing_0013.ogg"
            voice "voice/qing/qing_0013.ogg"
            qing "……嗯。"
            nar "他含糊应了一声，不知道醒着没有。"
            nar "外套搭好，风被挡在外头一层。睡袋里的人缩了缩，尾巴不再露在外面。"

    # --- 节点 9/10 · 炭光下的记号（menu） ---
    menu:
        "剩下的前半夜，怎么过？"

        "把他说的位置记进地图边角":
            $ vn2_aff_add("lan", 3)
            $ vn2_show("lan", pos="left")
            nar "你借着炭光，在地图边角点了一个小记号。蓝羽看着，没拦。"
            $ vn2_current_voice = "voice/lan/lan_0030.ogg"
            voice "voice/lan/lan_0030.ogg"
            lan "别圈出来。先点着就行。"
            nar "铅笔头短，画出来的点很小，落在图上那片空白里。"

        "把干外套留给蓝羽":
            $ vn2_aff_add("lan", 3)
            $ vn2_show("lan", pos="center")
            nar "外套搁在他肩上。他没说谢，尾巴尖朝你这边摆了摆。"
            nar "夜露又下来一层，外套领子已经潮了，他还是披着。"

        "什么都不问，守到有人来换班":
            $ vn2_aff_add("bai", 3)
            $ vn2_show("bai", pos="right")
            nar "换班的脚步声踩着湿泥过来。白砚接过哨位，你起身时胳膊发僵。"
            $ vn2_current_voice = "voice/bai/bai_0023.ogg"
            voice "voice/bai/bai_0023.ogg"
            bai "左胳膊抬不起来就直说。别瞒。"
            nar "他坐下之前，把你那只发僵的右手看了一眼，没再多说。"

    # --- 节点 10/10 · 天亮前 ---
    nar "夜最深的时候，火压成一层暗红的炭。"
    nar "你靠着树根眯了一阵，没睡实。听见谁在火边添了一根枝，听见水囊被人拎起来又放下。"
    nar "白砚的右手搁在药箱上，一动不动。蓝羽的呼吸变长了，青岩的尾巴从外套边上垂下来。"
    nar "背包压在树根边，箱扣扣紧。夜里没人去翻它，东西各在各位。"
    nar "远处林子深处，有一声很闷的响，像石头滑坡。四个人谁都没醒，火边的位置没动。"
    nar "你把夜里听见的声音在心里排了一遍：水滴、枯枝、风、远处那声闷响。没有喊声，没有人踩出第二串脚印。"
    nar "白砚的呼吸匀了。他守完自己那段，才允许自己合眼。青岩的睡袋被风掀起一角，又落回去。"
    nar "火边四个人的影子叠在一处，分不出谁挨着谁。后半夜没人换过位置。"
    think "明天还有路。人齐，比什么都要紧。"
    nar "天蒙蒙亮的时候，雾从谷底漫上来，贴着地皮走。灰里还留着一点温。"
    nar "天亮前，火熄成灰。"

    $ vn2_hide_all(trans=dissolve_soft)
    $ vn2_leave_chapter()
