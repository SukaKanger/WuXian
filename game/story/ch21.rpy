# 第 21 章 • 站门外（第 21 天 / 白砚线）
# 节点：1 站门外的等待 · 2 门外缠绷带（menu · 活扣第三次）
#       · 3 进门 / 不进 / 让他留在门外（menu）
#       · 4 药箱清点（C 批容器 · menu：三份平均留 / 全压一人 / 记账抄余量）
#       · 5 讲减药的原因（中刀两步：吃全份手会慢 → 以前有人倒下，我慢过一回）
#       · 6 替他要一份 / 把份额给他 / 什么都不说（menu）
#       · 7 门锁与钥匙交接 · 8 雾里过渡 · 9 门开一条缝（接 ch25）

label ch21:
    $ vn2_unlock_cg("cg_route_bai_ward_v0")
    scene bg gate with slow_fade
    $ vn2_enter_chapter("ch21")
    call vn2_title_card(3, "站门外", "第 21 天 • 白砚线")
    $ vn2_amb("forest")

    $ vn2_show("bai", pos="center", trans=dissolve_soft)
    $ vn2_cg_show("images/cg/cg_route_bai_ward_v0.png", trans=dissolve_soft)

    # --- 节点 1/9 · 站门外的等待 ---
    nar "铁丝网后面，就是那座站。墙皮发黑，编号刷了三遍，新漆压着旧漆，数字的边还洇着。门在正中间。锁是新的，锁孔里有油，擦得很勤。门框上方的雨槽堵了，水顺着墙往下淌，在脚边汇成一小片。围栏上挂着一截断绳，风一吹就晃，撞在铁丝上，声音很轻。站的屋顶塌了一角，露出里面的梁，梁上挂着发黑的布片。围栏外的林子黑成一片，树影叠着树影，看不见边。风吹过来，带着湿土和枯叶的味。"
    nar "门楣上的漆剥了大半，露出底下的木头，木纹里积着雨水。墙根的草被踩倒过一片，又长回来，方向对着正门。风一过，铁丝网轻轻响一声，又静下去。站墙根的积水映着铁丝网的影子，逐格，风一吹就碎。门楣上方的雨槽堵着枯叶，水溢出来，顺着墙皮往下淌出一道深色印子。围栏外侧的草长得高，齐到膝头。"

    if store.bai_treated:
        nar "昨晚那台手术耗了他一夜，他右手还僵着，贴在箱带上。"
    else:
        nar "他站得离门半步远，手始终压在药箱上。"

    if store.station_key:
        nar "守门人给的钥匙在你口袋里，凉的，坠着衣料。"
    else:
        nar "身上没有钥匙。锁孔是新的，硬撬会留响。"

    think "门后面是什么，他没说过。"
    nar "风从林子那边绕过来，先吹铁丝网，再吹到脸上，带着夜里剩的那点凉。你把外套领口拢了拢，他站在半步外，药箱压在腿侧，没先开口。"

    # --- 节点 2/9 · 门外缠绷带 ---
    nar "门前有一级石台，被雨泡得发暗。他坐下来，把药箱搁在脚边，解开腕上旧绷带重缠。你蹲到他旁边。他手上那道昨晚没好利索的口子，边缘已经收口，绕着一圈暗红。他缠绷带的动作很慢，绕一圈，扯一下，再绕一圈。皮绳似的，不说话。绷带是昨晚拆下来的那条，洗过一遍，布边起了毛，还能用。雾从铁丝网外面漫过来，贴地。站里没有一点人声，只有水顺着墙根滴。"
    nar "石台被前人坐得发亮，边角磨圆了。脚边的积水里映着头灯一点光，晃了晃。石台上留着前人坐出的浅痕，旁边石缝里塞着半截烧剩的蜡头。门口的泥地里有半个脚印，旧的，被雨泡得发浅。石台旁边的泥地被人踩出一个浅窝，深浅正好坐下两个人。药箱搁在脚边，箱扣半开，露出里面码齐的瓶管。他低头解绷带的时候，睫毛压着影，没看你。指节在布边上停了一下，才绕第一圈。"
    think "他手上的旧伤不是一晚落下的。天冷、受潮、手上不停，三样凑在一起，就这样了。"
    $ vn2_current_voice = "voice/bai/bai_0102.ogg"
    voice "voice/bai/bai_0102.ogg"
    bai "昨晚那针，你手腕还疼？"
    zhou "不碰不疼。"
    $ vn2_current_voice = "voice/bai/bai_0103.ogg"
    voice "voice/bai/bai_0103.ogg"
    bai "夜里要是发麻，喊我。"
    think "他问得不像关心，像查房。可他绷带缠到你这只手边上，停了一下。"

    menu:
        "门外这道绷带，怎么换？"

        "替他解开，重新缠一遍":
            $ vn2_aff_add("bai", 3)
            nar "你接过绷带，解开旧结。他腕上的口子比昨晚收得好，周围一圈肿在退。你绕圈、扯紧、打结，动作照他教的来。"
            $ vn2_current_voice = "voice/bai/bai_0104.ogg"
            voice "voice/bai/bai_0104.ogg"
            bai "结打内侧。打外侧，蹭箱子。"

            # --- 甜点 · 活扣（共同线习惯第三次出现，ch13 回声） ---
            nar "收口你照旧打了个活扣。他低头看了看自己的手，指腹在活扣的位置按了一下，确认一拉就松。第十三夜在火边也是这样几圈缠，他说活扣好，一拉就开。这回他没接那句话，只把袖口往下拉了拉，盖住发硬的旧处。你绕最后一圈的时候，他腕子微微绷了一下，没抽回去。雾贴着石台走，两个人的影子并在一道，离得不远。"
            think "他腕子留在你手边，指节在布边上停了一下，才松开。"

        "只递药布，不插手":
            nar "你把药布和胶布递过去，退后半步。他自己缠，绕一圈停一下，检查松紧。"
            think "他的手还僵，缠得慢，但没让人帮。"

        "先看旧伤，再缠新绷带":
            $ vn2_aff_add("bai", 2)
            nar "你先托起他右手，看腕骨上方那片发硬的皮肉。他想抽回去，停了一下，没抽。"
            $ vn2_current_voice = "voice/bai/bai_0105.ogg"
            voice "voice/bai/bai_0105.ogg"
            bai "旧伤。天冷就这样，不碍事。"

    # --- 节点 3/9 · 进门（menu） ---
    nar "他缠完自己的手，站起来，看你。"

    menu:
        "站门外，先迈哪一步？"

        "进门，先贴住门缝听动静":
            $ vn2_aff_add("bai", 3)
            nar "你俯下去，耳朵贴近门缝。里面没有脚步，只有水管一滴一滴往下掉，滴在水泥地上，回声很长。门缝里透出来的气是凉的，混着水泥和旧灰味。"
            $ vn2_current_voice = "voice/bai/bai_0106.ogg"
            voice "voice/bai/bai_0106.ogg"
            bai "没人应。也没人跑。"
            nar "他把药箱提起来，贴在自己腿侧，等你听完，没催。水滴声一下接一下，数得出间隔。你数到第七滴，里面还是没有应声。"

        "不进，先把外围看完":
            nar "你顺着铁丝网走了一圈。后墙的铁丝被人补过，补得很仔细，断口拧成小圈，一圈压一圈。你把记认指给他看。补的人不想让人进，也不想让人困死。白砚顺着你指的地方看了一眼，没说话，只把药箱往门边又提紧了些。铁丝补口从外面看不出来，断口拧得小圈压小圈，补的人手很稳，熟门熟路。"

        "让他留在门外，你先探":
            $ vn2_aff_add("bai", 4)
            nar "你并到他那一侧，接过他肩上的箱带。他没躲，让了半寸。"
            $ vn2_current_voice = "voice/bai/bai_0107.ogg"
            voice "voice/bai/bai_0107.ogg"
            bai "进去以后，箱子不离手。"
            zhou "你在门外等。有情况我敲两下。"
            nar "他点头，手按在箱盖上，一直没松。他把箱带交到你肩上的时候，指尖在带扣上按了一下，确认你接稳了。箱带换到你肩上，压着衣服，分量不轻。风从铁丝网缝里钻过来，带着站里的潮气，比林子里的风凉。"

    # --- 节点 4/9 · 药箱清点（C 批容器 · menu） ---
    nar "石台面上，他把药箱提到中央，箱盖掀开，格位里的东西一支一支挪到摊开的防水布上。三支针剂并排横在布面，管身编号被指腹磨得发毛。一卷药布，边角起毛；一只扁方酒精瓶，瓶壁凝着细水珠。布是昨晚拆下来那块，边角用碎石压住。药布三卷，两卷干的一卷潮的；酒精瓶里泡着两团药棉，棉边已经发黄。箱角塞着缝线和小剪子，他先拨到一边，没混进余量里。"
    nar "他先开口报数，嘴唇不出声，指尖在每支管身上停一下。"
    $ vn2_current_voice = "voice/bai/bai_0108.ogg"
    voice "voice/bai/bai_0108.ogg"
    bai "针剂三支。药布还能缠两回。酒精够擦一轮伤口。"
    nar "你重新点一遍。针剂三支没差；药布铺开量，绕腕子还能缠三回；酒精瓶晃了晃，液面贴到瓶肩，不止一轮。他报完，把自己那只旧手往回收了收，搁在箱沿上。多出来的半卷布、半瓶酒精，他没补报。雾贴着石台走。铁丝网外的风一阵一阵，吹得断绳轻撞。水管滴水一声接一声，间隔数得出来。布面上三样东西各占一格。针剂管身反着头灯一点光，药布卷边松散，酒精瓶塞子没拧死，留着一线缝。"
    nar "头灯光圈落在布面上，三样摆开，影子很短。他蹲在石台边，膝上压着箱沿，等你先点。他把箱里空出来的格位看了一眼，用布垫住底，免得走路管身碰着响。"

    menu:
        "箱里这点余量，怎么留？"

        "三份平均留":
            $ vn2_aff_add("bai", 1)
            $ vn2_flag("bai_rationed", False)
            nar "你把针剂、药布、酒精摊成三份，每份一支针剂、一卷布、一份酒精，摆在布面三格。谁也不多拿，谁也不少留。他把三份看了一遍，指尖在自己那份上停了一下，又把自己那份里半格布拨回公共格。三份重新并齐，他才把针剂一支一支排回箱格。药布他只取最薄的一卷，塞进箱侧袋；厚的那卷压在公共格底下。酒精瓶他替你那一份先拧紧塞子，自己那只留着一线缝。"
            $ vn2_current_voice = "voice/bai/bai_0109.ogg"
            voice "voice/bai/bai_0109.ogg"
            bai "平均就平均。路上谁先伤着，先拿公共的。"
            nar "箱扣合上之前，他掌心里那份针剂在格位里推到最里层，管身贴着管壁，没露边。分完他把公共格的布角掖进箱沿，免得走路勾出来。三支针剂的位置和原来格位对上，一支没偏。"

        "全压在一个人身上":
            $ vn2_aff_add("bai", 2)
            $ vn2_flag("bai_rationed", True)
            nar "你说余量归他一个人管，你身边只留应急的一小份：半卷布、一小瓶酒精，针剂一支不占。他没推让。把药布卷回自己箱侧袋，酒精瓶一只只塞紧，空出来的格位用布填实。箱扣一道扣上，动作比平时慢半拍。他那只旧手按在箱盖上，指节压出一点白，停了一息才松开。箱带在掌心绕了一圈，又松开，勒出的印子留在指节上。"
            $ vn2_current_voice = "voice/bai/bai_0110.ogg"
            voice "voice/bai/bai_0110.ogg"
            bai "我管着。你手上那道口子，换药别省。"
            nar "你那份应急的布和酒精搁在箱最外一格，伸手就够到；针剂全在他夹层里，和他自己那半管并排贴着。夹层布面他按了一遍，确认针剂不会在里面滑出声。箱侧袋的袋口掖到顶，又留出半寸，好伸手取。"

        "记账，把余量抄下来":
            $ vn2_aff_add("bai", 1)
            $ vn2_flag("bai_rationed", False)
            nar "你把本子翻开，就着石台的光，把三支针剂的编号、药布卷数、酒精余量一行行抄下来。字写得小，笔划清楚，他凑过来看了一眼。笔尖在纸面上悬着，最后没划掉。本子上这一行，和他自己记的那列低数字并排摆在一处，谁也没遮谁。箱底他自己那份减出来的空格，你抄的时候没绕过去，在备注里留了半行。他指腹在箱扣上磨了磨，把那只空格的布垫又掖平了一道。"
            $ vn2_current_voice = "voice/bai/bai_0111.ogg"
            voice "voice/bai/bai_0111.ogg"
            bai "……记下就丢不了。"
            nar "铅笔头磨得很短，写到酒精余量那一行，他伸手把瓶身扶正了一点，让你看清液面的位置。抄完你把本子合上，页角压平。他把三支针剂按编号排回格位，管身标签朝同一个方向，比平时多核对了一遍。"

    nar "三份怎么留，都在箱里了。他把箱带提在手里，没立刻起身。水管滴水，一滴接一滴。雾从铁丝网缝里钻进来，贴着石台漫到脚边。他低头把箱盖内侧那卷药布的边角掖平，没说话。他把摊过布的防水布折回箱侧，压布的碎石子一颗颗拣回脚边石缝。石台上只留药箱和布面压出的浅印。你把本子收回怀里。箱里余量多少，往后每回换药，都要对一遍这笔账。"
    think "余量摊开过一回。往后少一支，本子上都对得出来。"

    # --- 节点 5/9 · 讲减药的原因（中刀两步） ---
    nar "两个人退回石台边。雾更厚了，站的轮廓只剩一个黑块。他先开的口。声音不高，对着锁说，不对着你。"
    $ vn2_current_voice = "voice/bai/bai_0112.ogg"
    voice "voice/bai/bai_0112.ogg"
    bai "我减药，不是想硬撑。"
    nar "他停了一下，手指在箱扣上磨了磨。"
    $ vn2_current_voice = "voice/bai/bai_0113.ogg"
    voice "voice/bai/bai_0113.ogg"
    bai "吃全份，手会慢。慢半拍，缝不上别人的口子。我留够站得稳的量，多余的省下来，留给队里。"
    nar "你想起前一晚那卷旧病历，想起敲碎的半支针剂。两列数字，一列按方子，一列往下走。你把药箱从脚边提起来，箱扣一只一只解开，再按格位把瓶管归拢一遍。空出来的格位用布垫住，免得走路时管身碰着响。他把箱带在掌心绕了一圈，又松开，带子勒出的印子在指节上留了一道。腕上那圈药布松了一道，你替他把布边掖进去，重新绕紧一圈，收口照旧打在外侧。"
    nar "他没拦，腕子搁在膝上，等你绕完，指腹在布边上按了按，确认不磨皮。头灯的灯芯烧得发黑，你拿剪子把焦头剪短一截，光圈重新稳住，落在石台面上，照不出两步远。剪下来的焦屑捏进掌心，丢进脚边的碎石缝里。水管滴水一声接一声，间隔数得出来。两个人都没先开口。风从铁丝网缝里钻过来，带着站里的潮气，他把外套领口拢了拢，药箱压回腿侧。"
    nar "你把水壶从袋里取出来晃了晃，剩的水不多，轮着喝还够撑到进站。壶塞拧紧，挂回包侧的扣袢上。脚边草叶上挂着露水，你把裤腿往上挽了一道，靴底在碎石上蹭掉泥，蹭完才坐回石台边。他说完第一层，停了很久。水管滴水一声接一声，他盯着锁孔，喉结动了一下，才往下讲。"
    $ vn2_current_voice = "voice/bai/bai_0114.ogg"
    voice "voice/bai/bai_0114.ogg"
    bai "以前队里有人倒下，我手上慢过一回。从那以后，我不敢吃全份。"
    nar "他没说那个人后来怎样。话到这里就收住，门留了一道缝，再多的不推。他说这些的时候一直看着锁，不看你。箱扣在他掌心里，被按出一声轻响。他说完这句，拇指在箱扣上蹭了两下，把话也一并扣住。"
    $ vn2_current_voice = "voice/bai/bai_0115.ogg"
    voice "voice/bai/bai_0115.ogg"
    bai "药留着不是给我舒服的。是留着手，给队里处理伤口。"
    nar "说完这句，他闭了嘴，多说一个字都越了界。"
    think "这一层，他今晚肯讲了。上一回在火边，他只给你看了空瓶子。"
    nar "他说完那句，沉默里只剩水管一滴一滴。你没追问那个人后来怎样，话留了缝，你不推，他也不补。你想起栈道上他先缠你的手，想起昨晚手术里他发抖的那只腕。"

    # --- 节点 6/9 · 药份（menu） ---
    menu:
        "他这份药，怎么安排？"

        "替他要一份，账上单列":
            $ vn2_aff_add("bai", 3)
            nar "你把本子翻开，在队里的份额旁边，另给他记了一行，按全份写。这一回他没有看了要划掉。"
            $ vn2_current_voice = "voice/bai/bai_0116.ogg"
            voice "voice/bai/bai_0116.ogg"
            bai "……多出来的那支，我不会动。"
            zhou "记上就是你的。动不动，你以后定。"
            nar "本子上那一行墨迹干透，压在其他账目中间，和他自己记的那列低数字并排。铅笔在纸上走了一行，笔锋比平时重。"

        "把你的份额分给他":
            $ vn2_aff_add("bai", 2)
            nar "你把自己手边那支未动的针剂推到他面前。他推回来一次，你又推过去。来回两次，他收下了，塞进夹层最里层。"
            $ vn2_current_voice = "voice/bai/bai_0117.ogg"
            voice "voice/bai/bai_0117.ogg"
            bai "你手还没好。"
            zhou "我还有半管。"
            nar "他没再争。喉结动了一下，把箱扣按紧。他收下以后，把那支针剂和自己夹层里的半管并排放好，管身贴着管身。你手还没好，他嘴上记着，手上也留着，没把这支再退出来。夹层最里层压着药布和缝线，针剂塞进去，他按了按布面，确认不会滑出声。"

        "什么都不说":
            $ vn2_aff_add("bai", 4)
            nar "你没接话，也没翻本子。两个人在石台上坐了一会儿，听水管滴水。他偏头看了你一下，等你开口。你没说。他也就不提了，只把箱带往你这边让了半寸。"
            think "不说，也是站在他这边，他懂。"
            nar "滴水声里，两个人都没再提药的事。石台面上凉，潮气从裤腿往上钻，谁也没先起身。他听完滴水，把药箱从左手换到右手，又换回来。"

    # --- 节点 7/9 · 门锁与钥匙交接 ---
    nar "他走到门前，指尖碰了碰锁面，又收回来，看你。"

    if store.station_key:
        nar "钥匙在你口袋里，你取出来，放进他掌心。金属凉的，齿痕已经磨平。"
        $ vn2_current_voice = "voice/bai/bai_0118.ogg"
        voice "voice/bai/bai_0118.ogg"
        bai "我来开。你靠后。"
        nar "钥匙插进去，转动很顺。锁芯咔哒一声，门开了半扇。"
    else:
        nar "身上没有钥匙。你们绕到后墙，铁丝补口松着一根，拔开钻进去，落进院里。"
        $ vn2_current_voice = "voice/bai/bai_0119.ogg"
        voice "voice/bai/bai_0119.ogg"
        bai "走这边。别碰响铁丝。"

    nar "新锁、新油。这座站有人常来照看，只是从不让人从正门进。锁扣上没有锈痕，开合的地方被手摸得发亮。常来的人，不止一个。院里的地面铺着碎石，缝里长着草，没人拔。窗洞一个个黑洞着，玻璃早碎干净了。院里静得能听见水滴从屋檐落到碎石上。碎石缝里的草被踩倒过，又长回来，方向都对着正门。窗洞边上积着一层灰，没人擦。"

    # --- 节点 8/9 · 雾里过渡 ---
    nar "雾从铁丝网缝里钻进来，贴着碎石地走。院里的黑比门外厚一层，头灯的光切进去，照不出两步远。他提着药箱走在前面，步子没慢。箱带勒进指节，右手还僵着，落步的时候先稳一下重心。你跟在他后半步，耳朵留着门外的动静。风从站里穿出来，潮气混着旧灰味，比林子里的风凉。"

    # --- 节点 9/9 · 门开一条缝（接 ch25） ---
    nar "门里的气扑出来，潮的，旧的，混着尘土和锈味。他走在前面，右手还僵着，脚步没慢。药箱提在手里，箱带勒进指节。门在身后留着一道缝。雾顺着缝往里钻，又被门里的黑暗挡住。"
    think "站门过了。里面那笔账，一笔一笔都要对回来。"
    nar "头灯的光切进门廊，一道白线，照不到尽头。门廊的墙皮剥落，露出里面的砖。头灯扫过去，砖上有人用粉笔刻过一道记号，被磨得只剩半个。门廊两侧的墙皮一块一块翘起，伸手能碰到灰。砖缝里渗着潮气，脚踩上去发潮，头灯扫过，灰簌簌往下掉。"
    think "进去之后，先把退路记在心里。门留着缝，不算封死。"
    nar "门轴没有响。他开门的时候垫了手，做过很多回。你最后回头铁丝网。门外的雾还在原地，门里的黑层层。这一步迈进去，就没有半路退出来的道理。门在他身后留着那道缝，雾从缝里进出。你在心里把进来的路又走了一遍：石台、铁丝网补口、半扇门。退路记牢了，才跟着他往门廊深处走。"

    # --- 9/9 补 · 门边的最后一支（bai 线晚期补救） ---
    menu:
        "进站前，最后一点药怎么留？"

        "把最后一支针剂留在门边给十七":
            $ vn2_flag("trust_shiqi")
            nar "你从药箱夹层里抽出最后一支针剂，放在门边那块干石上，管口朝里，压了一小片布挡潮。白砚看见了，没拦，只把箱扣重新扣好。"
            nar "你们进门时，那支针剂还留在门外的干石上。"

        "带进去，里面还有人要救":
            nar "你把针剂塞回夹层，箱扣扣紧。白砚走在前面，右手还僵着，脚步没慢。门里的黑层层，你们没再回头。"

    $ vn2_hide_all(trans=dissolve_soft)
    $ vn2_leave_chapter()
