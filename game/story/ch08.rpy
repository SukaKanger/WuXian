# 第 8 章 • 沼泽边（第 8 天 / 共同线）
# 节点：1 涨水进洼 · 2 水洼里的红毛 · 3 救不救（menu）· 4 上岸喘定
#       · 5 过最后一段深水（menu）· 6 泡皱的旧伤（menu · 青岩并肩甜点）
#       · 7 指路与出洼

label ch08:

    scene bg marsh with slow_fade
    $ vn2_enter_chapter("ch08")
    call vn2_title_card(8, "沼泽边", "第 8 天 • 共同线")
    $ vn2_amb("rain")

    if vn2_story_mode == "cut":
        jump ch08_cut

    $ vn2_show("lan", pos="left", trans=dissolve_soft)
    $ vn2_show("bai", pos="right", trans=dissolve_soft)
    $ vn2_show("qing", pos="center", trans=dissolve_soft)

    # --- 节点 1/7 · 涨水进洼 ---
    nar "水一夜之间涨上来。先没过脚背，再没过膝盖。泥在脚底下吸人。拔一步，响一声。"
    $ vn2_current_voice = "voice/lan/lan_0046.ogg"
    voice "voice/lan/lan_0046.ogg"
    lan "别停。停下来就陷。"
    $ vn2_current_voice = "voice/bai/bai_0036.ogg"
    voice "voice/bai/bai_0036.ogg"
    bai "药箱举高。底一沾水，药就废。"
    $ vn2_current_voice = "voice/qing/qing_0026.ogg"
    voice "voice/qing/qing_0026.ogg"
    qing "上游在下雨。这片洼地会连成一片。"
    think "前面的水色发黑，看不见底。"
    nar "雨斜着落，水面砸出一层密点。芦苇齐腰，草叶上的水顺着裤腿往下淌。背包带泡胀了，勒进肩里，每走一步往下坠。靴底拔出来的时候带起一团黑泥，泥又落回洼里，闷响一声。洼边的树只剩半截露在水上，树干泡得发白。腐叶的甜味混着泥腥气。你回头来路。"
    nar "脚印早被水盖平，两岸的草在雨里压着，分不出哪道是人踩的。洼地里的水不动的时候发黑，动起来泛一层浑黄。水面上浮着碎叶和断枝，随波一荡一荡，聚到草根边卡住。你把背包带勒紧一格。药箱在白砚手里举着，箱底离水面始终一拳高。青岩的样本箱抱在胸前，箱角用布缠过，不怕磕。雨顺着眉骨往下淌，糊住视线。你抬手抹了一把，袖口的水又滴进洼里，砸出一圈细纹。"
    nar "风从洼面上刮过来，裹着水腥气。你把步子放慢，先踩实再落脚。洼地里看不见深浅，哪一步踩空，整个人就得陷下去。洼地里的水被雨打得发浑，脚下的泥一层软一层硬，踩错一步就往下陷半寸。背包上的滴水连成细线，顺着肩带往腰里渗。谁的裤腿都湿到大腿根，布贴在皮肤上，沉。"

    # --- 节点 2/7 · 水洼里的红毛 ---
    nar "水洼中间，有一团红毛。一只红狐陷在及胸的水里，背包压着肩，爪子抠不住草根。"
    $ vn2_current_voice = "voice/ari/ari_0001.ogg"
    voice "voice/ari/ari_0001.ogg"
    ari "……拉我一把。就一把。"
    nar "她声音发哑，尾巴泡在水里，毛一缕一缕贴住。"
    think "绕过去，还是蹚过去？"
    nar "她周围的水几圈荡开，又合上。背包露出半截，带子在水面上漂着，随水波一掀一掀。爪子抠过的草根只剩一点白茬，底下全是烂泥。雨把她耳后的毛打成一绺一绺。她抬眼扫过你们四个，没喊第二遍，只把手里抓着的那根断枝又攥紧了些。她身后的水洼连着一片更深的黑，看不见岸。背包侧袋露出半截绳，绳头泡在水里，随着水波晃。红毛湿透之后颜色深了一层，贴在背上，显出肩骨的形状。"
    nar "她下巴绷着，不肯让声音发颤。她脚边的水浑成一片，泥泡一个接一个翻上来，破在水面上。再陷下去，连背包带人都得沉进烂泥里。"

    # --- 节点 3/7 · 救不救（menu） ---
    menu:
        "水里的人，救不救？"

        "蹚过去，先把人拉上来":
            $ vn2_flag("ari_helped")
            $ vn2_aff_add("ari", 3)
            nar "你把绳抛过去。她缠住手腕，四个人一齐拽，才把她拖上岸。"
            $ vn2_current_voice = "voice/ari/ari_0002.ogg"
            voice "voice/ari/ari_0002.ogg"
            ari "水线我认得。左边两丈是实底，右边全是烂泥。"
            nar "她抹了把脸上的水，从怀里摸出一把干肉，搁在你手边。"
            $ vn2_current_voice = "voice/ari/ari_0003.ogg"
            voice "voice/ari/ari_0003.ogg"
            ari "部落里的规矩。受了人一把力，要还一条路。"
            nar "干肉用油纸包着，没进水。她上岸之后先把背包甩到干处，蹲下身拧尾巴上的水，动作利落，不像刚陷过一回。你把绳收回来，绳股上滴着黑水。她指的方向在北边，和你们要走的线大致同向。干肉的油纸包被她按在你手边，没收回。"

        "先站在实底上喊她，让她自己往草根挪":
            $ vn2_aff_add("lan", 2)
            nar "你站在没膝的实底上喊方向。她顺着草根往这边摸，爪子抠住一蓬老根，自己又陷下去一次。蓝羽把手里的木棍横着递过去，她攥住棍身，四个人在岸线一齐拽，才把她拉上来。背包先陷进烂泥，捞上来时侧袋已经进水。她甩了甩尾巴上的水，没再提干肉，只往北指了一下。她指的方向和你们要走的线大致同向。"

        "先保队伍，绕开她走":
            nar "你绕开那团红毛。水声里，她的喊声被雨压得越来越远。"
            $ vn2_current_voice = "voice/qing/qing_0027.ogg"
            voice "voice/qing/qing_0027.ogg"
            qing "她认得这片水。"
            nar "青岩回头，没再说下去。队伍多绕了半里，才找到能下脚的地方。绕开的那段路泥更软，每一步都得先探虚实。身后水洼里那点红毛，隔一会儿才在雨幕里晃一下，慢慢就看不清了。你走在最前面探虚实，每一步先踩实了再落脚。队伍拉成一线，谁的靴子拔出来响一声，后面的人就接着响一声。"

    # --- 节点 4/7 · 上岸喘定 ---
    nar "上岸之后，水还在涨。裤脚往下滴水，谁也没先开口。坡脚一片硬泥地，四个人先后挤上来。靴子踩在干泥上，发出咯吱的响，泥块一块块从靴底剥落。你把裤腿卷到膝盖，水顺着小腿往下淌。雨还在下，顺着后颈往领口里钻，凉得人一缩。白砚把药箱搁在高处一块石头上，掀开箱盖看了一眼，又扣回去。箱底没沾水，他肩膀松了半分。青岩把样本箱抱在膝头，翻开箱角检查内里，纸页一张没潮。"
    nar "他合上箱扣，指节在扣上压了压。"
    think "水还在往上涨。这一片洼地，不能再回头走第二遍。"
    nar "坡脚的硬泥地不大，四个人挤在上面，背包摊开晾了一角。白砚把药箱翻过来检查底扣，指腹擦过箱角的泥。你拧了拧裤腿，水顺着脚踝往下淌，在脚边积成一小摊。雨还在下，身上的湿衣服被风一吹，凉得人胳膊上起一层粒。坡脚的碎石被水泡得发黑，踩上去打滑。四个人轮流把脚从泥里拔出来，在干处蹭掉靴底的泥。风从坡上下来，比洼地里干一点，吹在脸上稍稍压过了水腥气。"
    nar "谁也没先坐下，先把胸口那口喘匀。"

    # --- 节点 5/7 · 过最后一段深水（menu） ---
    menu:
        "过最后一段深水，先顾谁？"

        "把木棍递给腿在抖的蓝羽":
            $ vn2_aff_add("lan", 4)
            nar "他撑住木棍，喘了三口气，才把步子迈出去。"
            $ vn2_current_voice = "voice/lan/lan_0047.ogg"
            voice "voice/lan/lan_0047.ogg"
            lan "欠你一次。"
            nar "他过了水，回身把木棍又递回来，让下一个人用。木棍上留着他手心的汗，湿了一截。他把袖子撸到肘上，水顺着小臂往下滴，滴进洼里，一声接一声。他过了深水，靠在岸坡上喘气，胸口起伏了几下，才把呼吸压平。木棍横在膝上，他指尖搭着棍身没松开。"

        "接过白砚手里的药箱":
            $ vn2_aff_add("bai", 4)
            nar "箱子比看上去沉。白砚空出手，走得快了些。"
            $ vn2_current_voice = "voice/bai/bai_0037.ogg"
            voice "voice/bai/bai_0037.ogg"
            bai "别摔。里面是全队的药。"
            nar "他说完，抿了一下嘴，视线转回前面的水线。药箱贴在你胸前，箱角硌着肋骨。他在前面探路，脚步不快，每走一段就回头看一眼箱子有没有歪。你托着箱底走，箱角不碰水面。他在前面避开两处颜色发黑的水，回头确认箱子还稳，才接着往前。"

        "替青岩背起样本箱":
            $ vn2_aff_add("qing", 4)
            nar "箱子不重，扣得很紧。青岩跟着你走了半步，伸手扶了一下箱角。"
            $ vn2_current_voice = "voice/qing/qing_0028.ogg"
            voice "voice/qing/qing_0028.ogg"
            qing "样本比人娇气。摔不得。"
            nar "他没道谢，只把箱带往你肩上挪正了些。箱侧的记录本露出一角，被他按回去，压在箱盖底下。雨打在箱面上，顺着边角往下淌，没渗进去。箱子压在你肩上，箱带勒进布衣。青岩跟在侧后半步，遇到上坡伸手扶一下箱角，下坡又把箱带往你这边拢一拢。"

    # --- 节点 6/7 · 泡皱的旧伤（menu · 青岩并肩甜点） ---
    nar "最后一段水走完，你才觉出手背上那道口子在跳疼。昨天雨里裂的旧伤，泡了一路水，皮泡得发皱，边缘泛白。你把手从水里抬起来，甩了甩水。袖口吸饱了水，沉甸甸贴在腕上，布纹磨着伤口。"
    think "先不吭声。出了洼地，找干地方再缠布。"
    nar "伤口被水泡得发白，边缘一圈泛红。你弯了弯手指，口子跟着扯一下，疼得浅，但一直不停。"

    menu:
        "这道泡皱的旧伤，怎么处理？"

        "把手腕递到白砚那边":
            $ vn2_aff_add("bai", 2)
            nar "你把手腕递过去。白砚正蹲在石头边理药箱背带，先放下手里的扣，把你的手接过去翻过来，掌心朝上。指腹沿旧伤那道口子停了一下，看了看泡白发皱的皮。他从箱侧摸出干净药布，先给你把手缠上，布边压平，收尾打了个活扣。处理完你这只手，他才收回自己的手。他自己指节上也有一道旧裂，发干，他就着袖口蹭了蹭，没替自己上药。前面探水线的蓝羽回头，又转回去。"
            nar "青岩把样本箱往身边挪了挪，视线在这边落了半息，低头继续扣箱扣。"
            think "他先看你的手。自己那道裂，排在后头。"

        "自己攥着，先不提":
            nar "你把袖口往下扯了扯，盖住那道口子。泡皱的皮贴着布，凉得发木。你把手插进裤袋里，跟着队伍往前走。伤口一跳一跳，被走路的步子带着，一下一下撞着掌心。白砚的视线扫过来一次，落在你袖口上。你把手往裤袋里又塞深了些，他没开口，转身去理药箱背带。"
            think "回营地再缠。现在开口，全队都得停下来等。"

        "走到青岩旁边，让他看样本箱的扣":
            # 节点 6 分支 · 青岩并肩甜点（干棱让给你，自己站靠洼的湿边）
            $ vn2_aff_add("qing", 2)
            nar "你凑到青岩那边，指着箱角那道松了的扣。他顺着你的目光看箱子，顺手把箱带往你这边挪正。坡脚硬泥地只够四个人挤着站。他把样本箱搁在靠里那道干棱上，自己转身站到靠洼的一边，湿泥没过靴帮。你往干棱挪了半步，他伸手把你肩上滑下来的背包带提回去，没说话。他视线在你手背上停了半息，没说破，只把记录本从箱缝里抽出来一点，又塞回去。"
            $ vn2_current_voice = "voice/qing/qing_0029.ogg"
            voice "voice/qing/qing_0029.ogg"
            qing "扣紧了再走。箱子晃一路，纸页就散一路。"

    # --- 节点 7/7 · 指路与出洼 ---
    if ari_helped:
        nar "红狐站在高地上，朝你们指了指北边。"
        $ vn2_current_voice = "voice/ari/ari_0004.ogg"
        voice "voice/ari/ari_0004.ogg"
        ari "顺着我指的线走。今晚之前，别再下水。"
        nar "她站在一块没被水淹的土包上，红毛在灰绿的洼地里很扎眼。说完她转身往另一侧的芦苇丛走，尾巴甩了一下，没再回头。你记下她指的那条线：绕过两片发黑的水洼，顺着芦苇最稀的那道缝走。"
    else:
        nar "身后的水洼里，那团红毛已经看不见了。雨幕把洼地盖成一片灰绿。你只能凭水色深浅挑下脚的地方，哪片是实底，哪片是烂泥，全靠踩下去那一下的软硬判断。"

    zhou "跟上。天黑前必须出这片洼地。"

    nar "沼泽留在身后。四个人的鞋里全是泥，泥里有一股腐叶的甜味。上坡的路慢慢干起来。靴底踩过碎石，咯吱响，泥块一片片剥落，露出底下的土色。芦苇在身后矮下去，只剩一片晃动的灰绿。雨小了一层。林冠在头顶重新合上，滴水声从四面八方落下来，和洼地里的水声不是一个调子。你回头望了一眼。来路的水线已经辨不出，只有洼地的雾气贴地，慢慢往回收。"
    nar "出洼的这一段坡不长，走起来却慢。每一步都得从泥里拔出来，靴底沉得像坠了石头。队伍重新排成一线，踩着干路往前走。脚步声在碎石路上连成一片，靴底的泥一块块剥掉，露出靴子本来的颜色。青岩落在你侧后半步，遇到坡边发软的泥，脚步往外侧让了让，把干一点的路面留给你这边。"

    $ vn2_hide_all(trans=dissolve_soft)
    $ vn2_leave_chapter()
