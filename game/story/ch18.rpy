# 第 18 章 • 两条路（第 18 天 / 蓝羽线）
# 节点：1 岔口地形 · 2 两条路的代价 · 3 走快 / 走稳 / 让他定（menu）
#       · 4 雨里休整（menu）· 5 撕下半张断线图 · 6 接 / 不接 / 换来罗盘（menu）
#       · 7 断崖勘察（menu · C 批容器）· 8 图能对上 · 9 站门在雾里出现

label ch18:
    $ vn2_unlock_cg("cg_key_half_map_v2")
    scene bg forest with slow_fade
    $ vn2_enter_chapter("ch18")
    call vn2_title_card(3, "两条路", "第 18 天 • 蓝羽线")
    $ vn2_amb("forest")

    $ vn2_show("lan", pos="center", trans=dissolve_soft)
    $ vn2_cg_show("images/cg/cg_key_half_map_v2.png", trans=dissolve_soft)

    # --- 节点 1/9 · 岔口地形 ---
    nar "天亮透了。林子静，树挂往下滴水，泥里两道旧辙，一前一后伸到岔口。一条路往坡腰上切，土石发白；一条顺着洼地边沿绕，草深，看不见尽头。岔口的石头上落着一层湿叶，两边都有人踩过，又都被雨冲浅了。面前两条路：一条切坡，近；一条顺着地图上的旧线，远。蓝羽把地图摊开，压在膝头。队徽别回了他内侧口袋，隔着布不露边。雾还压在林腰，日头透不下来，树干一层深一层浅。"
    nar "风过林子，枝叶响成一片。他低头看图，睫毛上挂着水，没擦。泥里两道旧辙伸到岔口，一深一浅。岔口两边的蕨叶被踩倒过，叶尖发黑。岔口两边的蕨叶被踩倒一片，叶尖发黑，是先前的人压过的。"

    if store.close_lan:
        nar "他不用你问，把地图转过来，让你先看断线那一段。"
        $ vn2_current_voice = "voice/lan/lan_0131.ogg"
        voice "voice/lan/lan_0131.ogg"
        lan "近的那条省一天。对的那条，人齐。"
    else:
        nar "他把图折好，只露出自己要走的那一段。"
        $ vn2_current_voice = "voice/lan/lan_0132.ogg"
        voice "voice/lan/lan_0132.ogg"
        lan "路我来看。你跟着就成。"

    # --- 节点 2/9 · 两条路的代价 ---
    nar "近路从坡腰切过去。坡塌过一段，碎石松，踩上去会往下滑，绳得两个人轮流拉。近路省下的一天，要拿脚力换。坡上没有遮，雨一淋，石头比泥还滑。远路顺着旧水线走，绕洼地，多一天。雾重，补给紧，夜里找不到背风的地方。远路走过旧站留下的辙，记号还在，走错的余地大。两条路在图上隔得不远，走到头却差出一天脚程。近路要翻两道碎石梁；远路要过一片回水洼，水没到小腿。"
    nar "坡腰上的碎石被雨水泡松，一脚下去能带下半片，滚很久才落地。坡面上没有树挡，雨一落，石面比泥还滑，踩不稳就得靠绳拉。洼地边上的草长得密，没过膝，里头的水浑，看不见底下的石。两条路在图上各标了一道旧记号，记号深浅不一，不知道是哪一年留的。风从坡腰灌下来，带着碎石的干味；从洼地绕过来，又裹着水草的腥气。"

    if store.station_key:
        nar "守门人给的钥匙在你口袋里，凉的。门那边有什么，他没问。"
    else:
        nar "门还隔着一道坡。钥匙的事，没人再提。"

    if store.trust_team:
        nar "这一路后背是交过的。他知道这一点，所以才把路线指给你看。"
    else:
        nar "队伍之间还有半截话没说透，他带路，后背没完全交出来。"

    think "跟前一次分岔不一样，这回他心里有数。"
    nar "风从两条路中间穿过去，一边带土腥，一边带水草气。"

    # --- 节点 3/9 · 走快 / 走稳 / 让他定（menu） ---
    nar "两句话说完，他不催。地图上两条线被指节压着，一样清楚。"

    if store.close_lan:
        nar "他看了你左脚一眼，没问旧伤，在图上把近路那段绕开，挑了条少踩碎石的走法。"
        $ vn2_current_voice = "voice/lan/lan_0133.ogg"
        voice "voice/lan/lan_0133.ogg"
        lan "这段坡碎，绕开。你脚不吃力。"
        nar "他指尖在图上把绕开的那段描了一遍，又在汇口画了个小圈。坡上的碎石梁被他划到备选之外，近路省下的半天，他没再提。你没说过这只脚在雨里发酸。他看一眼就记下了，路线顺着脚力改，没多问一句。路线绕开碎石梁，多走小半里，脚底下却是平土。他把图推过来，指尖点在那条平线上，没再看坡腰。"
        $ vn2_aff_add("lan", 1)
    else:
        nar "路线照他原本指的走，没替你的脚改。"

    menu:
        "先定哪条？"

        "走快，翻近路把坡抢过去":
            $ vn2_aff_add("lan", 2)
            nar "他看了你一下，没争。砍刀换到外侧，走在前面探路。"
            $ vn2_current_voice = "voice/lan/lan_0134.ogg"
            voice "voice/lan/lan_0134.ogg"
            lan "近路塌过一段。跟紧，别走散。"
            nar "碎石在他脚下滚下去，过了很久才听见落地的声。你把绳绕到手腕上，跟上去。坡上的碎石被他一脚一脚踩实，才回头看你跟没跟上。你把砍刀换到自己这侧，替他多挡一段探出来的枝。"

        "走稳，顺旧线那条":
            $ vn2_aff_add("lan", 4)
            nar "你点头。他把地图折小，塞回口袋，队徽贴着地图。"
            $ vn2_current_voice = "voice/lan/lan_0135.ogg"
            voice "voice/lan/lan_0135.ogg"
            lan "远一天。走到了，就一起进去。"
            nar "他指尖在折痕上压了一遍，折痕对准原来那道旧痕，一丝没偏。旧水线两边的树长得密，枝叶在头顶搭成一条廊。"

        "让他把两条路都指给你看完再定":
            $ vn2_aff_add("lan", 3)
            nar "他蹲下来，指尖在两条线上各停了一会儿。指节上还有夜里的湿泥。"
            $ vn2_current_voice = "voice/lan/lan_0136.ogg"
            voice "voice/lan/lan_0136.ogg"
            lan "我带路。你认记号，圈加一横那种。"
            nar "你把这两个记号记在心里。他站起来，拍掉膝上的土，裤脚还滴着水。两条线在他指尖底下各弯了一道，弯向不同的方向。"

    # --- 节点 4/9 · 雨里休整 ---
    nar "进林子半里，雨落下来。两个人退到斜岩檐下避。水沿岩边拉成一道线，外面白茫茫。你拧干手套，把水壶倒过来晃了晃，剩小半壶。他靠着岩壁，砍刀横在膝上。岩檐不宽，两个人肩挨着肩，谁也没往边上让。湿毛贴在颈侧，风从缝里钻进来，凉。水从岩檐滴在脚边，汇成一小洼，映不出天。岩缝里长出一丛硬草，被风一吹，贴在石壁上。岩檐上的水拉成线，一滴接一滴，在脚边砸出小坑。"
    nar "两个人的外套都没干透，搭在臂弯里，潮气顺着袖口往下走。"

    if store.ari_helped:
        nar "阿瑞先前给的补给还剩一份干粮。你留着，打算到坡顶再分。水壶在两个人手里传了一圈，谁都没多喝，又传回去。"

    menu:
        "歇脚这一阵，你做什么？"

        "把干粮分一半给他":
            $ vn2_aff_add("lan", 3)
            nar "你把自己那份干粮掰两半，大的那半推过去。他看了一眼，接了，没说谢。"
            $ vn2_current_voice = "voice/lan/lan_0137.ogg"
            voice "voice/lan/lan_0137.ogg"
            lan "你留着。我吃得少。"
            nar "话这么说，那半块他没再推回来，慢慢嚼完了，把碎屑拢进掌心倒进嘴里。干粮袋空了，他把袋口折好塞回你包里。他嚼得很慢，嚼完把掌心的碎屑也拢干净，一点没剩下。"

        "趁歇脚检查两个人的绳结":
            $ vn2_aff_add("lan", 2)
            nar "你把两条绳都拉了一遍。三股的结紧；他那根四股的，毛了一股，松在边上。"
            $ vn2_current_voice = "voice/lan/lan_0138.ogg"
            voice "voice/lan/lan_0138.ogg"
            lan "这回断不了。"
            nar "你帮他把毛的一股绕回去，打了双结。他伸手扯了扯，确认够紧，才把绳盘回去。绳芯捻上去发潮，你没捻到底。外头的股还结实，里头软，和腕口那截旧绳头一个样。绳盘好之后，两个人的绳并在一起，分不出哪根是谁的。绳结拉紧的时候，雨水从绳股里挤出来，滴在鞋面上。"

        "什么都不做，靠着石头听雨":
            $ vn2_aff_add("lan", 2)
            nar "你靠着岩边，听雨水从叶尖往下掉。他在旁边擦砍刀，一下一下，节奏和雨声对上。"
            think "不说话的这段，比讲路还稳。"
            nar "雨小下去的时候，他先起身，把背包甩回肩上，伸脚把岩边的碎石踢开。岩外的雨幕里，偶尔有枝桠被压弯，弹回原位。"

    # --- 节点 5/9 · 撕下半张断线图 ---
    nar "雨停了一阵。他把地图重新摊开，断线那一段压平，按在膝头。纸很薄，潮得发软。他沿着旧折痕比了两遍，指甲压住，慢慢撕。撕纸的声音很干，和雨声不一路。断口参差，铅笔线各断一半。半张图上，断线的头朝站的方向；另半张上，断线的尾压在营地方向。防水袋口敞开着，里头那张洇开的纸压在最底下。他指腹在袋口停了一下，没翻给你看。他撕图的时候手很稳，纸边却还是毛了一道。"
    $ vn2_current_voice = "voice/lan/lan_0139.ogg"
    voice "voice/lan/lan_0139.ogg"
    lan "半张在你那儿。半张在我这儿。站门口对得上，就是同一条线。"
    think "图撕成两半，人也分成两边。对得上的时候，才算一起到了。"
    nar "你把自己那半张的断口在心里描了一遍，记下参差的形状。他撕完把两段断口并在一起比了比，又分开，一手一张，等你接。队徽在他内侧口袋里，隔着布，贴着这半张图的纸边。纸面被潮气浸得发皱，铅笔线有的地方洇开，断口两边对不齐。他撕的时候指腹压着纸边，压出一道深折，指甲缝里沾了纸屑。"

    # --- 节点 6/9 · 接 / 不接 / 换来罗盘（menu） ---
    nar "他把撕下来的半张图递过来。断口对着你，铅笔线缺了半截。"

    menu:
        "半张图，你怎么做？"

        "接下半张图":
            $ vn2_aff_add("lan", 5)
            nar "你把半张图折好，压进自己的防水袋，贴着绳头。纸还是潮的，软在袋底。"
            $ vn2_current_voice = "voice/lan/lan_0140.ogg"
            voice "voice/lan/lan_0140.ogg"
            lan "收好。到门口再对。"
            nar "他把自己那半张压回内侧口袋，和队徽放在一处，按了按袋口。他解下腕口那截旧绳头，塞进你手心，把你的手指逐根收拢压住。"
            $ vn2_current_voice = "voice/lan/lan_0141.ogg"
            voice "voice/lan/lan_0141.ogg"
            lan "攥着，别松。"
            nar "绳头潮凉，压在掌心。他松开手，袋口扎紧，半张图贴在你后腰的位置，走路时轻轻抵着。这截绳从断崖那回就在你腕上，守火那晚他又多绕了一道双结。他掌心的温度留在绳股上，压着你的指节，逐根合紧。他松手的时候顿了一下，怕你攥不住。绳头在你掌心弯成一圈，结眼贴着腕骨。绳股上的毛茬蹭着掌纹，是这一路磨出来的旧触感，熟得不用低头看。"
            $ vn2_aff_add("lan", 1)

        "不接，让他自己留着":
            $ vn2_aff_add("lan", 3)
            nar "你摆手。他把半张图收回袋子里，手指在折痕上按了按。"
            $ vn2_current_voice = "voice/lan/lan_0142.ogg"
            voice "voice/lan/lan_0142.ogg"
            lan "也行。丢了谁的，都接不上。"
            nar "他把袋口扎紧，系了个死扣，没打算随手丢掉。他把两半图都收回自己袋里，走路时袋口贴着队徽，不响。"

        "不接图，把罗盘换给他":
            $ vn2_aff_add("lan", 2)
            nar "你解下腰间的罗盘，连绳一起递过去。他愣了一下，半张图先收了回去。"
            zhou "你认路。罗盘给你。图我记住了。"
            $ vn2_current_voice = "voice/lan/lan_0143.ogg"
            voice "voice/lan/lan_0143.ogg"
            lan "……罗盘你拿惯了。我不夺。"
            nar "最后他把罗盘别回你腰上，图还是分了两半，一人一张。罗盘在你腰上晃了两下，指针转了半圈，稳住，指向来路。他看着你腰上的罗盘看了两息，转过头去看路。"

    # --- 节点 7/9 · 断崖勘察（menu · C 批容器） ---
    scene bg cliff with slow_fade
    $ vn2_amb("rain")

    nar "林子到头，眼前豁开一道断崖。坡腰被雨泡松，裸岩一道压一道，雾填在谷底，看不见底。断线那一段在图上指着崖上。图上画的旧记号，得在这块石头上对一遍；对不上，后面的线都是猜的。崖上三条走法。一道脊线贴着崖顶翻过去，近，窄，两边都是空的；一道顺着谷底水线绕，稳，多耗半日；一道退回林线，先不下崖。这道崖他以前走过。"
    nar "图上断线从崖腰切过去，旧年留的记号被苔盖住大半，只剩一点白边。风贴着崖壁走，碎石的干味送上来；谷底的水声隔很久才听见一声，听不出远近。天光压在雾上面，薄。天黑之前回不到主线上，今晚就得在崖上过夜，补给不够撑一夜。腕口那截旧绳头还缠着。断崖那回它吃住过一次力，芯里捻开过，发黑发潮，一捻成粉；他当时说，这截不能再吃第二回力。再把它压上崖脊，就是拿它赌。"
    nar "绳身上的双结是守火那晚多绕的一道，结眼贴着腕骨，潮的。蓝羽把砍刀换到外侧，站在崖边往下看。风把他耳后的毛吹起来，他没抬手压。"
    $ vn2_current_voice = "voice/lan/lan_0144.ogg"
    voice "voice/lan/lan_0144.ogg"
    lan "脊线快，滑。谷底稳，费天光。退回去，人保住，图上这段就永远对不上。"
    nar "三句话说完，他不催。回头看你，等你定。"

    menu:
        "断崖这一段，怎么走？"

        "走崖脊，翻过去把断线对上":
            $ vn2_aff_add("lan", 1)
            nar "你选了脊线。他看了你一下，没争，先把绳在两块岩角上各试了一遍，确认吃得住，才让你跟。他走在前面半步，每踩实一步，脚下的碎石被他蹬下去一片，滚很久才听见落地声。绳在两个人中间绷着，不松不紧。第一段裸岩他停住，没先上。他把绳尾绕到你掌心，指节压着你的手背，把你手指逐根收拢，让出最前面那个踩点。"
            $ vn2_current_voice = "voice/lan/lan_0145.ogg"
            voice "voice/lan/lan_0145.ogg"
            lan "这一步你先踩。踩住了，我跟。"
            nar "你踩下去，石面被苔泡软，晃了半寸，站稳了。他才跟上，靴底压在你落过的位置，一步不偏。翻到脊线窄处，他停下来，把绳结解开重打了一回，还是双结，多绕一道。他指腹在结眼上碾过两遍，确认拽一下只会更紧，才把绳递回你手里。打完他没说话，尾巴在身后收了一下。绳股贴着腕骨，还是潮的，被两个人的体温焐着，慢慢回了一点温。"
            think "他自己踩过的崖，让你先走第一脚。这一步，他信你踩得住。"
            nar "过了脊线，断线那段在崖壁上对上了图上的记号。绳在这一程又吃了一回力，芯里那点粉又松一层；外头股还立着，结没散。"

        "绕谷底，顺着水线慢慢过":
            $ vn2_aff_add("lan", 1)
            nar "你选了谷底。他点头，把脊线那段从图上划到备选，没再提近路省下的半日。谷底水没到小腿，草深，底下的石看不见。两个人一前一后，踩着旧水线的记号走，不用绳。他走在后面一段，替你挡过来往枝上的湿苔。脚底稳，步子慢，图上崖脊那一段，留在上面没验。绕到汇口时天光又薄一层。他抬眼看了看坡腰，没说可惜，只把图折小，塞回内侧口袋。"

        "回撤，先保人退到林线":
            nar "你摇头，先不下崖。他沉默了一息，把绳从岩角上解下来，盘回你腕口，动作很慢。"
            $ vn2_current_voice = "voice/lan/lan_0146.ogg"
            voice "voice/lan/lan_0146.ogg"
            lan "退。人先回去。"
            nar "两个人退回林线。图上崖脊那段，到底没在石头上核对过；断口两边的记号，仍旧只是图上的铅笔线。他没提这段丢了的进度。走路时他走在外侧，隔着半步，尾巴压在腰后，一路没回头看崖。"

    # --- 余波 · 任务压力与余波 ---
    nar "回到林线，两个人的呼吸都没压匀。雨又落下来，细，斜着打在脸上，外套早湿透了，贴在身上凉。你把腕口的绳头按了一遍。股身发硬，毛茬翘着；芯还是潮的，外头看着还是一根整绳。图折好了，压在贴身处，潮的，软的。对上的那段，记号在心里记下了；没对上的那段，断口是什么形状，也还记着。补给又少了一份。水壶传了一圈，谁都没多喝；干粮掰到最后一顿，两个人分着算，刚好够走到站门口。"
    nar "你左脚的旧伤在雨里发酸，走慢了半步。他没催，把步子压到和你一样，靴底踩在平土上。他靠着树干把砍刀擦了一遍，一下一下，节奏和雨声对上。擦完他把刀别回腰侧，抬眼看了看雾压的方向。"
    $ vn2_current_voice = "voice/lan/lan_0147.ogg"
    voice "voice/lan/lan_0147.ogg"
    lan "歇够了就走。门在前面，不等人。"
    nar "雾从坡腰漫上来，把刚才那道断崖盖平，没人上过。你握紧掌心那截绳，跟上他的步子。崖上验没验上的那段，都先压在图里。进门之前，没有人再提今晚要不要回去。雾一重，身后的来路就看不见了。绳在腕上，图在贴身的地方，人还站在一处。"

    scene bg forest with slow_fade
    $ vn2_amb("forest")

    # --- 节点 8/9 · 图能对上 ---
    nar "图分在两个人手里。风从两条路中间穿过来，吹得纸角发颤。"
    $ vn2_current_voice = "voice/lan/lan_0148.ogg"
    voice "voice/lan/lan_0148.ogg"
    lan "图能对上，人未必能一起走到。"
    nar "他说这话时没看你，视线落在手里那半张上。语气和说路线一样平。那道双结在雾里泡了一路，松出一圈。他看见了，手指抬了一下，又垂回去，没抬手去紧。"
    think "结松了一圈，没人补。"
    nar "你腕口那截旧绳头也潮着，绳芯早成了粉，只是外头看着还是一根绳。他把半张图折好，按在口袋上，队徽隔着布贴着纸边。"
    $ vn2_current_voice = "voice/lan/lan_0149.ogg"
    voice "voice/lan/lan_0149.ogg"
    lan "上一次走这段，是我一个人。"
    nar "他声音很轻。你握紧掌心那截绳头，接上后半句。"
    zhou "这一次不是。"
    nar "他没应声。尾巴在身后动了一下，又压住。雾把两个人之间的距离填得很满。半张图在你袋底贴着绳头，潮的，软的，边角硌着后腰。"

    # --- 节点 9/9 · 站门在雾里出现 ---
    nar "出了林子，雾从洼地升起，层层。"
    scene bg gate with slow_fade
    nar "雾里立着一扇石门。门缝里透出一点干气，和林子里的潮气不一样。门半掩着，苔痕爬过半截门框。门上没有字，只有一道旧划的记号：圈加一横。石阶长了薄苔，缝里塞着落叶。门前的地被踩平过，不知道是哪一年的人踩的。门两侧的石壁上有旧刻痕，深浅不一，被苔盖住大半。门楣上的苔被风掀开一点，露出底下发黑的石面。门前的苔厚，踩上去软，底下是平的石面。石阶缝里的落叶泡得发黑。"
    nar "雾从门两侧流过去，从石缝里自己长出来的。门缝里的干气一丝一丝漫到台阶上。"
    $ vn2_current_voice = "voice/lan/lan_0150.ogg"
    voice "voice/lan/lan_0150.ogg"
    lan "到了。"
    nar "他把最后一段绳收进包里。队徽贴着地图，断口在谁身上，进门时再对。"
    think "门就在前面。进去之前，账还没算；进去之后，各算各的。"
    nar "你站在他旁边，一起看着那扇门。雾一重，门又看不见了；雾一散，门框还在原地。他站在门槛外一步的地方，没有先迈。你也停在他旁边。你鞋面上的水顺着裤脚往下滴，在苔上留下两个湿印。门缝里没有光，也没有声音。要推开，得先迈过门前那道湿苔。苔下的石面被踩得发亮，不知道过了多少人。门轴的锈死在石缝里，推起来不会轻。雾里等了一会儿，门没有自己开。"
    nar "剩下的一步，要两个人一起迈。"

    # --- 9/9 补 · 门前的留话（lan 线晚期补救） ---
    menu:
        "进门前，留一句给十七？"

        "把旧站的编号抄在门框内侧":
            $ vn2_flag("trust_shiqi")
            nar "你摸出铅笔，把旧站那串编号抄在门框内侧，字很小，藏在苔痕下面。抄完你把铅笔收回去，指腹在字上按了一下，确认不会一擦就掉。"
            nar "蓝羽站在旁边看着，没有问。他把绳头往你手里塞了塞，等你抄完才迈步。"

        "不留。门里的事，门里再说":
            nar "你把手从门框上收回来。苔是湿的，指腹沾了一层凉。蓝羽没有催，只把门推开半扇，先让出一步。"

    $ vn2_hide_all(trans=dissolve_soft)
    $ vn2_leave_chapter()
